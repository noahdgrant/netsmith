# The page's sources and its committed bundle are hashed byte for byte (crates/netsmith-editor/
# build_web.rs): git must not change their line endings on any system.
crates/netsmith-editor/web/** -text
crates/netsmith-editor/web-dist/** -text
# Raspberry Pi's licence and board file are kept byte for byte as they ship them (CRLF line
# endings): git must not change them on any system.
examples/rp2350_minimal/LICENSE -text
examples/rp2350_minimal/reference/*.kicad_pcb -text
# Easyduino: the licence and the board file are kept byte for byte, too.
examples/easyduino_esp32s3/LICENSE -text
examples/easyduino_esp32s3/reference/Easyduino_* -text
examples/easyduino_esp32s3/reference/References.kicad_sch -text

# ORBIT's licence, board file and schematic are kept byte for byte as its author ships them.
examples/orbit/LICENSE -text
examples/orbit/reference/*.kicad_pcb -text
examples/orbit/reference/*.kicad_sch -text
