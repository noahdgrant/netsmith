(kicad_pcb
	(version 20241229)
	(generator "netsmith-test")
	(general (thickness 1.6) (legacy_teardrops no))
	(paper "A4")
	(layers
		(0 "F.Cu" signal)
		(4 "In1.Cu" signal)
		(6 "In2.Cu" signal)
		(2 "B.Cu" signal)
		(13 "F.Paste" user)
		(15 "B.Paste" user)
		(5 "F.SilkS" user "F.Silkscreen")
		(7 "B.SilkS" user "B.Silkscreen")
		(1 "F.Mask" user)
		(3 "B.Mask" user)
		(25 "Edge.Cuts" user)
	)
	(setup
		(pad_to_mask_clearance 0)
		(aux_axis_origin 0 0)
		(tenting front back)
	)
	(net 0 "")
	(net 1 "GND")
	(net 2 "SIG")
	(footprint "Test:Header" (layer "F.Cu") (at 10 10 0)
		(property "Reference" "J1" (at 0 -4 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
		(property "Value" "hdr" (at 0 3 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
		(attr through_hole)
		(solder_mask_margin 0.1)
		(pad "1" thru_hole circle (at 0 0) (size 1.8 1.8) (drill 1) (layers "*.Cu" "*.Mask") (net 1 "GND"))
		(pad "2" thru_hole circle (at 0 2.54) (size 1.8 1.8) (drill 1) (layers "*.Cu" "*.Mask") (net 2 "SIG"))
		(pad "3" thru_hole rect (at 0 5.08) (size 1.8 1.8) (drill 1) (layers "*.Cu" "*.Mask") (net 1 "GND") (solder_mask_margin 0.15))
	)
	(footprint "Test:Round" (layer "F.Cu") (at 8 3 30)
		(property "Reference" "J2" (at 0 -4 0) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.12))))
		(property "Value" "round" (at 0 3 0) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.12))))
		(attr through_hole)
		(pad "1" thru_hole circle (at 0 0 30) (size 1.8 1.8) (drill 1) (layers "*.Cu" "*.Mask") (net 1 "GND"))
		(pad "2" thru_hole circle (at 0 5 30) (size 1.8 1.8) (drill 1) (layers "*.Cu" "*.Mask") (net 1 "GND") (thermal_bridge_angle 90))
		(pad "3" thru_hole rect (at 0 10 30) (size 1.8 1.8) (drill 1) (layers "*.Cu" "*.Mask") (net 1 "GND") (thermal_bridge_angle 45))
	)
	(footprint "Test:Back" (layer "B.Cu") (at 15 10 0)
		(property "Reference" "R1" (at 0 -2 0) (layer "B.SilkS") (effects (font (size 0.8 0.8) (thickness 0.12)) (justify mirror)))
		(property "Value" "1k" (at 0 2 0) (layer "B.Fab") (effects (font (size 0.8 0.8) (thickness 0.12)) (justify mirror)))
		(attr smd)
		(pad "1" smd roundrect (at 0 0) (size 1 1.2) (layers "B.Cu" "B.Mask" "B.Paste") (roundrect_rratio 0.25) (net 2 "SIG") (solder_mask_margin 0.1))
		(pad "2" smd roundrect (at 0 3) (size 1 1.2) (layers "B.Cu" "B.Mask" "B.Paste") (roundrect_rratio 0.25) (net 2 "SIG"))
	)
	(zone (net 1) (net_name "GND") (layer "In1.Cu") (hatch edge 0.5)
		(connect_pads (clearance 0.3)) (min_thickness 0.25) (filled_areas_thickness no)
		(fill yes (thermal_gap 0.5) (thermal_bridge_width 0.5))
		(polygon (pts (xy 0.2 0.2) (xy 19.8 0.2) (xy 19.8 19.8) (xy 0.2 19.8))))
	(gr_rect (start 0 0) (end 20 20) (stroke (width 0.05) (type default)) (fill no) (layer "Edge.Cuts"))
)
