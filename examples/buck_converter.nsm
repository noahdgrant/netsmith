//! A 3.3 V rail from a 12 V input, made by a buck converter that the solver picks from the
//! standard library by what the board asks of it: `BuckConverter`, with no IC named. The pick
//! is the first standard buck IC whose input range, output current and reference can hold the
//! output, with the inductor, the capacitors, the divider and the IC's own application circuit
//! around it (`std::parts::regulator`, issue #620). `netsmith build` says which it took and why
//! it passed over the others.

import std::parts::connector::Header1x2
import std::parts::regulator::BuckConverter
import std::sources::Rail
import std::mfg::jlcpcb::TwoLayer

board BuckConverterExample {
    /// Made by JLCPCB's two-layer process, on a board 1.6 mm thick.
    .process: TwoLayer {
        .stackup.thickness &= 1.6mm
    }

    /// The 12 V input, supplied from outside the board.
    .v12: Rail {
        .voltage &= 12V +/- 5%
        .pos.net &= "12V"
    }
    /// The 3.3 V output and the load it carries.
    .v3v3: Rail {
        .pos.net &= "3V3"
        .current &= 0mA..500mA
    }

    .reg: BuckConverter { .vout.voltage &= 3.3V +/- 5% }
    .v12 ~ .reg.vin
    .reg.vout ~ .v3v3

    .power_in: Header1x2
    .power_out: Header1x2
    .v12.pos ~ .power_in.p1
    .v12.neg ~ .power_in.p2
    .v3v3.pos ~ .power_out.p1
    .v3v3.neg ~ .power_out.p2
}
