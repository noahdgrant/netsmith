//! The Easyduino ESP32-S3 board: the circuit of the open design (CERN-OHL-P-2.0; see `README.md`
//! and `LICENSE`), written in netsmith. The circuit only: the outline and the places of the
//! receptacles, buttons and headers are for the physical file, a later item.
//!
//! An ESP32-S3-WROOM-1 module on a board that follows Espressif's ESP32-S3-DevKitC-1: a CP2102N
//! USB-UART bridge on the first USB-C receptacle (J1), the module's own USB on the second (J2),
//! the AMS1117-3.3 that makes the 3.3 V from VBUS (each receptacle reaches VBUS through a
//! Schottky diode), the automatic bootloader (DTR and RTS to EN and GPIO0 through two
//! transistors), a RESET and a BOOT button, a power LED and a GPIO38 LED, and the development
//! board's two 22-pin headers.
//!
//! Its nets are Easyduino's, and the proof is the test `board` of `crates/netsmith/tests/easyduino.rs`
//! (`README.md`, "Same nets"). The pin-to-signal map of the headers (U2), of the receptacles and
//! of the buttons is Easyduino's too, and it is FIXED: the board joins each header pin to a
//! named pin of the module (`.module.io4`) and never to a request for "any GPIO" (ADR 0101), so
//! the pin optimizer of `fab` has nothing to move and the firmware's pin map cannot change.

import src::auto_reset::AutoReset
import src::cp2102n::Cp2102n
import src::devkitc_headers::Esp32S3DevKitCHeaders
import src::esp32_s3_wroom_1::Esp32S3Wroom1
import src::shouhan_type_c_16pin::ShouhanTypeC16Pin   // brings the Shouhan receptacle in scope as a provider of `UsbCSinkReceptacle`
import src::xunpu_ts_1088::XunpuTs1088
import std::bus::{PullDown, PullUp}
import std::mfg::jlcpcb::FourLayer
import std::parts::connector::UsbCSink
import std::parts::diode::Schottky
import std::parts::passive::{Capacitor, Led, Resistor}
import std::parts::regulator::LinearRegulator
import std::sources::Rail

board EasyduinoEsp32s3 {
    .process: FourLayer {
        .stackup.thickness &= 1.6mm
        // The pours of Easyduino's board: ground on both outer layers and on the first inner
        // one, 3.3 V on the second (a 3.3 V pour on the top layer as well is not stated: a
        // layer has one pour net).
        .top.net &= "GND"
        .bottom.net &= "GND"
        .inner1.net &= "GND"
        .inner2.net &= "+3.3V"
    }

    // ---- The chips: U1, U3, U5 ----

    /// The module (U1): 4 MB of flash, PCB antenna.
    .module: Esp32S3Wroom1
    /// The USB-UART bridge (U3), on the first receptacle.
    .bridge: Cp2102n { .mpn &= "CP2102N-A02-GQFN28" }
    /// The 3.3 V regulator (U5), an AMS1117-3.3 in a SOT-223 (a row of the project's catalog).
    .regulator: LinearRegulator {
        .package &= "SOT-223"
        // AMS1117 datasheet, page 3: 5 mA typical and 11 mA maximum.
        .quiescent_current &= 0mA..11mA
        // What it supplies: the reference's notes say "Output Current at 3.3V: 1 A (External
        // Source) 500mA (USB)". Nothing on the 3.3 V net is modelled (the module's supply pin
        // states no draw), so the output's current is the board's statement: from USB, 500 mA.
        .vout.current &= -500mA..0A
    }

    // ---- The interface parts: J1, J2, SW1, SW2, U2 ----

    /// J1: the receptacle of the bridge.
    .usb_uart: UsbCSink {
        .receptacle.package &= "SMD"
        .receptacle.mpn &= "TYPE-C 16PIN 2MD(073)"
        .cc1_rd.package &= "0402"
        .cc2_rd.package &= "0402"
    }
    /// J2: the receptacle of the module's own USB.
    .usb_native: UsbCSink {
        .receptacle.package &= "SMD"
        .receptacle.mpn &= "TYPE-C 16PIN 2MD(073)"
        .cc1_rd.package &= "0402"
        .cc2_rd.package &= "0402"
    }
    /// The development board's two 22-pin headers (U2), hand-soldered.
    .headers: Esp32S3DevKitCHeaders
    /// SW1, RESET: pulls EN to ground.
    .reset: XunpuTs1088
    /// SW2, BOOT: pulls GPIO0 to ground.
    .boot: XunpuTs1088

    // ---- The rails ----

    // The supply of each receptacle is a host's: USB's VBUS, 4.75 V to 5.25 V. The reference's
    // notes name "5V (USB UART OR USB ESP32)" and say to use one voltage input at a time.
    .usb_uart.vbus.voltage &= 5V +/- 5%
    .usb_uart.vbus.pos.net &= "VBUS1"
    .usb_uart.vbus.neg.net &= "GND"
    .usb_native.vbus.voltage &= 5V +/- 5%
    .usb_native.vbus.pos.net &= "VBUS2"
    .usb_native.vbus.neg.net &= "GND"
    /// VBUS behind the two diodes: the bridge's supply, the regulator's input and the header's
    /// 5 V pin.
    .vbus: Rail {
        .pos.net &= "VBUS"
        .neg.net &= "GND"
    }
    /// The 3.3 V of the regulator: the module's supply and the header's 3.3 V pins.
    .v3v3: Rail {
        .pos.net &= "+3.3V"
        .neg.net &= "GND"
    }

    .usb_uart.vbus.neg ~ .vbus.neg
    .usb_native.vbus.neg ~ .vbus.neg

    /// D2 and D3: each receptacle's VBUS reaches VBUS through a Schottky diode (anode on the
    /// receptacle), so the two supplies cannot feed each other. ROHM RB161QS-40.
    .usb_uart_diode: Schottky { .package &= "SMD1006" }
    .usb_native_diode: Schottky { .package &= "SMD1006" }
    .usb_uart.vbus.pos ~> .usb_uart_diode ~> .vbus.pos
    .usb_native.vbus.pos ~> .usb_native_diode ~> .vbus.pos

    .vbus ~ .regulator.vin
    .regulator.vout ~ .v3v3
    .v3v3.neg ~ .vbus.neg

    // ---- The module (U1) ----

    .module.vdd ~ .v3v3
    // The module's own USB, on the second receptacle with no part between (the reference has
    // none): IO19 is D- and IO20 is D+.
    .usb_native.dm ~ .module.io19
    .usb_native.dp ~ .module.io20

    // ---- The bridge (U3), on the first receptacle ----

    .usb_uart.dp ~ .bridge.dp
    .usb_uart.dm ~ .bridge.dm
    .bridge.vbus ~ .vbus.pos
    .bridge.vregin ~ .vbus.pos
    .bridge.gnd ~ .vbus.neg
    // The bridge's TXD is the module's RXD0 (GPIO44) and its RXD the module's TXD0 (GPIO43).
    .bridge.txd ~ .module.rxd0
    .bridge.rxd ~ .module.txd0
    /// C3: the decoupling of the bridge's own 3.3 V (VDD), which the board does not use as a
    /// supply (the author's notes: it gives 100 mA only).
    .bridge_vdd_cap: Capacitor { .capacitance &= 100nF +/- 10%; .package &= "0402" }
    .bridge.vdd ~ .bridge_vdd_cap.a
    .bridge_vdd_cap.b ~ .vbus.neg
    /// R11: pulls the bridge's reset line up to VBUS.
    .bridge_reset_pullup: PullUp { .resistance &= 5.1kohm +/- 1%; .resistor.package &= "0402" }
    .bridge_reset_pullup.supply ~ .vbus
    .bridge_reset_pullup.line ~ .bridge.rstb
    /// R10: holds the bridge's SUSPENDb output low.
    .suspend_pulldown: PullDown { .resistance &= 10kohm +/- 1%; .resistor.package &= "0402" }
    .suspend_pulldown.reference ~ .vbus
    .suspend_pulldown.line ~ .bridge.suspendb

    // ---- The automatic bootloader (Q1, Q2, R4, R5) ----

    .auto_reset: AutoReset
    .auto_reset.dtr ~ .bridge.dtr
    .auto_reset.rts ~ .bridge.rts
    .auto_reset.en ~ .module.en
    .auto_reset.boot ~ .module.io0

    // ---- The buttons (SW1, SW2) and EN's pull-up ----

    .reset.a ~ .vbus.neg
    .reset.b ~ .module.en
    .boot.a ~ .vbus.neg
    .boot.b ~ .module.io0
    /// R1: EN's 10 kohm pull-up (Espressif's circuit; the module needs EN driven).
    .en_pullup: PullUp { .resistance &= 10kohm +/- 1%; .resistor.package &= "0402" }
    .en_pullup.supply ~ .v3v3
    .en_pullup.line ~ .module.en

    // ---- The LEDs: D1 (power) and D4 (GPIO38) ----

    /// D1: lit from VBUS through R6.
    .power_led: Led {
        .color &= "BLUE"
        .package &= "0402"
        .forward_voltage &= 2.6V..3.2V
    }
    .power_led_resistor: Resistor { .resistance &= 5.1kohm +/- 1%; .package &= "0402" }
    .vbus.pos ~> .power_led_resistor ~> .power_led ~> .vbus.neg
    /// D4: GPIO38 through R9.
    .user_led: Led {
        .color &= "BLUE"
        .package &= "0402"
        .forward_voltage &= 2.6V..3.2V
    }
    .user_led_resistor: Resistor { .resistance &= 2.4kohm +/- 1%; .package &= "0402" }
    .module.io38 ~ .user_led_resistor.b
    .user_led_resistor.a ~ .user_led.anode
    .user_led.cathode ~ .vbus.neg

    // ---- Decoupling: C1 to C10 ----

    /// C1 and C2: the bridge's VBUS input, 1 uF and 100 nF (CP2102N datasheet, as the author's
    /// notes say).
    .vbus_1u: Capacitor { .capacitance &= 1uF +/- 10%; .package &= "0402" }
    .vbus_100n: Capacitor { .capacitance &= 100nF +/- 10%; .package &= "0402" }
    /// C6: the regulator's input, 22 uF tantalum.
    .vbus_22u: Capacitor { .capacitance &= 22uF +/- 10%; .package &= "CASE-A-3216-18" }
    /// C5, C7 and C10: the module's 100 nF and 22 uF on 3.3 V, and the regulator's output
    /// capacitor (22 uF).
    .v3v3_100n: Capacitor { .capacitance &= 100nF +/- 10%; .package &= "0402" }
    .v3v3_22u: 2 x Capacitor { .capacitance &= 22uF +/- 10%; .package &= "CASE-A-3216-18" }
    /// C4 and C8 on EN (the module's 100 nF for power-up timing, and the second), C9 on GPIO0.
    .en_100n: 2 x Capacitor { .capacitance &= 100nF +/- 10%; .package &= "0402" }
    .boot_100n: Capacitor { .capacitance &= 100nF +/- 10%; .package &= "0402" }
    .vbus.pos ~> .vbus_1u ~> .vbus.neg
    .vbus.pos ~> .vbus_100n ~> .vbus.neg
    .vbus.pos ~> .vbus_22u ~> .vbus.neg
    .v3v3.pos ~> .v3v3_100n ~> .v3v3.neg
    .v3v3.pos ~> .v3v3_22u ~> .v3v3.neg
    .module.en ~> .en_100n ~> .vbus.neg
    .module.io0 ~> .boot_100n ~> .vbus.neg

    // ---- The headers (U2): Easyduino's pin map (fixed) ----

    .headers.v3v3 ~ .v3v3.pos
    .headers.vbus ~ .vbus.pos
    .headers.gnd ~ .vbus.neg
    // Each header pin is named as the development board's silkscreen (GPIO4) and joined to the
    // module's pin of that GPIO (IO4); `.en` has one name on both.
    .headers ~ .module {
        gpio4 = io4; gpio5 = io5; gpio6 = io6; gpio7 = io7; gpio15 = io15; gpio16 = io16
        gpio17 = io17; gpio18 = io18; gpio8 = io8; gpio3 = io3; gpio46 = io46; gpio9 = io9
        gpio10 = io10; gpio11 = io11; gpio12 = io12; gpio13 = io13; gpio14 = io14; gpio19 = io19
        gpio20 = io20; gpio21 = io21; gpio47 = io47; gpio48 = io48; gpio45 = io45; gpio0 = io0
        gpio35 = io35; gpio36 = io36; gpio37 = io37; gpio38 = io38; gpio39 = io39; gpio40 = io40
        gpio41 = io41; gpio42 = io42; gpio2 = io2; gpio1 = io1; gpio44 = rxd0; gpio43 = txd0
    } except { v3v3 vbus gnd vdd }
}
