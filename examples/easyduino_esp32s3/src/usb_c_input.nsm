//! One USB Type-C input of the Easyduino ESP32-S3 board: the receptacle and the two 5.1 kohm
//! resistors that tell a host the board is a device that takes power (the Type-C specification's
//! Rd on each of CC1 and CC2). The board has two of them: J1 for the bridge and J2 for the
//! module's own USB.
//!
//! The receptacle's ground contacts and its shell are one net with the resistors' other ends.
//! `.vbus` is the receptacle's rail (VBUS and GND), brought out before any diode (the board puts
//! one behind each input and states the host's voltage), and the data pair is brought out as it
//! is. The sideband contacts SBU1 and SBU2 are not used.

import src::shouhan_type_c_16pin::ShouhanTypeC16Pin
import std::parts::passive::Resistor
import std::sources::Rail

/// A USB Type-C receptacle for a device: `.vbus`, `.dp` and `.dm` go to the board, and
/// the CC contacts have their 5.1 kohm to ground.
module UsbCInput {
    .vbus: Rail
    .dp: Pin
    .dm: Pin

    .connector: ShouhanTypeC16Pin { .mpn &= "TYPE-C 16PIN 2MD(073)" }
    /// CC1's pull-down. 5.1 kohm is the reference board's value.
    .cc1_pulldown: Resistor { .resistance &= 5.1kohm +/- 1%; .package &= "0402" }
    /// CC2's pull-down.
    .cc2_pulldown: Resistor { .resistance &= 5.1kohm +/- 1%; .package &= "0402" }

    .connector.vbus ~ .vbus
    .connector.dp ~ .dp
    .connector.dm ~ .dm
    .connector.shield ~ .vbus.neg
    .connector.cc1 ~> .cc1_pulldown ~> .vbus.neg
    .connector.cc2 ~> .cc2_pulldown ~> .vbus.neg
}
