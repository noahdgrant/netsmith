//! The enclosure the sensor board goes in (ADR 0132): what the case fixes of every board in it.
//!
//! Every number here is invented. In a real project each one would carry the drawing it comes
//! from in a comment above the line; here the comment says what the line asks for.

import std::parts::mechanical::MountingHole
import std::pcb::{Cutout, Outline}

enclosure SensorCase {
    // The outline: 90 x 62 mm with 3 mm rounded corners, and one cutout, a slot for a strap,
    // 8 x 4 mm, with its corner 30 mm in and 44 mm down.
    .outline: Outline {
        .width &= 90mm
        .height &= 62mm
        .corner_radius &= 3mm
    }
    .strap: Cutout {
        .x &= 30mm
        .y &= 44mm
        .width &= 8mm
        .height &= 4mm
        .corner_radius &= 1mm
    }

    // Four mounting holes, 4.5 mm in from each corner. A hole whose place is stated is put
    // there and not in a corner.
    .hole1: MountingHole
    .hole2: MountingHole
    .hole3: MountingHole
    .hole4: MountingHole
    .hole1.place.x &= 4.5mm
    .hole1.place.y &= 4.5mm
    .hole2.place.x &= 85.5mm
    .hole2.place.y &= 4.5mm
    .hole3.place.x &= 4.5mm
    .hole3.place.y &= 57.5mm
    .hole4.place.x &= 85.5mm
    .hole4.place.y &= 57.5mm
}
