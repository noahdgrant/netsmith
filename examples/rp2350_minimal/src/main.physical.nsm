//! The physical file of the RP2350A Minimal board: what must be where for it to be interchangeable
//! with Raspberry Pi's board `RPI-RP2350A-MINIMAL_R4-S1` (MIT, Copyright (c) 2026 Raspberry Pi
//! Ltd; see `README.md` and `LICENSE`): the outline, the four mounting holes, the connectors
//! J1 to J4 and the buttons SW1 and SW2.
//!
//! Every number is read from their board file (`reference/RPI-RP2350A-MINIMAL_R4-S1.kicad_pcb`,
//! tabulated in `reference/placements.toml`) and is written here from the board's own corner,
//! the upper-left corner of the outline (x 74, y 70 in their file), with y growing downward.
//! A requirement is measured from the BODY of a part (the outline its footprint draws on
//! `F.Fab`, else its courtyard) and not from the footprint's origin, which is what the parity
//! checker compares; where the two differ, the comment says so and gives the origin's place
//! in their file.
//!
//! The parts that need not match (the MCU, the flash, the crystal, the regulator, the
//! inductor, the resistors and the capacitors) have no line here: the placer puts them.

import std::parts::mechanical::MountingHole
import std::pcb::{CaseModel, Outline}

physical for Rp2350Minimal {
    case {
        // The outline: 52 x 51 mm (x 74 to 126, y 70 to 121 in their file) with 3 mm
        // corner arcs.
        .outline: Outline {
            .width &= 52mm
            .height &= 51mm
            .corner_radius &= 3mm
        }

        // Four non-plated 2.75 mm holes (a row of the project's `kicad.toml`).
        .hole1: MountingHole { .package &= "M2.5" }
        .hole2: MountingHole { .package &= "M2.5" }
        .hole3: MountingHole { .package &= "M2.5" }
        .hole4: MountingHole { .package &= "M2.5" }

        // The example's own case (MIT, `case/`, written by `case/make_case.py`), drawn from the
        // base's outer bottom-left corner with the floor's underside at z = 0. The base is a
        // tray with 2 mm walls 0.5 mm off the outline and four 4 mm bosses that the board's
        // bottom face rests on: the floor (2 mm) and the bosses put the board's top face 7.6 mm
        // up. The lid's underside is 6.5 mm above the board's top face.
        .base: CaseModel {
            .file &= "../case/base.step"
            .x &= -2.5mm
            .y &= -2.5mm
            .z &= -7.6mm
        }
        .lid: CaseModel {
            .file &= "../case/lid.step"
            .x &= -2.5mm
            .y &= -2.5mm
            .z &= 6.5mm
        }
    }

    // Their MH1 to MH4: (86.03, 74), (113.97, 74), (113.97, 117.18), (86.03, 117.18).
    .hole1.place.x &= 12.03mm
    .hole1.place.y &= 4mm
    .hole2.place.x &= 39.97mm
    .hole2.place.y &= 4mm
    .hole3.place.x &= 39.97mm
    .hole3.place.y &= 47.18mm
    .hole4.place.x &= 12.03mm
    .hole4.place.y &= 47.18mm

    // J1, the micro-USB receptacle: their J1 is at (100, 71.7) turned 180 degrees. The body
    // (`F.Fab`) is not centred on the origin: x -4.02 to 4.02 and y -3.25 to 2.82 of the
    // footprint, so its centre is (0, -0.215) of the footprint and, turned half a turn, 0.215 mm
    // below the origin: (26, 1.7 + 0.215). Its receptacle hangs 1.12 mm over the top edge (the
    // body reaches y -1.12), as in their board.
    .usb.place.x &= 26mm
    .usb.place.y &= 1.915mm
    .usb.place.top <= 0mm
    .usb.place.rotation &= 180
    .usb.place.side &= "top"

    // J2 and J3, the 2 x 18 headers: their J2 is at (77.14, 95.59) and J3 at (122.86, 95.59),
    // both turned -90 degrees (270). The body (`F.Fab`) is centred on the origin.
    .header_low.place.x &= 3.14mm
    .header_low.place.y &= 25.59mm
    .header_low.place.rotation &= 270
    .header_low.place.side &= "top"
    .header_high.place.x &= 48.86mm
    .header_high.place.y &= 25.59mm
    .header_high.place.rotation &= 270
    .header_high.place.side &= "top"
    // Their tails, bought this length and not cut: Samtec's catalog page F-226 (`tsw_th.pdf`,
    // lead style -07) gives B, the tail under the 2.54 mm (.100 in) body, as 2.54 mm (.100 in),
    // so through the 1.6 mm board they stand 0.94 mm out of the bottom face. The page prints
    // no tolerance. The 3D view draws each pin through the board and out to it.
    .header_low.pin_protrusion &= 0.94mm
    .header_high.pin_protrusion &= 0.94mm

    // J4, the JST-SH debug port: their J4 is at (107.6, 115.375), not turned. The body
    // (`F.Fab`) is x -2.5 to 2.5 and y -4.95 to 0 of the footprint: its centre is 2.475 mm above
    // the origin.
    .debug.place.x &= 33.6mm
    .debug.place.y &= 42.9mm
    .debug.place.rotation &= 0
    .debug.place.side &= "top"

    // SW1 (BOOTSEL) at (91.2, 75.2) turned -90 degrees, SW2 (RESET) at (111.8, 107.475)
    // turned 180. The body (`F.Fab`) is centred on the origin.
    .bootsel.place.x &= 17.2mm
    .bootsel.place.y &= 5.2mm
    .bootsel.place.rotation &= 270
    .bootsel.place.side &= "top"
    .reset.place.x &= 37.8mm
    .reset.place.y &= 37.475mm
    .reset.place.rotation &= 180
    .reset.place.side &= "top"
}
