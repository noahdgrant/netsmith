//! An invented board that shows what the editor's schematic does with the shapes a real board
//! has, on four sheets: a battery divider with a buffer (`adc`), a microcontroller with two
//! units in KiCad's symbol and ninety-seven pins, a crystal and decoupling (`mcu`), a buck
//! converter with a feedback divider, a bootstrap capacitor, an inductor and capacitors
//! (`buck`), and a module with two connectors and more than twenty parts (`modem`). Nothing in
//! it is a design to build: the parts and the numbers are made up, and the microcontroller and
//! the regulator IC are drawn by the project's own symbol library (`bench.kicad_sym`).

import std::parts::connector::Header1x4
import std::parts::passive::{Capacitor, Crystal, Inductor, Led, Resistor}
import std::sources::Rail
import std::mfg::jlcpcb::TwoLayer

/// A dual operational amplifier, in the symbol of KiCad's LM358: three units there, one box here.
part DualOpAmp {
    .designator &= "U"

    .supply: Rail

    pins "SOIC-8" {
        .out_a    output "OUT_A" "1"
        .in_a_neg input  "IN_A-" "2"
        .in_a_pos input  "IN_A+" "3"
        .supply.neg power "V-" "4"
        .in_b_pos input  "IN_B+" "5" optional
        .in_b_neg input  "IN_B-" "6" optional
        .out_b    output "OUT_B" "7"
        .supply.pos power "V+" "8"
    }

    .package: Package
}

/// An invented microcontroller of ninety-seven pins: sixty-four of them are ports, twenty-four
/// are ground, six are supply and three connect to nothing. Its symbol has two units.
part Mcu97 {
    .designator &= "U"

    .vdd: Rail

    pins "QFP" {
        .p0_00 bidirectional "P0.00" "1"
        .p0_01 bidirectional "P0.01" "2"
        .p0_02 bidirectional "P0.02" "3"
        .p0_03 bidirectional "P0.03" "4"
        .p0_04 bidirectional "P0.04" "5"
        .p0_05 bidirectional "P0.05" "6"
        .p0_06 bidirectional "P0.06" "7"
        .p0_07 bidirectional "P0.07" "8"
        .p0_08 bidirectional "P0.08" "9"
        .p0_09 bidirectional "P0.09" "10"
        .p0_10 bidirectional "P0.10" "11"
        .p0_11 bidirectional "P0.11" "12"
        .p0_12 bidirectional "P0.12" "13"
        .p0_13 bidirectional "P0.13" "14"
        .p0_14 bidirectional "P0.14" "15"
        .p0_15 bidirectional "P0.15" "16"
        .p1_00 bidirectional "P1.00" "17"
        .p1_01 bidirectional "P1.01" "18"
        .p1_02 bidirectional "P1.02" "19"
        .p1_03 bidirectional "P1.03" "20"
        .p1_04 bidirectional "P1.04" "21"
        .p1_05 bidirectional "P1.05" "22"
        .p1_06 bidirectional "P1.06" "23"
        .p1_07 bidirectional "P1.07" "24"
        .p1_08 bidirectional "P1.08" "25"
        .p1_09 bidirectional "P1.09" "26"
        .p1_10 bidirectional "P1.10" "27"
        .p1_11 bidirectional "P1.11" "28"
        .p1_12 bidirectional "P1.12" "29"
        .p1_13 bidirectional "P1.13" "30"
        .p1_14 bidirectional "P1.14" "31"
        .p1_15 bidirectional "P1.15" "32"
        .p2_00 bidirectional "P2.00" "33"
        .p2_01 bidirectional "P2.01" "34"
        .p2_02 bidirectional "P2.02" "35"
        .p2_03 bidirectional "P2.03" "36"
        .p2_04 bidirectional "P2.04" "37"
        .p2_05 bidirectional "P2.05" "38"
        .p2_06 bidirectional "P2.06" "39"
        .p2_07 bidirectional "P2.07" "40"
        .p2_08 bidirectional "P2.08" "41"
        .p2_09 bidirectional "P2.09" "42"
        .p2_10 bidirectional "P2.10" "43"
        .p2_11 bidirectional "P2.11" "44"
        .p2_12 bidirectional "P2.12" "45"
        .p2_13 bidirectional "P2.13" "46"
        .p2_14 bidirectional "P2.14" "47"
        .p2_15 bidirectional "P2.15" "48"
        .p3_00 bidirectional "P3.00" "49"
        .p3_01 bidirectional "P3.01" "50"
        .p3_02 bidirectional "P3.02" "51"
        .p3_03 bidirectional "P3.03" "52"
        .p3_04 bidirectional "P3.04" "53"
        .p3_05 bidirectional "P3.05" "54"
        .p3_06 bidirectional "P3.06" "55"
        .p3_07 bidirectional "P3.07" "56"
        .p3_08 bidirectional "P3.08" "57"
        .p3_09 bidirectional "P3.09" "58"
        .p3_10 bidirectional "P3.10" "59"
        .p3_11 bidirectional "P3.11" "60"
        .p3_12 bidirectional "P3.12" "61"
        .p3_13 bidirectional "P3.13" "62"
        .p3_14 bidirectional "P3.14" "63"
        .p3_15 bidirectional "P3.15" "64"
        .vdd.pos power "VDD" "131" "132" "133" "134" "135" "136"
        .vdd.neg power "GND" "101" "102" "103" "104" "105" "106" "107" "108" "109" "110" "111" "112" "113" "114" "115" "116" "117" "118" "119" "120" "121" "122" "123" "124"
        .nc1 no_connect "NC" "141"
        .nc2 no_connect "NC" "142"
        .nc3 no_connect "NC" "143"
    }

    .package: Package
}

/// An invented buck regulator IC: two supply pins and an enable on the left, the bootstrap, the
/// switching node, the internal supply, the feedback and the power-good flag on the right, and
/// three grounds.
part Buck1V8 {
    .designator &= "U"

    .vin: Rail

    pins "QFN" {
        .vin.pos power "VIN" "1" "2"
        .en      input "EN" "3"
        .rt      input "RT" "4"
        .pgood   output "PGOOD" "5"
        .fb      input "FB" "6"
        .vcc     output "VCC" "7"
        .vin.neg power "GND" "9" "11" "8"
        .sw      passive "SW" "10"
        .bst     passive "BST" "13"
    }

    .package: Package
}

/// A battery divider into a buffer: the divider's node feeds the amplifier's input, the
/// amplifier's output is wired back to its inverting input, and a resistor and a capacitor
/// filter the output before it leaves for the converter.
module AdcMonitor {
    .battery: Rail
    .supply: Rail
    .out: Pin

    .r_top: Resistor { .resistance &= 1.2Mohm +/- 1% }
    .r_bottom: Resistor { .resistance &= 330kohm +/- 1% }
    .r_filter: Resistor { .resistance &= 10kohm +/- 1% }
    .c_filter: Capacitor { .capacitance &= 100nF +/- 20% }
    .amp: DualOpAmp { .package &= "SOIC-8" }

    .amp.supply ~ .supply
    .battery.pos ~> .r_top ~> .r_bottom ~> .battery.neg
    .r_top.b ~ .amp.in_a_pos
    .amp.out_a ~ .amp.in_a_neg
    .amp.out_a ~> .r_filter ~> .c_filter ~> .supply.neg
    .r_filter.b ~ .out
}

/// The microcontroller, an 8 MHz crystal on its oscillator pins, and two supply capacitors.
module McuModule {
    .supply: Rail
    .adc: Pin
    .led_a: Pin
    .led_b: Pin
    .tx: Pin
    .rx: Pin
    .rts: Pin
    .cts: Pin

    .mcu: Mcu97 { .package &= "QFP" }
    .crystal: Crystal { .frequency &= 8MHz +/- 30ppm }
    .bulk: Capacitor { .capacitance &= 10uF +/- 20% }
    .bypass: Capacitor { .capacitance &= 100nF +/- 20% }

    .mcu.vdd ~ .supply
    .supply.pos ~> .bulk ~> .supply.neg
    .supply.pos ~> .bypass ~> .supply.neg
    .crystal.a ~ .mcu.p0_14
    .crystal.b ~ .mcu.p0_15
    .adc ~ .mcu.p0_01
    .led_a ~ .mcu.p0_02
    .led_b ~ .mcu.p0_03
    .tx ~ .mcu.p0_04
    .rx ~ .mcu.p0_05
    .rts ~ .mcu.p0_06
    .cts ~ .mcu.p0_07
}

/// A buck converter: the input and output capacitors, the inductor from the switching node to
/// the output, the bootstrap capacitor between the BST and SW pins, the divider that sets the
/// output from the feedback pin, a resistor on RT and a pull-up on the power-good flag.
module BuckStage1V8 {
    .vin: Rail
    .vout: Rail
    .supply: Rail
    .pgood: Pin

    .ic: Buck1V8 { .package &= "QFN" }
    .l: Inductor { .inductance &= 4.7uH +/- 20% }
    .c_in: Capacitor { .capacitance &= 10uF +/- 20% }
    .c_out: Capacitor { .capacitance &= 22uF +/- 20% }
    .c_boot: Capacitor { .capacitance &= 100nF +/- 20% }
    .c_vcc: Capacitor { .capacitance &= 1uF +/- 20% }
    .r_top: Resistor { .resistance &= 100kohm +/- 1% }
    .r_bottom: Resistor { .resistance &= 33kohm +/- 1% }
    .r_rt: Resistor { .resistance &= 10kohm +/- 1% }
    .r_pg: Resistor { .resistance &= 10kohm +/- 5% }

    .ic.vin ~ .vin
    .vin.neg ~ .vout.neg
    .ic.en ~ .vin.pos
    .vin.pos ~> .c_in ~> .vin.neg
    .ic.sw ~> .l ~> .vout.pos
    .ic.bst ~> .c_boot ~> .ic.sw
    .vout.pos ~> .c_out ~> .vout.neg
    .vout.pos ~> .r_top ~> .r_bottom ~> .vout.neg
    .r_top.b ~ .ic.fb
    .ic.rt ~> .r_rt ~> .vin.neg
    .ic.vcc ~> .c_vcc ~> .vin.neg
    .supply.pos ~> .r_pg ~> .ic.pgood
    .ic.pgood ~ .pgood
}

/// A radio modem's side of the board: a four-pin serial connector and a four-pin control
/// connector, pull-ups and pull-downs on the lines, a status light, an RC on each of five lines
/// and three capacitors on the supply. Twenty-two parts, one sheet (the old drawing cut a module of more than twenty in two).
module ModemModule {
    .supply: Rail
    .tx: Pin
    .rx: Pin
    .rts: Pin
    .cts: Pin

    .serial: Header1x4 { .package &= "2.54mm" }
    .control: Header1x4 { .package &= "2.54mm" }
    .r_tx: Resistor { .resistance &= 10kohm +/- 5% }
    .r_rx: Resistor { .resistance &= 10kohm +/- 5% }
    .r_rts: Resistor { .resistance &= 100ohm +/- 5% }
    .r_cts: Resistor { .resistance &= 10kohm +/- 5% }
    .r_stat: Resistor { .resistance &= 1kohm +/- 5% }
    .r_led: Resistor { .resistance &= 10kohm +/- 5% }
    .led: Led { .color &= "GREEN" }
    .c_a: Capacitor { .capacitance &= 10uF +/- 20% }
    .c_b: Capacitor { .capacitance &= 100nF +/- 20% }
    .c_c: Capacitor { .capacitance &= 100nF +/- 20% }
    .rc_a: Resistor { .resistance &= 4.7kohm +/- 5% }
    .rc_b: Resistor { .resistance &= 4.7kohm +/- 5% }
    .rc_c: Resistor { .resistance &= 47kohm +/- 5% }
    .rc_d: Resistor { .resistance &= 47kohm +/- 5% }
    .cf_a: Capacitor { .capacitance &= 10nF +/- 20% }
    .cf_b: Capacitor { .capacitance &= 10nF +/- 20% }
    .cf_c: Capacitor { .capacitance &= 10nF +/- 20% }
    .cf_d: Capacitor { .capacitance &= 10nF +/- 20% }
    .rc_e: Resistor { .resistance &= 22kohm +/- 5% }
    .cf_e: Capacitor { .capacitance &= 10nF +/- 20% }

    .serial.p1 ~ .tx
    .supply.pos ~> .r_tx ~> .tx
    .serial.p2 ~ .rx
    .rx ~> .r_rx ~> .supply.neg
    .serial.p3 ~> .r_rts ~> .rts
    .serial.p4 ~ .cts
    .supply.pos ~> .r_cts ~> .cts
    .control.p1 ~ .supply.pos
    .control.p2 ~ .supply.neg
    .supply.pos ~> .c_a ~> .supply.neg
    .supply.pos ~> .c_b ~> .supply.neg
    .supply.pos ~> .c_c ~> .supply.neg
    .control.p3 ~> .r_stat ~> .led ~> .supply.neg
    .control.p4 ~> .r_led ~> .supply.neg
    .supply.pos ~> .rc_a ~> .cf_a ~> .supply.neg
    .supply.pos ~> .rc_b ~> .cf_b ~> .supply.neg
    .supply.pos ~> .rc_c ~> .cf_c ~> .supply.neg
    .supply.pos ~> .rc_d ~> .cf_d ~> .supply.neg
    .supply.pos ~> .rc_e ~> .cf_e ~> .supply.neg
}

board SchematicBench {
    .process: TwoLayer {
        .stackup.thickness &= 1.6mm
    }

    .battery: Rail {
        .voltage &= 3.7V +/- 10%
        .pos.net &= "+VBATT_SAFE"
        .neg.net &= "GND"
    }
    .rail_5v: Rail {
        .voltage &= 5V +/- 5%
        .pos.net &= "+5V_in"
        .neg.net &= "GND"
    }
    .rail_3v3: Rail {
        .voltage &= 3.3V +/- 5%
        .pos.net &= "+3V3"
        .neg.net &= "GND"
        .current &= 0mA..100mA
        .min_track &= 0.25mm..1m
    }
    .rail_1v8: Rail {
        .voltage &= 1.8V +/- 5%
        .pos.net &= "+1V8"
        .neg.net &= "GND"
        .current &= 0mA..500mA
        .min_track &= 0.4mm..1m
    }

    .adc: AdcMonitor
    .adc.battery ~ .battery
    .adc.supply ~ .rail_3v3
    .adc.out.net &= "BATT_ADC"

    .mcu: McuModule
    .mcu.supply ~ .rail_3v3
    .mcu.adc ~ .adc.out
    .mcu.led_a.net &= "LED_A"
    .mcu.led_b.net &= "LED_B"
    .mcu.tx.net &= "MODEM_TX"
    .mcu.rx.net &= "MODEM_RX"
    .mcu.rts.net &= "MODEM_RTS"
    .mcu.cts.net &= "MODEM_CTS"

    .buck: BuckStage1V8
    .buck.vin ~ .rail_5v
    .buck.vout ~ .rail_1v8
    .buck.supply ~ .rail_3v3
    .buck.pgood.net &= "PGOOD"

    .modem: ModemModule
    .modem.supply ~ .rail_3v3
    .modem.tx ~ .mcu.tx
    .modem.rx ~ .mcu.rx
    .modem.rts ~ .mcu.rts
    .modem.cts ~ .mcu.cts
}
