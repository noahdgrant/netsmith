//! A regulator on a six-layer board: the outer inner layers are a ground plane and a 3.3 V
//! plane, the two in the middle are signal layers, and signals are routed on the outer layers
//! only (the router does not draw on inner layers yet, so the signal layers stay empty).

import std::parts::connector::Header1x2
import std::parts::passive::Capacitor
import std::parts::regulator::LinearRegulator
import std::sources::Rail
import std::mfg::jlcpcb::SixLayer

board SixLayerExample {
    /// Made by JLCPCB's six-layer process (1.6 mm, build-up JLC06161H-3313).
    .process: SixLayer {
        .inner1.net &= "GND"
        .inner2.use &= "signal"
        .inner3.use &= "signal"
        .inner4.net &= "3V3"
    }

    /// The input rail is supplied from outside the board.
    .input: Rail {
        .voltage &= 5V +/- 5%
        .pos.net &= "VIN"
        .neg.net &= "GND"
    }
    /// What the outside world draws from the output.
    .output: Rail {
        .voltage &= 3.3V +/- 5%
        .pos.net &= "3V3"
        .neg.net &= "GND"
        .current &= 0mA..50mA
    }

    .regulator: LinearRegulator
    .input_cap:  Capacitor { .effective_capacitance >= 1uF }
    .output_cap: Capacitor { .effective_capacitance >= 4.7uF }
    .input ~ .regulator.vin
    .regulator.vout ~ .output
    .input_cap.max_voltage  >= .input.voltage * 1.5
    .output_cap.max_voltage >= .output.voltage * 1.5
    .input.pos ~> .input_cap ~> .input.neg
    .output.pos ~> .output_cap ~> .output.neg

    .power_in: Header1x2
    .power_out: Header1x2
    .input.pos ~ .power_in.p1
    .input.neg ~ .power_in.p2
    .output.pos ~ .power_out.p1
    .output.neg ~ .power_out.p2
}
