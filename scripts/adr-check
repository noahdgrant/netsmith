#!/usr/bin/env bash
# Checks the ADRs against docs/adr/README.md: an ADR is at most 80 lines and 8000 bytes (about
# one page), and its status word is `proposed`, `accepted`, `superseded` or `folded`. The status
# word is the first word of the `status:` line, in the frontmatter or, for a folded stub, in its
# first three lines; an ADR with neither has none to check.
#   scripts/adr-check
set -eu

cd "$(dirname "$0")/../docs/adr"
max_lines=80
max_bytes=8000
status=0
fail() { echo "adr-check: $*" >&2; status=1; }

for f in [0-9][0-9][0-9][0-9]-*.md; do
    problem=
    lines=$(wc -l < "$f")
    bytes=$(wc -c < "$f")
    if [ "$lines" -gt "$max_lines" ] || [ "$bytes" -gt "$max_bytes" ]; then
        problem="is $lines lines and $bytes bytes: the limit is $max_lines lines and $max_bytes bytes"
    fi
    word=$(awk 'NR == 1 && $0 == "---" { fm = 1; next } fm && $0 == "---" { exit } (fm || NR <= 3) && /^status:/ { sub(/^status:[ \t]*/, ""); sub(/[^a-z].*$/, ""); print; exit } !fm && NR > 3 { exit }' "$f")
    case "$word" in
        "" | proposed | accepted | superseded | folded) ;;
        *) problem="${problem:+$problem, and }has the status word \`$word\`: use proposed, accepted, superseded or folded" ;;
    esac
    [ -z "$problem" ] || fail "$f $problem (docs/adr/README.md)"
done
exit $status
