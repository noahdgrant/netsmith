#!/usr/bin/env bash
# Tests scripts/check-example-fmt.sh over a fake examples folder and a fake std/ with a stub
# `netsmith` (it exits with the code in $STUB_CODE for `project fmt --check`): the script must pass
# for files that are formatted, and fail for no board at all, for a file that is not formatted and for
# one the formatter cannot read. It needs nothing but bash.
#   scripts/check-example-fmt-test
set -eu

here="$(cd "$(dirname "$0")" && pwd)"
script="$here/check-example-fmt.sh"

tree="$(mktemp -d)"
trap 'rm -rf "$tree"' EXIT

stub="$tree/netsmith"
cat > "$stub" <<'STUB'
#!/usr/bin/env bash
[ "$1 $2 $3" = "project fmt --check" ] || { echo "stub: called as $*" >&2; exit 3; }
[ "${STUB_CODE:-0}" -ne 1 ] || echo "main.nsm"
exit "${STUB_CODE:-0}"
STUB
chmod +x "$stub"

failed=0

fresh() {
    rm -rf "$tree/examples" "$tree/std"
    mkdir -p "$tree/examples" "$tree/std/parts"
    touch "$tree/std/prelude.nsm" "$tree/std/parts/passive.nsm"
}

# run <name> <want exit> <text the output must hold or ''>: the script over the folders.
run() {
    local name="$1" want="$2" text="$3" code=0 out
    out="$(NETSMITH_EXAMPLES_DIR="$tree/examples" NETSMITH_STD_DIR="$tree/std" "$script" "$stub" 2>&1)" || code=$?
    if [ "$code" -ne "$want" ]; then
        echo "FAIL  $name: exit $code, wanted $want"
        printf '%s\n' "$out" | sed 's/^/      /'
        failed=1
    elif [ -n "$text" ] && ! printf '%s' "$out" | grep -qF -- "$text"; then
        echo "FAIL  $name: the output does not say: $text"
        printf '%s\n' "$out" | sed 's/^/      /'
        failed=1
    else
        echo "ok    $name"
    fi
}

fresh
run "no board at all" 1 "found no board"

fresh
touch "$tree/examples/led.nsm" "$tree/examples/led.physical.nsm"
mkdir -p "$tree/examples/proj"
touch "$tree/examples/proj/netsmith.toml"
STUB_CODE=0 run "boards, a project and std/ that are formatted" 0 "3 runs, every file formatted"
STUB_CODE=1 run "a file that is not formatted" 1 "files are not formatted"
STUB_CODE=2 run "a source the formatter cannot read" 1 "could not run (exit 2)"

if [ "$failed" -ne 0 ]; then
    echo "check-example-fmt-test: FAILED"
    exit 1
fi
echo "check-example-fmt-test: ok"
