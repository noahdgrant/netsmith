#!/usr/bin/env bash
# Tests scripts/check-example-lint.sh over a fake examples folder with a stub `netsmith` (it exits
# with the code in $STUB_CODE for `project lint`): the script must pass for boards that lint clean,
# and fail for no board at all, for a finding and for a source the linter cannot read. It needs
# nothing but bash.
#   scripts/check-example-lint-test
set -eu

here="$(cd "$(dirname "$0")" && pwd)"
script="$here/check-example-lint.sh"

tree="$(mktemp -d)"
trap 'rm -rf "$tree"' EXIT

stub="$tree/netsmith"
cat > "$stub" <<'STUB'
#!/usr/bin/env bash
[ "$1 $2 $3" = "project lint --strict" ] || { echo "stub: called as $*" >&2; exit 3; }
[ "${STUB_CODE:-0}" -eq 0 ] || echo "error: main.nsm:1:1: lint.naming: a finding"
exit "${STUB_CODE:-0}"
STUB
chmod +x "$stub"

failed=0

fresh() {
    rm -rf "$tree/examples"
    mkdir -p "$tree/examples"
}

# run <name> <want exit> <text the output must hold or ''>: the script over the folder.
run() {
    local name="$1" want="$2" text="$3" code=0 out
    out="$(NETSMITH_EXAMPLES_DIR="$tree/examples" "$script" "$stub" 2>&1)" || code=$?
    if [ "$code" -ne "$want" ]; then
        echo "FAIL  $name: exit $code, wanted $want"
        printf '%s\n' "$out" | sed 's/^/      /'
        failed=1
    elif [ -n "$text" ] && ! printf '%s' "$out" | grep -qF -- "$text"; then
        echo "FAIL  $name: the output does not say: $text"
        printf '%s\n' "$out" | sed 's/^/      /'
        failed=1
    else
        echo "ok    $name"
    fi
}

fresh
run "no board at all" 1 "found no board"

fresh
touch "$tree/examples/led.nsm" "$tree/examples/led.physical.nsm"
mkdir -p "$tree/examples/proj"
touch "$tree/examples/proj/netsmith.toml"
STUB_CODE=0 run "a board and a project that lint clean" 0 "2 boards and projects, no finding"
STUB_CODE=1 run "a finding" 1 "lint.naming: a finding"
STUB_CODE=2 run "a source the linter cannot read" 1 "could not run (exit 2)"

if [ "$failed" -ne 0 ]; then
    echo "check-example-lint-test: FAILED"
    exit 1
fi
echo "check-example-lint-test: ok"
