#!/usr/bin/env bash
# Which of CI's jobs a change needs. Reads the changed paths (one per line, from the repository's
# root) on stdin and prints `rust=`, `kicad=`, `recipes=`, `no_kicad=` and `locks=` as `true` or `false`, and `crates=`; the
# `changes` job of .github/workflows/ci.yml writes them to its outputs. `fmt` always runs, so it has
# no flag.
#   rust     clippy and the tests: anything a build or a test reads.
#   kicad    the `kicad` job: the same tests with KiCad 9 installed, so the ones that skip
#            themselves in `test` run. A change needs it when it can change what those tests see:
#            the crates that call kicad-cli or read KiCad's libraries (netsmith-kicad, -fab, -pcb,
#            -place-route, whose tests check the routed boards with kicad-cli, the netsmith crate
#            and the netsmith-cli crate, the binary and the tests that start it),
#            the crates that make the files those tests check
#            (netsmith-core, -design, -netlist), and the data the tests read: std/ (kicad.toml maps
#            kinds to KiCad's footprints), examples/ (the boards they build) and data/, and the
#            test helpers (netsmith-testkit: its sample libraries are what those tests build
#            with). The testkit is a dev-dependency only, so a change to it needs no other job.
#   recipes  the `recipes` job: the editor's browser recipes. They drive the `netsmith` binary
#            (its editor, and the build, fab and order pipeline behind it, with KiCad 9 installed)
#            against fixtures, so what is linked into that binary, the page, and the boards and
#            catalogs the recipes open make it run. It does not follow `kicad`: a path that only
#            the tests read does not reach the binary.
#   no_kicad the `no-kicad` job: scripts/check-no-kicad.sh builds and fabs every example with
#            the KiCad libraries and kicad-cli hidden (ADR 0097, step 4), on a runner with no
#            KiCad. It runs the `netsmith` binary and reads the examples and the standard library,
#            so it follows what is linked into the binary (the crates' source and manifests,
#            std/, examples/, data/) and the script itself; not a test file, a crate's examples
#            folder, the catalog refresh, or prose.
#   crates   the crates whose tests, and their dependents' tests, are all that `test` and `kicad`
#            run (issue #511): the folder names under crates/ the change touches, space-separated,
#            for a nextest filter of `rdeps(<crate>) | ...`. A path outside crates/ that turns
#            `rust` on names the crates whose tests read it, when only some do: docs/LANGUAGE.md,
#            docs/symbol-gallery.html and the skills in .agents/skills are read by the netsmith
#            crate's tests and by init.rs (`include_str!`), so they name `netsmith` (its
#            dependents, netsmith-cli, run too); an example names the crates whose tests read it
#            (`example_readers`, below: `netsmith` for each, and the stage crates that include it).
#            Empty means every test: a change with no Rust in it, or one with a path outside the
#            crates that turns `rust` on and names no crate (std/, data/, the workspace manifest,
#            Cargo.lock, the toolchain, scripts/, the workflows, .claude/, a path nothing here
#            knows). A push to main runs every test.
#   locks    the `locks` job: scripts/check-example-locks.sh runs `netsmith lock --check` over every
#            example (ADR 0100). A pick is what the solver, std/ and the catalogs in data/ say about
#            the parts of an example, so it follows the same paths as `no_kicad`: the crates that
#            are linked into the binary (the solver is netsmith-solve, and the checker and the
#            design stage change what it is asked), std/, examples/, data/ (the catalogs), and the
#            script itself; not a test file, the catalog refresh (it never runs in a build), or prose.
#            Not the crates after the solver either: `lock` reads no KiCad library, no footprint and
#            no board, so a change to netsmith-pcb, -place-route, -fab, -netlist, -3d, -view or
#            -editor cannot move a pick (the netsmith-kicad crate keeps `locks`: the umbrella's
#            design stage still reads its mapping).
#
# What a test file is, and why it is the one narrowing of `kicad`. A file of tests runs in `test`
# and again in `kicad`; the second run differs only for a test that asks for KiCad. So a change
# to a test file turns `kicad` on only if the file can ask: it names kicad-cli, one of the
# helpers that look for KiCad or its stock libraries, a variable of the KiCad lookup, a Workspace (it opens
# libraries of the project, or the stock ones), or starts the binary (see KICAD_TOKENS below).
# A file that names none of them is `rust` only, and a test file never turns `recipes` on, since
# the binary does not contain it. The file is read from the checkout (the pull request's merge
# commit in CI): a path that is not there (a deletion) or that is no `tests/*.rs` file of its
# crate (the shared `tests/common`, `tests/main.rs`, fixtures) counts as KiCad-backed. The same
# holds for the `tests.rs` of a module in `src/`. A change in the source of a crate (even in
# crates/netsmith/src/lib.rs, which builds the design and exports its KiCad files) is not
# narrowed: it is the code those tests run. The one exception is crates/netsmith/src/refresh/*
# (the catalog refresh: CSV and HTTP, nothing of KiCad), which keeps `recipes` (the editor
# refreshes catalogs) and drops `kicad`.
#
# A change to the workflows, the actions (.github/actions) or to scripts/ runs everything, and so does a path nothing here knows:
# when in doubt, the job runs. Only files that nothing builds or tests read (prose, the licence,
# the issue templates) leave clippy and the tests out. A test does read docs/LANGUAGE.md and
# the skills in .agents/skills (crates/netsmith/tests/guide.rs, src/init.rs), so those count as code
# (of the netsmith crate, whose dependents run too: no other crate reads them);
# so does docs/symbol-gallery.html (crates/netsmith/tests/symbol_gallery.rs compares it with the rendered page).
# A push to main skips this script: the job runs everything there.
# The rules are pinned by scripts/ci-changes-test (the `changes` job runs it).
#   scripts/ci-changes < paths
# CI_CHANGES_ROOT names the tree the test files are read from (the repository by default).
set -eu

root="${CI_CHANGES_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"

# What makes a test file ask for KiCad (grep -E): the kicad-cli program and its variable, the
# environment of a process or of the lookup (`.env(`, `set_var` of a KiCad variable, the
# `*_VARIABLE` names of netsmith_kicad::install; a test that only names NETSMITH_KICAD_SYMBOLS
# in a message it expects does not ask), the lookup of this machine (`Search::machine()`;
# `installed_by(&search)` over a search of the test's own is no lookup of the machine), the helpers that look for KiCad or skip without it, the
# constructors of the stock libraries (`Libraries::standard()`, `::installed()`,
# `Libraries::for_project()`, which fall back to them) and `netsmith::build` (which uses
# `standard()`), a Workspace (it builds with those), the binary under test (it looks for KiCad
# itself) and any other process. (`Mapping::standard()` and `Mapping::for_project()` read the
# mapping only, and `build_with` takes the libraries as an argument.)
KICAD_TOKENS='KicadCli|kicad-cli|KICAD_CLI|\.envs?\(|(set_var|env::var)\("(NETSMITH_)?KICAD|_VARIABLE|Search::machine\(|locate\(Kind::|locate_runnable|kicad_libraries_installed|skip_without_kicad_libraries|Libraries::(standard|for_project)\(|::installed\(|netsmith::build\b|netsmith::\{([^}]*[ ])?build[,} ]|^[[:space:]]+build,?$|Workspace|CARGO_BIN_EXE|Command::new|skipped: no KiCad'

rust=false kicad=false recipes=false no_kicad=false locks=false
# The crates the change touches, for `crates=`; `wide` once a path outside the crates turns `rust` on
# and names no crate. `mapped` is the crates a path outside crates/ names (worked out for each path).
crates="" wide=false mapped=""
all() { rust=true kicad=true recipes=true no_kicad=true locks=true; }

# Whether a file of tests asks for KiCad: it is unreadable here, or names one of the tokens.
asks_for_kicad() {
    [ -f "$root/$1" ] || return 0
    grep -qE "$KICAD_TOKENS" "$root/$1"
}

# A change in a crate whose tests (or whose output the tests check) reach KiCad: `$1` is the part
# of the path under the crate's folder, `$2` the whole path.
kicad_crate() {
    case "$1" in
        # The shared helpers, the list of modules, the fixtures: every test file uses them.
        tests/main.rs | tests/*/*) rust=true kicad=true ;;
        tests/*.rs | tests.rs | */tests.rs)
            rust=true
            if asks_for_kicad "$2"; then kicad=true; fi
            ;;
        # Not in the binary: a test, a crate's own example program, a benchmark.
        tests/* | examples/* | benches/*) rust=true kicad=true ;;
        *) all ;;
    esac
}

# A crate after the solver (netsmith-pcb, -place-route, -fab, -netlist): as `kicad_crate`, but
# `netsmith lock` runs none of it, so the change does not start `locks`.
after_solver() {
    kicad_crate "$@"
    locks=false
}

# The crates whose tests read an example (`$1`: a path under examples/): the file of a board or a
# folder of a project, with its lock, physical file and layout (`led.nsm`, `led.lock.toml`,
# `led_panel.physical.nsm`, `orbit/...`) all go by the name before the first dot. Every example is read
# by crates/netsmith (many tests pick any example) and so by netsmith-cli, its dependent; some are
# also included by the tests of a stage crate. A stage crate that reads one more has to be added here:
# scripts/ci-changes-test finds the ones that are missing in the repository's own tests.
example_readers() {
    name="${1#examples/}"
    name="${name%%/*}"
    name="${name%%.*}"
    case "$name" in
        led | status_indicator) echo "netsmith netsmith-lang netsmith-check netsmith-solve netsmith-design" ;;
        linear_regulator | two_boards) echo "netsmith netsmith-check netsmith-solve netsmith-design" ;;
        carrier_and_cards) echo "netsmith netsmith-check netsmith-solve" ;;
        four_layer | six_layer | ten_layer) echo "netsmith netsmith-design" ;;
        *) echo "netsmith" ;;
    esac
}

while IFS= read -r path; do
    [ -n "$path" ] || continue
    # A Markdown file in the root (README.md, AGENTS.md, ...) is prose.
    case "$path" in */*) ;; *.md) continue ;; esac
    # `rust` and `locks` are worked out for this path alone, then added to what the others gave.
    rust_before="$rust" rust=false locks_before="$locks" locks=false mapped=""
    case "$path" in
        .github/workflows/* | .github/actions/* | scripts/*) all ;;

        # Prose that nothing reads.
        .github/ISSUE_TEMPLATE/* | .github/*.md | .github/CODEOWNERS | .github/dependabot.yml | .github/PULL_REQUEST_TEMPLATE*) ;;
        .gitignore | .gitattributes | .editorconfig | LICENSE* | GLOSSARY.md) ;;
        # Read by the netsmith crate's tests and by its init.rs, and by no other crate.
        docs/LANGUAGE.md | docs/symbol-gallery.html) rust=true mapped=netsmith ;;
        docs/*) ;;
        .agents/skills/netsmith-dev-verify-editor/*) rust=true recipes=true mapped=netsmith ;;
        .agents/skills/*) rust=true mapped=netsmith ;;
        .claude/*) rust=true ;;
        .agents/*) ;;

        crates/netsmith/src/refresh/*) rust=true recipes=true ;;
        crates/netsmith-kicad/* | crates/netsmith-core/*) kicad_crate "${path#crates/*/}" "$path" ;;
        crates/netsmith-design/* | crates/netsmith/* | crates/netsmith-cli/*) kicad_crate "${path#crates/*/}" "$path" ;;
        # After the solver: no pick of `netsmith lock` depends on them.
        crates/netsmith-fab/* | crates/netsmith-pcb/* | crates/netsmith-place-route/* | crates/netsmith-netlist/*) after_solver "${path#crates/*/}" "$path" ;;
        # The 3D scene and its writers (netsmith-3d, issue #518): the editor's 3D view draws them,
        # and no test of the crate asks for KiCad, so a change to it does not need `kicad`.
        crates/netsmith-editor/tests/* | crates/netsmith-view/tests/* | crates/netsmith-3d/tests/*) rust=true ;;
        crates/netsmith-editor/* | crates/netsmith-view/* | crates/netsmith-3d/*) rust=true recipes=true no_kicad=true ;;
        # The test helpers: never linked into the binary, and every test builds with them.
        crates/netsmith-testkit/*) rust=true kicad=true ;;
        crates/*/tests/*) rust=true ;;
        crates/*) rust=true no_kicad=true locks=true ;;
        Cargo.toml | Cargo.lock | rust-toolchain* | .cargo/*) all ;;
        std/*) all ;;
        examples/*) all; mapped="$(example_readers "$path")" ;;
        data/*) all ;;
        rustfmt.toml | .rustfmt.toml | clippy.toml) rust=true ;;

        *) all ;;
    esac
    if [ "$rust" = true ]; then
        case "$path" in
            crates/*/*) crate="${path#crates/}"; crate="${crate%%/*}"
                case " $crates " in *" $crate "*) ;; *) crates="${crates:+$crates }$crate" ;; esac ;;
            *) if [ -z "$mapped" ]; then
                   wide=true
               else
                   for crate in $mapped; do
                       case " $crates " in *" $crate "*) ;; *) crates="${crates:+$crates }$crate" ;; esac
                   done
               fi ;;
        esac
    fi
    [ "$rust_before" = true ] && rust=true
    [ "$locks_before" = true ] && locks=true
done
[ "$wide" = false ] || crates=""

echo "rust=$rust"
echo "kicad=$kicad"
echo "recipes=$recipes"
echo "no_kicad=$no_kicad"
echo "locks=$locks"
echo "crates=$crates"
