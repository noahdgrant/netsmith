#!/usr/bin/env bash
# Tests scripts/ci-changes: a table of changed paths and the flags the script must print for them
# (`rust kicad recipes no_kicad locks designs`, each `1` or `0`, and `desktop` and `crates` in rows of
# their own), so that an edit of the rules cannot widen or narrow
# them by accident. The `changes` job of .github/workflows/ci.yml runs it before it uses the
# script. It needs nothing but bash and git.
#
# The rows that read a test file run over a small tree of its own (CI_CHANGES_ROOT): a test file
# that names no KiCad, one that does by each token, a deleted one. A last check runs over the
# real repository: every test file that skips itself without KiCad, or looks for kicad-cli, must
# turn `kicad` on, whatever the token list of the script says.
#   scripts/ci-changes-test
set -eu

here="$(cd "$(dirname "$0")" && pwd)"
script="$here/ci-changes"
repo="$(cd "$here/.." && pwd)"

tree="$(mktemp -d)"
trap 'rm -rf "$tree"' EXIT

# A test file of the fixture tree, with `$2` as its text.
file() {
    mkdir -p "$tree/$(dirname "$1")"
    printf '%s\n' "$2" > "$tree/$1"
}

failed=0

# The flags `ci-changes` prints for the paths on the arguments, as "rust kicad recipes no_kicad locks designs" of
# 0 and 1.
flags_of() {
    printf '%s\n' "$@" | CI_CHANGES_ROOT="$tree" "$script" | awk -F= '
        { v[$1] = ($2 == "true") ? 1 : 0 }
        END { print v["rust"], v["kicad"], v["recipes"], v["no_kicad"], v["locks"], v["designs"] }'
}

# row "<rust kicad recipes no_kicad locks designs>" path...: the paths together must give those flags.
row() {
    want="$1"
    shift
    got="$(flags_of "$@")"
    if [ "$got" != "$want" ]; then
        echo "FAIL: $* -> $got, wanted $want"
        failed=1
    fi
}

# --- the fixture tree ---------------------------------------------------------------------
pure='use netsmith_testkit::TempDir;
use netsmith_pipeline::{Libraries, build_with};
fn t() { build_with(name, text, &loader, &catalogs, &Libraries::with_mapping(m, s, f)); }'
file crates/netsmith-tools/tests/pure.rs "$pure"
file crates/netsmith-cli/tests/pure.rs "$pure"
file crates/netsmith-fab/tests/pure.rs "$pure"
file crates/netsmith-pcb/tests/pure.rs "$pure"
file crates/netsmith-placer/tests/pure.rs "$pure"
file crates/netsmith-placer/tests/asks.rs "$pure
KicadCliExe::locate_runnable()"
file crates/netsmith-router/tests/pure.rs "$pure"
file crates/netsmith-router/tests/asks.rs "$pure
KicadCliExe::locate_runnable()"
file crates/netsmith-design/tests/pure.rs "$pure"
file crates/netsmith-workspace/src/tests.rs "$pure"
file crates/netsmith-fab/src/tests.rs "$pure"
file crates/netsmith-tools/tests/main.rs "mod pure;"
i=0
for token in 'KicadCliExe::locate_runnable()' 'skip_without_kicad_libraries()' 'kicad_libraries_installed()' \
    'Libraries::standard()' 'SymbolLib::installed()' 'Libraries::for_project(p)' 'Search::machine()' 'install::locate(Kind::Symbols)' 'use netsmith_pipeline::build;' 'use netsmith_pipeline::{Built, build};' 'use netsmith_pipeline::{build, Built};' 'netsmith_pipeline::build(a, b, c)' 'use netsmith_pipeline::{
    Built,
    build,
}' 'Workspace::open(t)' \
    'env!("CARGO_BIN_EXE_netsmith")' 'Command::new("git")' '.env("KICAD_CLI", x)' \
    '.env("NETSMITH_KICAD_SYMBOLS", x)' 'std::env::set_var("NETSMITH_KICAD_SYMBOLS", x)' 'std::env::var("KICAD_X")' 'install::SYMBOLS_VARIABLE' 'eprintln!("skipped: no KiCad")' 'let cli: &dyn KicadCli = c;'; do
    i=$((i + 1))
    file "crates/netsmith-tools/tests/asks$i.rs" "$pure
$token"
done
# Names a variable only in a message it expects: no process, no lookup.
file crates/netsmith-tools/tests/message.rs "$pure
assert!(e.contains(\"NETSMITH_KICAD_SYMBOLS\"), \"{e}\");"
file crates/netsmith-tools/tests/mapping.rs "$pure
std::env::var("STD_PRINT").is_ok(); SymbolLib::installed_by(&machine); let m = Mapping::standard(); let n = netsmith_kicad::Mapping::for_project(Some(d)).unwrap();
use netsmith_pipeline::{Built, build_with};"
file crates/netsmith-tools/tests/common/mod.rs "$pure"
file crates/netsmith-tools/tests/fixtures/board.nsm "board B {}"
file crates/netsmith-view/tests/asks.rs "KicadCliExe::locate()"
file crates/netsmith-catalog/src/refresh/mod.rs "KicadCliExe::locate()"

# --- prose and files nothing reads: no job -------------------------------------------------
row "0 0 0 0 0 0" README.md
row "0 0 0 0 0 0" AGENTS.md CLAUDE.md CHANGELOG.md
