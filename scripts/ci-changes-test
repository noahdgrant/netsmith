# --- crates=: the crates whose tests (and dependents' tests) run; empty is every test ---------
crates_of() {
    printf '%s\n' "$@" | CI_CHANGES_ROOT="$tree" "$script" | sed -n 's/^crates=//p'
}
crates_row() {
    want="$1"
    shift
    got="$(crates_of "$@")"
    if [ "$got" != "$want" ]; then
        echo "FAIL: $* -> crates=$got, wanted crates=$want"
        failed=1
    fi
}
crates_row "netsmith-view" crates/netsmith-view/src/layout.rs
