# --- the real repository: a test file that can skip without KiCad turns `kicad` on ------------
# Independent of the token list of the script: these are the spellings of the repository's own
# helpers (netsmith_kicad::install, netsmith_fab::KicadCliExe).
cd "$repo"
checked=0
for f in crates/*/tests/*.rs crates/*/src/tests.rs crates/*/src/*/tests.rs; do
    [ -f "$f" ] || continue
    if grep -qE 'skip_without_kicad_libraries|kicad_libraries_installed|locate_runnable|KicadCliExe::locate|skipped: no KiCad' "$f"; then
        checked=$((checked + 1))
        case "$f" in
            crates/netsmith-editor/* | crates/netsmith-view/* | crates/netsmith-solve/* | crates/netsmith-catalog/* | crates/netsmith-check/* | crates/netsmith-lang/* | crates/netsmith-quantity/* | crates/netsmith-dxf/*) continue ;;
        esac
        got="$(printf '%s\n' "$f" | "$script" | awk -F= '$1 == "kicad" { print $2 }')"
        if [ "$got" != true ]; then
            echo "FAIL: $f can skip without KiCad, but kicad=$got"
            failed=1
        fi
    fi
done
if [ "$checked" -lt 5 ]; then
    echo "FAIL: found only $checked KiCad-backed test files in the repository (looking in the wrong place?)"
    failed=1
fi

# --- the real repository: every crate that reads an example is named for it ---------------------
# A change to `examples/<name>` runs the tests of the crates that `example_readers` names, and their
# dependents', so a crate that reads the example and is not named would miss the change. The netsmith
# crate (and with it netsmith-cli) reads any example and is always named; for each other crate, every
# example its tests or source name (not in a comment) must give that crate. A reference with no name
# (`join("examples")`, a path built at run time) cannot be told apart from a read of every example:
# such a crate has to be named for every example in `example_readers`, or this check says so.
readers=0
for dir in crates/*; do
    crate="$(basename "$dir")"
    case "$crate" in netsmith | netsmith-cli) continue ;; esac
    refs="$(grep -rnE '\.\./examples|"examples"|join\("examples|[^a-z_/]examples/[a-z_]' "$dir/tests" "$dir/src" \
        --include='*.rs' 2> /dev/null | grep -vE '^[^:]*:[0-9]+:[[:space:]]*//' || true)"
    [ -n "$refs" ] || continue
    readers=$((readers + 1))
    names="$(printf '%s\n' "$refs" | grep -oE 'examples/[a-z0-9_]+' | sed 's|examples/||' | sort -u || true)"
    found=0
    for name in $names; do
        # Only the names of examples of the repository (not the crate's own `examples/` programs).
        [ -e examples/"$name" ] || compgen -G "examples/$name.*" > /dev/null || continue
        found=1
        got="$(printf 'examples/%s.nsm\n' "$name" | "$script" | sed -n 's/^crates=//p')"
        case " $got " in
            *" $crate "*) ;;
            *)
                echo "FAIL: $crate reads examples/$name, but crates=$got for it: add $crate to example_readers in scripts/ci-changes"
                failed=1
                ;;
        esac
    done
    if [ "$found" -eq 0 ]; then
        echo "FAIL: $crate reads the examples folder in a way that names no example ($(printf '%s' "$refs" | head -n 1)): name it for every example in example_readers, or read a named one"
        failed=1
    fi
done
if [ "$readers" -lt 3 ]; then
    echo "FAIL: found only $readers crates besides netsmith that read the examples (looking in the wrong place?)"
    failed=1
fi

if [ "$failed" -ne 0 ]; then
    exit 1
fi
echo "ci-changes: every row holds"
