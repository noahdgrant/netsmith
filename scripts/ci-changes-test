# --- kicad_lookup=: the `kicad-lookup` job (the KiCad library lookup on three systems, issue #791) ---
lookup_of() {
    printf '%s\n' "$@" | CI_CHANGES_ROOT="$tree" "$script" | sed -n 's/^kicad_lookup=//p'
}
lookup_row() {
    want="$1"
    shift
    got="$(lookup_of "$@")"
    if [ "$got" != "$want" ]; then
        echo "FAIL: $* -> kicad_lookup=$got, wanted kicad_lookup=$want"
        failed=1
    fi
}
