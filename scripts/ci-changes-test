# --- desktop=: the desktop shell's job (desktop/, its own workspace) --------------------------
desktop_of() {
    printf '%s\n' "$@" | CI_CHANGES_ROOT="$tree" "$script" | sed -n 's/^desktop=//p'
}
desktop_row() {
    want="$1"
    shift
    got="$(desktop_of "$@")"
    if [ "$got" != "$want" ]; then
        echo "FAIL: $* -> desktop=$got, wanted desktop=$want"
        failed=1
    fi
}
# The shell itself: its job and no other; `build` makes the binary its tests start, of netsmith-cli only.
