#!/usr/bin/env bash
# Proves, for the `test` and `kicad` jobs of .github/workflows/ci.yml, that their slices (cargo nextest
# `--partition slice:K/N`, K = 1..N) between them run every test that `cargo test --workspace`
# runs, each in exactly one slice. It lists the tests of the built workspace, so it needs no
# build of its own beyond what the job did.
# The `kicad` job runs only the tests scripts/ci-kicad-tests selects: with `kicad` as the second
# argument the proof is over that filter (each selected test in exactly one slice); otherwise it is
# over every test, and also against the count of `cargo test`.
# A pull request that changes some crates archives the tests of the packages they reach only
# (scripts/ci-rdeps, issue #618), so the proof is over those: CI_PACKAGE_ARGS holds the packages
# as the arguments of cargo (`-p a -p b`; unset or `--workspace` is the whole workspace, which a
# plain `cargo nextest list` would otherwise build in full). A narrowed run may leave a slice with
# no test, as the `test` and `kicad` jobs allow, so an empty slice is no failure there.
#   scripts/ci-test-slices N [job]
set -euo pipefail
slices="${1:?usage: scripts/ci-test-slices N [job]}"
job="${2:-test}"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
read -r -a select <<< "${CI_PACKAGE_ARGS:---workspace}"
[ "${#select[@]}" -gt 0 ] || select=(--workspace)
scoped=false
[ "${select[*]}" = "--workspace" ] || scoped=true
filter=()
if [ "$job" = kicad ]; then
    expr="$(scripts/ci-kicad-tests)"
    filter=(-E "$expr")
fi

# One line per test nextest would run (not the ignored ones), "binary test", sorted.
tests() {
    cargo nextest list "${select[@]}" --message-format json "${filter[@]}" "$@" |
        jq -r '."rust-suites" | to_entries[] | .key as $binary | .value.testcases | to_entries[]
               | select(.value."filter-match".status == "matches") | "\($binary) \(.key)"' |
        sort
}

tests > "$work/all"
total="$(wc -l < "$work/all")"
sum=0
for k in $(seq 1 "$slices"); do
    tests --partition "slice:$k/$slices" > "$work/slice-$k"
    n="$(wc -l < "$work/slice-$k")"
    echo "$job slice $k/$slices: $n tests"
    if [ "$n" -eq 0 ] && [ "$scoped" = false ]; then echo "::error::$job slice $k is empty"; exit 1; fi
    sum=$((sum + n))
done
echo "$job, all: $total tests, the slices add up to $sum"

cat "$work"/slice-* | sort > "$work/union"
if [ "$(uniq -d < "$work/union" | wc -l)" -ne 0 ]; then
    echo "::error::tests that are in more than one slice:"; uniq -d < "$work/union"; exit 1
fi
if ! cmp -s "$work/union" "$work/all"; then
    echo "::error::the slices do not add up to the whole run:"; diff "$work/union" "$work/all" || true; exit 1
fi

if [ "$job" = kicad ]; then
    echo "ok ($job): $total selected tests, each in exactly one of $slices slices"
    exit 0
fi

# The same count from libtest itself: what `cargo test --workspace` would run, less the ignored.
# (Doc tests are run apart, by `cargo test --doc`.)
listed="$(cargo test "${select[@]}" --lib --bins --tests -- --list 2> /dev/null | grep -c ': test$' || true)"
ignored="$(cargo test "${select[@]}" --lib --bins --tests -- --list --ignored 2> /dev/null | grep -c ': test$' || true)"
echo "cargo test --list: $listed tests, $ignored ignored"
if [ $((listed - ignored)) -ne "$total" ]; then
    echo "::error::nextest lists $total tests, cargo test lists $((listed - ignored))"; exit 1
fi
echo "ok ($job): $total tests, each in exactly one of $slices slices, the count of cargo test"
