//! A small board for the editor recipes. Its physical file, `constrained.physical.nsm`, has a
//! requirement on where a header goes. The layout file beside it puts the header by hand where
//! the requirement does not allow it, so the editor has a constraint finding to show.

import std::parts::connector::Header1x2
import std::mfg::jlcpcb::TwoLayer

board Cased {
    .process: TwoLayer {
        .stackup.thickness &= 1.6mm
    }
    .power: Header1x2
    .aux: Header1x2
}
