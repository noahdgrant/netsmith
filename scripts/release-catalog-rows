#!/usr/bin/env bash
# Lists the rows the built-in catalogs gained between two releases (issue #1119): a project's own
# catalog may already have a part number on the list, and then the project stops building with
# "a part is in a catalog once" until its row is removed and `netsmith project lock --update`
# sets the lock to the built-in row (docs/MIGRATING.md). The list goes into the release's notes
# (docs/RELEASING.md).
#
# Usage: scripts/release-catalog-rows <from-ref> [<to-ref>]
# `to-ref` defaults to HEAD. One line for each part (its `mpn`, the part's identity, ADR 0143) that
# is in `data/jlcpcb/catalog/` at `to-ref` and was not at `from-ref`, with the LCSC number of its
# offer in `data/offers/lcsc.csv` when it has one: `- resistor: 0402WGF3300TCE (C25104)`, in
# catalog and part order. The `mpn` column is found by the header, so a ref from before the
# catalogs lost their `lcsc` column reads too. Prints nothing when no row was added. Reads git
# only; changes nothing.
set -euo pipefail

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
    echo "usage: $0 <from-ref> [<to-ref>]" >&2
    exit 2
fi
from="$1"
to="${2:-HEAD}"
repo="$(cd "$(dirname "$0")/.." && pwd)"
dir="data/jlcpcb/catalog"

cd "$repo"
git rev-parse --verify --quiet "$from^{commit}" >/dev/null || { echo "error: $from is not a commit" >&2; exit 2; }
git rev-parse --verify --quiet "$to^{commit}" >/dev/null || { echo "error: $to is not a commit" >&2; exit 2; }

# The part numbers of one catalog file at a ref, one a line, nothing when the file is not there.
# The cells before `mpn` hold no comma in these files, so a line splits on its commas there.
mpns() {
    git show "$1:$2" 2>/dev/null |
        awk -F, 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "mpn") m = i; next }
                 m && $m != "" { print $m }' || true
}

# The LCSC number of the offer of the part `mpn` at `to-ref`, if there is one.
sku_of() {
    git show "$to:data/offers/lcsc.csv" 2>/dev/null |
        awk -F, -v n="$1" 'NR > 1 && $2 == n { print $3; exit }' || true
}

for file in $(git ls-tree --name-only "$to" "$dir/" | sort); do
    case "$file" in *.csv) ;; *) continue ;; esac
    catalog="$(basename "$file" .csv)"
    [ "$catalog" = considered ] && continue
    comm -13 <(mpns "$from" "$file" | sort -u) <(mpns "$to" "$file" | sort -u) |
        while read -r mpn; do
            sku="$(sku_of "$mpn")"
            if [ -n "$sku" ]; then
                echo "- $catalog: $mpn ($sku)"
            else
                echo "- $catalog: $mpn"
            fi
        done
done
