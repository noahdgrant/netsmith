#!/usr/bin/env bash
# Builds the editor's page by hand. No built page is committed (ADR 0114): `cargo build` builds it
# from crates/netsmith-editor/web by itself when Node is there, and embeds a placeholder when not.
#   scripts/web-bundle build   build the page into crates/netsmith-editor/web/dist (not committed)
#   scripts/web-bundle hash    print the hash of the sources
# Needs Node 20 or newer (PATH, else the newest in ~/.nvm) and uses the cargo target directory of
# the environment.
set -eu
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here/.."
case "${1:-}" in
    build | hash) ;;
    *) echo "usage: scripts/web-bundle build | hash" >&2; exit 2 ;;
esac
exec cargo run --quiet -p netsmith-editor --example web_bundle -- "$1"
