//! ACME, a fictional fabricator, and its 8- and 10-layer processes.
//!
//! ACME does not exist. Its processes are here so that a board that needs eight or ten copper
//! layers (a port of a big board, a showcase) can be designed, routed, checked and written as a
//! fab package before a real fabricator's build-up of that many layers is in std: JLCPCB
//! publishes none (`std::mfg::jlcpcb`, ADR 0111). Every number below was chosen, not sourced,
//! and stands for no real fabricator's capability. A board on an ACME process cannot be
//! ordered: `fab` writes its package and says in `fab-notes.txt` that it is not for ordering,
//! and `fab --order` refuses it (ADR 0112).
//!
//! The numbers were chosen to be plausible:
//!
//! - the design rules are those of JLCPCB's multilayer rows (`SixLayer`): track 0.09 mm, space
//!   0.1 mm, drill 0.15 mm, via 0.25 mm, annular ring 0.15 mm, plane to hole 0.3 mm, so a board
//!   moved between JLCPCB and ACME keeps its rules;
//! - each build-up is symmetric about its middle, 1.6 mm nominal: 1 oz outer copper (0.035 mm),
//!   0.5 oz inner copper (0.0152 mm, as JLCPCB's), prepregs of the common glass styles with the
//!   thicknesses and permittivities JLCPCB gives for them (3313: 0.0994 mm, 4.1; 2116: 0.1088 mm,
//!   4.16), and cores of common thicknesses (0.2, 0.25, 0.3 and 0.41 mm) at a typical FR-4
//!   permittivity of 4.6.

import std::mfg::stackup::{InnerLayer, Pour, Stackup}

/// ACME's eight-layer board: 1 oz outer copper, 0.5 oz inner copper, 1.6 mm thick. ACME is a
/// fictional fabricator: every number was chosen, not sourced, and a board on this process
/// cannot be ordered (see the file's header). Each of the six inner layers is a plane, whose
/// net the board names (`.process.inner1.net &= "GND"`), or a signal layer
/// (`.process.inner2.use &= "signal"`, ADR 0111); the router draws signals on the outer layers
/// only.
///
/// The build-up `ACME-8L-1.6`, from the top: outer copper 0.035 mm, prepreg 2116 0.1088 mm,
/// core 0.3 mm, prepreg 2116 0.1088 mm, core 0.41 mm, prepreg 2116 0.1088 mm, core 0.3 mm,
/// prepreg 2116 0.1088 mm, outer copper 0.035 mm, with 0.0152 mm of copper on each of the six
/// inner layers: 1.6064 mm in all.
interface EightLayer {
    /// Who makes it: no one. ACME is fictional, and `fab --order` refuses a board on it.
    .fabricator: String
    .source:     String
    .fabricator &= "ACME"
    .source     &= "std/mfg/acme.nsm: chosen, not sourced; ACME is a fictional fabricator"

    /// The narrowest track.
    .min_track: Length
    .min_track &= 0.09mm..1m
    /// The least space between copper of different nets.
    .min_clearance: Length
    .min_clearance &= 0.1mm..1m
    /// The smallest drilled hole, which is a via's drill.
    .min_drill: Length
    .min_drill &= 0.15mm..1m
    /// The smallest copper disc of a via.
    .min_via_diameter: Length
    .min_via_diameter &= 0.25mm..1m
    /// The least copper left round a plated pad's hole. A via's is `.min_via_ring`.
    .min_annular_ring: Length
    .min_annular_ring &= 0.15mm..1m
    /// The least space between the edges of two holes when one is a pad's, and between two
    /// vias' holes.
    .min_hole_to_hole: Length
    .min_hole_to_hole &= 0.45mm..1m
    .min_via_hole_to_hole: Length
    .min_via_hole_to_hole &= 0.2mm..1m
    /// The least space between copper and a routed board edge.
    .min_edge_clearance: Length
    .min_edge_clearance &= 0.2mm..1m
    /// The least space between a plane and the hole of a via or a through-hole pad that is
    /// not on its net.
    .min_plane_hole_clearance: Length
    .min_plane_hole_clearance &= 0.3mm..1m
    /// The thinnest silkscreen stroke.
    .min_silk_width: Length
    .min_silk_width &= 0.15mm..1m
    /// The smallest silkscreen text.
    .min_text_height: Length
    .min_text_height &= 1mm..1m
    /// The least space between silkscreen and a pad.
    .min_silk_to_pad: Length
    .min_silk_to_pad &= 0.15mm..1m
    /// The least solder mask left between two pads.
    .min_mask_bridge: Length
    .min_mask_bridge &= 0.13mm..1m
    /// The least copper round a via's hole, on each side.
    .min_via_ring: Length
    .min_via_ring &= 0.05mm..1m
    /// The least space from the edge of a via's hole or a non-plated hole to a track of
    /// another net.
    .min_hole_clearance: Length
    .min_hole_clearance &= 0.2mm..1m
    /// The least space from a plated pad's hole to a track of another net.
    .min_plated_hole_clearance: Length
    .min_plated_hole_clearance &= 0.28mm..1m
    /// The least space between surface-mount pads of different nets.
    .min_pad_to_pad: Length
    .min_pad_to_pad &= 0.15mm..1m
    /// The least space between a solder mask opening and a track of another net.
    .min_mask_to_track: Length
    .min_mask_to_track &= 0.09mm..1m
    /// The smallest non-plated hole, the narrowest plated slot and the narrowest non-plated
    /// slot.
    .min_npth_drill: Length
    .min_npth_drill &= 0.5mm..1m
    .min_plated_slot: Length
    .min_plated_slot &= 0.35mm..1m
    .min_npth_slot: Length
    .min_npth_slot &= 1mm..1m
    /// The via the router draws, its hole and its copper: an offer the board may replace
    /// (`.process.via_drill &= 0.3mm`), checked against the rules above.
    .via_drill: Length
    .via_drill ?= 0.2mm
    .via_diameter: Length
    .via_diameter ?= 0.45mm
    /// The largest via the process fills with epoxy and caps with copper, which a via may be
    /// to stand in a pad. An upper bound, unlike the `min_` fields; the board narrows it to
    /// `0mm` where it wants no via in a pad (`.process.via_in_pad &= 0mm`).
    .via_in_pad: Length
    .via_in_pad &= 0mm..0.55mm

    /// How far above the board's temperature a loaded track may heat: the rise the
    /// IPC-2221 track width check (ADR 0036) designs to. Left unstated, as on JLCPCB's
    /// processes; a board that states none is checked at 10 K, this tool's default.
    /// It is an upper bound: `.process.max_temperature_rise &= 20K` allows 20 K.
    .max_temperature_rise: Temperature
    /// How much narrower than drawn a finished track may be, as a fraction.
    .track_width_tolerance: Number
    .track_width_tolerance &= 0.2
    /// The copper plated on the wall of a hole.
    .hole_plating: Length
    .hole_plating &= 0.018mm

    .stackup: Stackup
    .stackup.layers        &= 8
    .stackup.thickness     &= 1.6mm
    .stackup.copper_weight &= 1
    .stackup.build         &= "ACME-8L-1.6"
    .stackup.inner_copper  &= 0.0152mm
    .stackup.dielectric1.kind      &= "prepreg"
    .stackup.dielectric1.glass     &= "2116"
    .stackup.dielectric1.thickness &= 0.1088mm
    .stackup.dielectric1.epsilon   &= 4.16
    .stackup.dielectric2.kind      &= "core"
    .stackup.dielectric2.thickness &= 0.3mm
    .stackup.dielectric2.epsilon   &= 4.6
    .stackup.dielectric3.kind      &= "prepreg"
    .stackup.dielectric3.glass     &= "2116"
    .stackup.dielectric3.thickness &= 0.1088mm
    .stackup.dielectric3.epsilon   &= 4.16
    .stackup.dielectric4.kind      &= "core"
    .stackup.dielectric4.thickness &= 0.41mm
    .stackup.dielectric4.epsilon   &= 4.6
    .stackup.dielectric5.kind      &= "prepreg"
    .stackup.dielectric5.glass     &= "2116"
    .stackup.dielectric5.thickness &= 0.1088mm
    .stackup.dielectric5.epsilon   &= 4.16
    .stackup.dielectric6.kind      &= "core"
    .stackup.dielectric6.thickness &= 0.3mm
    .stackup.dielectric6.epsilon   &= 4.6
    .stackup.dielectric7.kind      &= "prepreg"
    .stackup.dielectric7.glass     &= "2116"
    .stackup.dielectric7.thickness &= 0.1088mm
    .stackup.dielectric7.epsilon   &= 4.16

    /// The 6 inner layers, counted from the top: planes, or signal layers. The board says
    /// what each is and names the net of a plane.
    .inner1: InnerLayer
    .inner2: InnerLayer
    .inner3: InnerLayer
    .inner4: InnerLayer
    .inner5: InnerLayer
    .inner6: InnerLayer

    /// The pours on the outer layers, which the board names the nets of.
    .top: Pour
    .bottom: Pour
}

/// ACME's ten-layer board: 1 oz outer copper, 0.5 oz inner copper, 1.6 mm thick. ACME is a
/// fictional fabricator: every number was chosen, not sourced, and a board on this process
/// cannot be ordered (see the file's header). Each of the eight inner layers is a plane or a
/// signal layer, as on `EightLayer`.
///
/// The build-up `ACME-10L-1.6`, from the top: outer copper 0.035 mm, prepreg 3313 0.0994 mm,
/// core 0.2 mm, prepreg 2116 0.1088 mm, core 0.25 mm, prepreg 2116 0.1088 mm, core 0.25 mm,
/// prepreg 2116 0.1088 mm, core 0.2 mm, prepreg 3313 0.0994 mm, outer copper 0.035 mm, with
/// 0.0152 mm of copper on each of the eight inner layers: 1.6168 mm in all.
interface TenLayer {
    /// Who makes it: no one. ACME is fictional, and `fab --order` refuses a board on it.
    .fabricator: String
    .source:     String
    .fabricator &= "ACME"
    .source     &= "std/mfg/acme.nsm: chosen, not sourced; ACME is a fictional fabricator"

    /// The narrowest track.
    .min_track: Length
    .min_track &= 0.09mm..1m
    /// The least space between copper of different nets.
    .min_clearance: Length
    .min_clearance &= 0.1mm..1m
    /// The smallest drilled hole, which is a via's drill.
    .min_drill: Length
    .min_drill &= 0.15mm..1m
    /// The smallest copper disc of a via.
    .min_via_diameter: Length
    .min_via_diameter &= 0.25mm..1m
    /// The least copper left round a plated pad's hole. A via's is `.min_via_ring`.
    .min_annular_ring: Length
    .min_annular_ring &= 0.15mm..1m
    /// The least space between the edges of two holes when one is a pad's, and between two
    /// vias' holes.
    .min_hole_to_hole: Length
    .min_hole_to_hole &= 0.45mm..1m
    .min_via_hole_to_hole: Length
    .min_via_hole_to_hole &= 0.2mm..1m
    /// The least space between copper and a routed board edge.
    .min_edge_clearance: Length
    .min_edge_clearance &= 0.2mm..1m
    /// The least space between a plane and the hole of a via or a through-hole pad that is
    /// not on its net.
    .min_plane_hole_clearance: Length
    .min_plane_hole_clearance &= 0.3mm..1m
    /// The thinnest silkscreen stroke.
    .min_silk_width: Length
    .min_silk_width &= 0.15mm..1m
    /// The smallest silkscreen text.
    .min_text_height: Length
    .min_text_height &= 1mm..1m
    /// The least space between silkscreen and a pad.
    .min_silk_to_pad: Length
    .min_silk_to_pad &= 0.15mm..1m
    /// The least solder mask left between two pads.
    .min_mask_bridge: Length
    .min_mask_bridge &= 0.13mm..1m
    /// The least copper round a via's hole, on each side.
    .min_via_ring: Length
    .min_via_ring &= 0.05mm..1m
    /// The least space from the edge of a via's hole or a non-plated hole to a track of
    /// another net.
    .min_hole_clearance: Length
    .min_hole_clearance &= 0.2mm..1m
    /// The least space from a plated pad's hole to a track of another net.
    .min_plated_hole_clearance: Length
    .min_plated_hole_clearance &= 0.28mm..1m
    /// The least space between surface-mount pads of different nets.
    .min_pad_to_pad: Length
    .min_pad_to_pad &= 0.15mm..1m
    /// The least space between a solder mask opening and a track of another net.
    .min_mask_to_track: Length
    .min_mask_to_track &= 0.09mm..1m
    /// The smallest non-plated hole, the narrowest plated slot and the narrowest non-plated
    /// slot.
    .min_npth_drill: Length
    .min_npth_drill &= 0.5mm..1m
    .min_plated_slot: Length
    .min_plated_slot &= 0.35mm..1m
    .min_npth_slot: Length
    .min_npth_slot &= 1mm..1m
    /// The via the router draws, its hole and its copper: an offer the board may replace
    /// (`.process.via_drill &= 0.3mm`), checked against the rules above.
    .via_drill: Length
    .via_drill ?= 0.2mm
    .via_diameter: Length
    .via_diameter ?= 0.45mm
    /// The largest via the process fills with epoxy and caps with copper, which a via may be
    /// to stand in a pad. An upper bound, unlike the `min_` fields; the board narrows it to
    /// `0mm` where it wants no via in a pad (`.process.via_in_pad &= 0mm`).
    .via_in_pad: Length
    .via_in_pad &= 0mm..0.55mm

    /// How far above the board's temperature a loaded track may heat: the rise the
    /// IPC-2221 track width check (ADR 0036) designs to. Left unstated, as on JLCPCB's
    /// processes; a board that states none is checked at 10 K, this tool's default.
    /// It is an upper bound: `.process.max_temperature_rise &= 20K` allows 20 K.
    .max_temperature_rise: Temperature
    /// How much narrower than drawn a finished track may be, as a fraction.
    .track_width_tolerance: Number
    .track_width_tolerance &= 0.2
    /// The copper plated on the wall of a hole.
    .hole_plating: Length
    .hole_plating &= 0.018mm

    .stackup: Stackup
    .stackup.layers        &= 10
    .stackup.thickness     &= 1.6mm
    .stackup.copper_weight &= 1
    .stackup.build         &= "ACME-10L-1.6"
    .stackup.inner_copper  &= 0.0152mm
    .stackup.dielectric1.kind      &= "prepreg"
    .stackup.dielectric1.glass     &= "3313"
    .stackup.dielectric1.thickness &= 0.0994mm
    .stackup.dielectric1.epsilon   &= 4.1
    .stackup.dielectric2.kind      &= "core"
    .stackup.dielectric2.thickness &= 0.2mm
    .stackup.dielectric2.epsilon   &= 4.6
    .stackup.dielectric3.kind      &= "prepreg"
    .stackup.dielectric3.glass     &= "2116"
    .stackup.dielectric3.thickness &= 0.1088mm
    .stackup.dielectric3.epsilon   &= 4.16
    .stackup.dielectric4.kind      &= "core"
    .stackup.dielectric4.thickness &= 0.25mm
    .stackup.dielectric4.epsilon   &= 4.6
    .stackup.dielectric5.kind      &= "prepreg"
    .stackup.dielectric5.glass     &= "2116"
    .stackup.dielectric5.thickness &= 0.1088mm
    .stackup.dielectric5.epsilon   &= 4.16
    .stackup.dielectric6.kind      &= "core"
    .stackup.dielectric6.thickness &= 0.25mm
    .stackup.dielectric6.epsilon   &= 4.6
    .stackup.dielectric7.kind      &= "prepreg"
    .stackup.dielectric7.glass     &= "2116"
    .stackup.dielectric7.thickness &= 0.1088mm
    .stackup.dielectric7.epsilon   &= 4.16
    .stackup.dielectric8.kind      &= "core"
    .stackup.dielectric8.thickness &= 0.2mm
    .stackup.dielectric8.epsilon   &= 4.6
    .stackup.dielectric9.kind      &= "prepreg"
    .stackup.dielectric9.glass     &= "3313"
    .stackup.dielectric9.thickness &= 0.0994mm
    .stackup.dielectric9.epsilon   &= 4.1

    /// The 8 inner layers, counted from the top: planes, or signal layers. The board says
    /// what each is and names the net of a plane.
    .inner1: InnerLayer
    .inner2: InnerLayer
    .inner3: InnerLayer
    .inner4: InnerLayer
    .inner5: InnerLayer
    .inner6: InnerLayer
    .inner7: InnerLayer
    .inner8: InnerLayer

    /// The pours on the outer layers, which the board names the nets of.
    .top: Pour
    .bottom: Pour
}
