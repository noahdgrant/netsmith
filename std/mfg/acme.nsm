//! ACME, a fictional fabricator, and its 8- and 10-layer processes.
//!
//! ACME does not exist. Its processes are here so that a board that needs eight or ten copper
//! layers (a port of a big board, a showcase) can be designed, routed, checked and written as a
//! fab package before a real fabricator's build-up of that many layers is in std: JLCPCB
//! publishes none (`std::mfg::jlcpcb`, ADR 0111). Every number below was chosen, not sourced,
//! and stands for no real fabricator's capability. A board on an ACME process cannot be
//! ordered: `fab` writes its package and says in `fab-notes.txt` that it is not for ordering,
//! and `project order` refuses it (ADR 0112).
//!
//! The numbers were chosen to be plausible:
//!
//! - the design rules are those of JLCPCB's multilayer rows (`SixLayer`): track 0.09 mm, space
//!   0.1 mm, drill 0.15 mm, via 0.25 mm, annular ring 0.15 mm, plane to hole 0.3 mm, so a board
//!   moved between JLCPCB and ACME keeps its rules;
//! - each build-up is symmetric about its middle, 1.6 mm nominal: 1 oz outer copper (0.035 mm),
//!   0.5 oz inner copper (0.0152 mm, as JLCPCB's), prepregs of the common glass styles with the
//!   thicknesses and permittivities JLCPCB gives for them (3313: 0.0994 mm, 4.1; 2116: 0.1088 mm,
//!   4.16), and cores of common thicknesses (0.2, 0.25, 0.3 and 0.41 mm) at a typical FR-4
//!   permittivity of 4.6.

import std::mfg::stackup::{InnerLayer, Pour, Stackup}

/// ACME's eight-layer board: 1 oz outer copper, 0.5 oz inner copper, 1.6 mm thick. ACME is a
/// fictional fabricator: every number was chosen, not sourced, and a board on this process
/// cannot be ordered (see the file's header). Each of the six inner layers is a plane, whose
/// net the board names (`.process.inner1.net &= "GND"`), or a signal layer
/// (`.process.inner2.use &= "signal"`, ADR 0111), which the router draws tracks on as on the
/// outer layers (issue #833).
///
/// The build-up `ACME-8L-1.6`, from the top: outer copper 0.035 mm, prepreg 2116 0.1088 mm,
/// core 0.3 mm, prepreg 2116 0.1088 mm, core 0.41 mm, prepreg 2116 0.1088 mm, core 0.3 mm,
/// prepreg 2116 0.1088 mm, outer copper 0.035 mm, with 0.0152 mm of copper on each of the six
/// inner layers: 1.6064 mm in all.
interface EightLayer {
    /// Who makes it: no one. ACME is fictional, and `project order` refuses a board on it.
    .fabricator: String
    .source: String
    .fabricator &= "ACME"
    .source &= "std/mfg/acme.nsm: chosen, not sourced; ACME is a fictional fabricator"

    /// The narrowest track.
    .min_track: Length
    .min_track &= 0.09mm..
    /// The least space between copper of different nets.
    .min_clearance: Length
    .min_clearance &= 0.1mm..
    /// The smallest drilled hole, which is a via's drill.
    .min_drill: Length
    .min_drill &= 0.15mm..
    /// The smallest copper disc of a via.
    .min_via_diameter: Length
    .min_via_diameter &= 0.25mm..
    /// The least copper left round a plated pad's hole. A via's is `.min_via_ring`.
    .min_annular_ring: Length
    .min_annular_ring &= 0.15mm..
    /// The least space between the edges of two holes when one is a pad's, and between two
    /// vias' holes.
    .min_hole_to_hole: Length
    .min_hole_to_hole &= 0.45mm..
    .min_via_hole_to_hole: Length
    .min_via_hole_to_hole &= 0.2mm..
    /// The least space between copper and a routed board edge.
    .min_edge_clearance: Length
    .min_edge_clearance &= 0.2mm..
    /// The least space between a plane and the hole of a via or a through-hole pad that is
    /// not on its net.
    .min_plane_hole_clearance: Length
    .min_plane_hole_clearance &= 0.3mm..
    /// The thinnest silkscreen stroke.
    .min_silk_width: Length
    .min_silk_width &= 0.15mm..
    /// The smallest silkscreen text.
    .min_text_height: Length
    .min_text_height &= 1mm..
    /// The least space between silkscreen and a pad.
    .min_silk_to_pad: Length
    .min_silk_to_pad &= 0.15mm..
    /// The least space between two pieces of silkscreen, which KiCad's check holds silkscreen
    /// to the board edge to as well.
    .min_silk_to_silk: Length
    .min_silk_to_silk &= 0.15mm..
    /// The least solder mask left between two pads.
    .min_mask_bridge: Length
    .min_mask_bridge &= 0.13mm..
    /// What the process asks of fiducials and test points (issue #761), the figures of
    /// `std::mfg::jlcpcb` so that a board moved between the two keeps its rules: chosen, not
    /// sourced, like every number of ACME. The fiducial edge space is a limit, the rest are
    /// guidelines, as there.
    .min_fiducials: Number
    .min_fiducials &= 2..
    .fiducial_diameter: Length
    .fiducial_diameter ?= 1mm
    .fiducial_mask_ratio: Number
    .fiducial_mask_ratio &= 2..
    .min_fiducial_edge: Length
    .min_fiducial_edge &= 3.35mm..
    .min_test_point_pad: Length
    .min_test_point_pad &= 0.8mm..
    .min_test_point_pitch: Length
    .min_test_point_pitch &= 1.27mm..
    .min_test_point_body: Length
    .min_test_point_body &= 0.5mm..
    .min_test_point_edge: Length
    .min_test_point_edge &= 3.2mm..
    .min_power_test_point_pad: Length
    .min_power_test_point_pad &= 1mm..
    .tall_part_height: Length
    .tall_part_height ?= 6.4mm
    .min_test_point_tall_body: Length
    .min_test_point_tall_body &= 2mm..
    .fiducial_round_angle: Number
    .fiducial_round_angle ?= 90
    .fine_pitch: Length
    .fine_pitch ?= 0.4mm
    /// How far from a rule area that forbids copper or parts (a module's antenna keep-out, a
    /// footprint's keep-out zone, an RF keep-out of the board) the design rules check notes the
    /// parts, tracks, vias and pours of the board near it: under it on a layer it is not on, and
    /// beside it (`near_rule_area`, issue #1591). A note, which fails nothing: copper and parts
    /// near an antenna can detune it, and the person decides. Not a fabricator's figure: 3 mm is
    /// a default of this tool's, a few track pitches round the area; a board offers another
    /// (`.process.rule_area_reach &= 5mm`), and `0mm` lists only what is under or inside it.
    .rule_area_reach: Length
    .rule_area_reach ?= 3mm
    /// The least copper round a via's hole, on each side.
    .min_via_ring: Length
    .min_via_ring &= 0.05mm..
    /// The least space from the edge of a via's hole or a non-plated hole to a track of
    /// another net.
    .min_hole_clearance: Length
    .min_hole_clearance &= 0.2mm..
    /// The least space from a plated pad's hole to a track of another net.
    .min_plated_hole_clearance: Length
    .min_plated_hole_clearance &= 0.28mm..
    /// The least space between surface-mount pads of different nets.
    .min_pad_to_pad: Length
    .min_pad_to_pad &= 0.15mm..
    /// The least space between a solder mask opening and a track of another net.
    .min_mask_to_track: Length
    .min_mask_to_track &= 0.09mm..
    /// The smallest non-plated hole, the narrowest plated slot and the narrowest non-plated
    /// slot.
    .min_npth_drill: Length
    .min_npth_drill &= 0.5mm..
    .min_plated_slot: Length
    .min_plated_slot &= 0.35mm..
    .min_npth_slot: Length
    .min_npth_slot &= 1mm..
    /// The via the router draws, its hole and its copper: an offer the board may replace
    /// (`.process.via_drill &= 0.3mm`), checked against the rules above.
    .via_drill: Length
    .via_drill ?= 0.2mm
    .via_diameter: Length
    .via_diameter ?= 0.45mm
    /// The largest via the process fills with epoxy and caps with copper, which a via may be
    /// to stand in a pad. An upper bound, unlike the `min_` fields; the board narrows it to
    /// `0mm` where it wants no via in a pad (`.process.via_in_pad &= 0mm`).
    .via_in_pad: Length
    .via_in_pad &= 0mm..0.55mm

    /// How far above the board's temperature a loaded track may heat: the rise the
    /// IPC-2221 track width check (ADR 0036) designs to. Left unstated, as on JLCPCB's
    /// processes; a board that states none is checked at 10 K, this tool's default.
    /// It is an upper bound: `.process.max_temperature_rise &= 20K` allows 20 K.
    .max_temperature_rise: Temperature
    /// The least angle, in degrees, between a track's centre line and the tangent of a round
    /// copper edge at the point where the track leaves it, for netsmith's `acid_trap` rule: a
    /// track that leaves a round pad, a via, an oval's end, a rounded corner or a custom pad's
    /// circle or arc at less than this traps etchant in the wedge beside it (a warning). A
    /// track that leaves along the radius is at 90. There is no JLCPCB figure, as for the
    /// straight edges (which are judged against any acute angle): the process leaves it
    /// unstated, and a board that wants round copper judged states one
    /// (`.process.min_round_track_angle &= 60`). It is a lower bound: `&= 60..` allows 60
    /// and over. Unstated, round copper is not judged.
    .min_round_track_angle: Number
    /// The most space between the copper of two vias of one net, edge to edge, at which they
    /// still stand side by side as one group (issue #1505): the group `via_current` counts,
    /// the via pairs of the quality report and the groups the router lays. Not a number the
    /// fabricator publishes: unstated, it is the process's `.min_clearance`, so a row laid at
    /// the least clearance is one group. A board states another as an upper bound
    /// (`.process.via_group_gap &= 0.15mm`); `0mm` asks that the copper touch.
    .via_group_gap: Length
    /// How near copper of another net may come to a switching regulator's switch node (its
    /// pads and tracks), edge to edge, before `board drc` notes it (`switch_node_copper`, issue
    /// #1585): a via or a track of a signal beside the node picks up its edges. Not a number the
    /// fabricator publishes: unstated, it is 1 mm. A board states another
    /// (`.process.switch_node_keepout &= 2mm`). A note, which fails no check.
    .switch_node_keepout: Length
    /// How near a via's hole may come to a pad's copper (a pad of any net, on any layer the via
    /// is on), edge to edge, before `board drc` notes it (`via_hole_near_pad`, issue #1579): a
    /// hole on or near a pad's edge can open in the pad's mask opening and draw solder down it.
    /// Not a number the fabricator publishes: unstated, it is 0.1 mm. A board states another
    /// (`.process.via_hole_pad_reach &= 0.2mm`). A note, which fails no check.
    .via_hole_pad_reach: Length
    /// How near a via's ring may come to a pad's copper before `board drc` notes it
    /// (`via_ring_near_pad`, issue #1579). Not a number the fabricator publishes: unstated, it
    /// is 0 mm, a ring that reaches into a pad's copper. A note, which fails no check.
    .via_ring_pad_reach: Length
    /// The least side of a single board that the assembly house places parts on one face
    /// of, and on both (`.min_single_sided_assembly_size`, issue 1285), for the
    /// `assembly_size` rule. The fictional house publishes no figure and leaves both
    /// unstated, so the size of a board is not judged; a board that wants it judged states
    /// one (`.process.min_double_sided_assembly_size &= 70mm..`).
    .min_single_sided_assembly_size: Length
    .min_double_sided_assembly_size: Length
    /// Where those figures come from, which the `assembly_size` finding quotes (issue 1393).
    /// Unstated with them; a board that states a figure states its source too
    /// (`.process.assembly_size_source &= "..."`).
    .assembly_size_source: String
    /// The least space between copper and a V-cut edge (`.min_v_cut_edge_clearance`, issue
    /// 1592), for the `v_cut_edge` rule of a board under the assembly size. The fictional house
    /// publishes no figure, so a board that states an assembly size has the space from its
    /// outline to its copper said in the notes and not judged; a board states one (`.process.min_v_cut_edge_clearance &= 0.4mm..`)
    /// with its source (`.process.v_cut_edge_clearance_source &= "..."`).
    .min_v_cut_edge_clearance: Length
    .v_cut_edge_clearance_source: String
    /// How much narrower than drawn a finished track may be, as a fraction.
    .track_width_tolerance: Number
    .track_width_tolerance &= 0.2
    /// The copper plated on the wall of a hole.
    .hole_plating: Length
    .hole_plating &= 0.018mm

    /// The surface finish the board is made with: chosen, not sourced, like the rest of ACME: the offer and the default of
    /// JLCPCB's `SixLayer`. A board chooses another of
    /// `.finishes` with `.process.finish &= "ENIG"`; `fab` writes it to the board file and
    /// the order summary, and the board house's order form has to match it (issue #842).
    .finish: String
    .finish ?= "ENIG"
    /// The finishes the process offers, separated by commas. The board's `.finish` is one of
    /// them.
    .finishes: String
    .finishes &= "ENIG, OSP"

    .stackup: Stackup
    .stackup.layers &= 8
    .stackup.thickness &= 1.6mm
    .stackup.copper_weight &= 1
    .stackup.build &= "ACME-8L-1.6"
    .stackup.inner_copper &= 0.0152mm
    .stackup.dielectric1.kind &= "prepreg"
    .stackup.dielectric1.glass &= "2116"
    .stackup.dielectric1.thickness &= 0.1088mm
    .stackup.dielectric1.epsilon &= 4.16
    .stackup.dielectric2.kind &= "core"
    .stackup.dielectric2.thickness &= 0.3mm
    .stackup.dielectric2.epsilon &= 4.6
    .stackup.dielectric3.kind &= "prepreg"
    .stackup.dielectric3.glass &= "2116"
    .stackup.dielectric3.thickness &= 0.1088mm
    .stackup.dielectric3.epsilon &= 4.16
    .stackup.dielectric4.kind &= "core"
    .stackup.dielectric4.thickness &= 0.41mm
    .stackup.dielectric4.epsilon &= 4.6
    .stackup.dielectric5.kind &= "prepreg"
    .stackup.dielectric5.glass &= "2116"
    .stackup.dielectric5.thickness &= 0.1088mm
    .stackup.dielectric5.epsilon &= 4.16
    .stackup.dielectric6.kind &= "core"
    .stackup.dielectric6.thickness &= 0.3mm
    .stackup.dielectric6.epsilon &= 4.6
    .stackup.dielectric7.kind &= "prepreg"
    .stackup.dielectric7.glass &= "2116"
    .stackup.dielectric7.thickness &= 0.1088mm
    .stackup.dielectric7.epsilon &= 4.16

    /// The 6 inner layers, counted from the top: planes, or signal layers. The board says
    /// what each is and names the net of a plane.
    .inner1: InnerLayer
    .inner2: InnerLayer
    .inner3: InnerLayer
    .inner4: InnerLayer
    .inner5: InnerLayer
    .inner6: InnerLayer

    /// The pours on the outer layers, which the board names the nets of.
    .top: Pour
    .bottom: Pour
}

/// ACME's ten-layer board: 1 oz outer copper, 0.5 oz inner copper, 1.6 mm thick. ACME is a
/// fictional fabricator: every number was chosen, not sourced, and a board on this process
/// cannot be ordered (see the file's header). Each of the eight inner layers is a plane or a
/// signal layer, as on `EightLayer`.
///
/// The build-up `ACME-10L-1.6`, from the top: outer copper 0.035 mm, prepreg 3313 0.0994 mm,
/// core 0.2 mm, prepreg 2116 0.1088 mm, core 0.25 mm, prepreg 2116 0.1088 mm, core 0.25 mm,
/// prepreg 2116 0.1088 mm, core 0.2 mm, prepreg 3313 0.0994 mm, outer copper 0.035 mm, with
/// 0.0152 mm of copper on each of the eight inner layers: 1.6168 mm in all.
interface TenLayer {
    /// Who makes it: no one. ACME is fictional, and `project order` refuses a board on it.
    .fabricator: String
    .source: String
    .fabricator &= "ACME"
    .source &= "std/mfg/acme.nsm: chosen, not sourced; ACME is a fictional fabricator"

    /// The narrowest track.
    .min_track: Length
    .min_track &= 0.09mm..
    /// The least space between copper of different nets.
    .min_clearance: Length
    .min_clearance &= 0.1mm..
    /// The smallest drilled hole, which is a via's drill.
    .min_drill: Length
    .min_drill &= 0.15mm..
    /// The smallest copper disc of a via.
    .min_via_diameter: Length
    .min_via_diameter &= 0.25mm..
    /// The least copper left round a plated pad's hole. A via's is `.min_via_ring`.
    .min_annular_ring: Length
    .min_annular_ring &= 0.15mm..
    /// The least space between the edges of two holes when one is a pad's, and between two
    /// vias' holes.
    .min_hole_to_hole: Length
    .min_hole_to_hole &= 0.45mm..
    .min_via_hole_to_hole: Length
    .min_via_hole_to_hole &= 0.2mm..
    /// The least space between copper and a routed board edge.
    .min_edge_clearance: Length
    .min_edge_clearance &= 0.2mm..
    /// The least space between a plane and the hole of a via or a through-hole pad that is
    /// not on its net.
    .min_plane_hole_clearance: Length
    .min_plane_hole_clearance &= 0.3mm..
    /// The thinnest silkscreen stroke.
    .min_silk_width: Length
    .min_silk_width &= 0.15mm..
    /// The smallest silkscreen text.
    .min_text_height: Length
    .min_text_height &= 1mm..
    /// The least space between silkscreen and a pad.
    .min_silk_to_pad: Length
    .min_silk_to_pad &= 0.15mm..
    /// The least space between two pieces of silkscreen, which KiCad's check holds silkscreen
    /// to the board edge to as well.
    .min_silk_to_silk: Length
    .min_silk_to_silk &= 0.15mm..
    /// The least solder mask left between two pads.
    .min_mask_bridge: Length
    .min_mask_bridge &= 0.13mm..
    /// What the process asks of fiducials and test points (issue #761), the figures of
    /// `std::mfg::jlcpcb` so that a board moved between the two keeps its rules: chosen, not
    /// sourced, like every number of ACME. The fiducial edge space is a limit, the rest are
    /// guidelines, as there.
    .min_fiducials: Number
    .min_fiducials &= 2..
    .fiducial_diameter: Length
    .fiducial_diameter ?= 1mm
    .fiducial_mask_ratio: Number
    .fiducial_mask_ratio &= 2..
    .min_fiducial_edge: Length
    .min_fiducial_edge &= 3.35mm..
    .min_test_point_pad: Length
    .min_test_point_pad &= 0.8mm..
    .min_test_point_pitch: Length
    .min_test_point_pitch &= 1.27mm..
    .min_test_point_body: Length
    .min_test_point_body &= 0.5mm..
    .min_test_point_edge: Length
    .min_test_point_edge &= 3.2mm..
    .min_power_test_point_pad: Length
    .min_power_test_point_pad &= 1mm..
    .tall_part_height: Length
    .tall_part_height ?= 6.4mm
    .min_test_point_tall_body: Length
    .min_test_point_tall_body &= 2mm..
    .fiducial_round_angle: Number
    .fiducial_round_angle ?= 90
    .fine_pitch: Length
    .fine_pitch ?= 0.4mm
    /// How far from a rule area that forbids copper or parts (a module's antenna keep-out, a
    /// footprint's keep-out zone, an RF keep-out of the board) the design rules check notes the
    /// parts, tracks, vias and pours of the board near it: under it on a layer it is not on, and
    /// beside it (`near_rule_area`, issue #1591). A note, which fails nothing: copper and parts
    /// near an antenna can detune it, and the person decides. Not a fabricator's figure: 3 mm is
    /// a default of this tool's, a few track pitches round the area; a board offers another
    /// (`.process.rule_area_reach &= 5mm`), and `0mm` lists only what is under or inside it.
    .rule_area_reach: Length
    .rule_area_reach ?= 3mm
    /// The least copper round a via's hole, on each side.
    .min_via_ring: Length
    .min_via_ring &= 0.05mm..
    /// The least space from the edge of a via's hole or a non-plated hole to a track of
    /// another net.
    .min_hole_clearance: Length
    .min_hole_clearance &= 0.2mm..
    /// The least space from a plated pad's hole to a track of another net.
    .min_plated_hole_clearance: Length
    .min_plated_hole_clearance &= 0.28mm..
    /// The least space between surface-mount pads of different nets.
    .min_pad_to_pad: Length
    .min_pad_to_pad &= 0.15mm..
    /// The least space between a solder mask opening and a track of another net.
    .min_mask_to_track: Length
    .min_mask_to_track &= 0.09mm..
    /// The smallest non-plated hole, the narrowest plated slot and the narrowest non-plated
    /// slot.
    .min_npth_drill: Length
    .min_npth_drill &= 0.5mm..
    .min_plated_slot: Length
    .min_plated_slot &= 0.35mm..
    .min_npth_slot: Length
    .min_npth_slot &= 1mm..
    /// The via the router draws, its hole and its copper: an offer the board may replace
    /// (`.process.via_drill &= 0.3mm`), checked against the rules above.
    .via_drill: Length
    .via_drill ?= 0.2mm
    .via_diameter: Length
    .via_diameter ?= 0.45mm
    /// The largest via the process fills with epoxy and caps with copper, which a via may be
    /// to stand in a pad. An upper bound, unlike the `min_` fields; the board narrows it to
    /// `0mm` where it wants no via in a pad (`.process.via_in_pad &= 0mm`).
    .via_in_pad: Length
    .via_in_pad &= 0mm..0.55mm

    /// How far above the board's temperature a loaded track may heat: the rise the
    /// IPC-2221 track width check (ADR 0036) designs to. Left unstated, as on JLCPCB's
    /// processes; a board that states none is checked at 10 K, this tool's default.
    /// It is an upper bound: `.process.max_temperature_rise &= 20K` allows 20 K.
    .max_temperature_rise: Temperature
    /// The least angle, in degrees, between a track's centre line and the tangent of a round
    /// copper edge at the point where the track leaves it, for netsmith's `acid_trap` rule: a
    /// track that leaves a round pad, a via, an oval's end, a rounded corner or a custom pad's
    /// circle or arc at less than this traps etchant in the wedge beside it (a warning). A
    /// track that leaves along the radius is at 90. There is no JLCPCB figure, as for the
    /// straight edges (which are judged against any acute angle): the process leaves it
    /// unstated, and a board that wants round copper judged states one
    /// (`.process.min_round_track_angle &= 60`). It is a lower bound: `&= 60..` allows 60
    /// and over. Unstated, round copper is not judged.
    .min_round_track_angle: Number
    /// The most space between the copper of two vias of one net, edge to edge, at which they
    /// still stand side by side as one group (issue #1505): the group `via_current` counts,
    /// the via pairs of the quality report and the groups the router lays. Not a number the
    /// fabricator publishes: unstated, it is the process's `.min_clearance`, so a row laid at
    /// the least clearance is one group. A board states another as an upper bound
    /// (`.process.via_group_gap &= 0.15mm`); `0mm` asks that the copper touch.
    .via_group_gap: Length
    /// How near copper of another net may come to a switching regulator's switch node (its
    /// pads and tracks), edge to edge, before `board drc` notes it (`switch_node_copper`, issue
    /// #1585): a via or a track of a signal beside the node picks up its edges. Not a number the
    /// fabricator publishes: unstated, it is 1 mm. A board states another
    /// (`.process.switch_node_keepout &= 2mm`). A note, which fails no check.
    .switch_node_keepout: Length
    /// How near a via's hole may come to a pad's copper (a pad of any net, on any layer the via
    /// is on), edge to edge, before `board drc` notes it (`via_hole_near_pad`, issue #1579): a
    /// hole on or near a pad's edge can open in the pad's mask opening and draw solder down it.
    /// Not a number the fabricator publishes: unstated, it is 0.1 mm. A board states another
    /// (`.process.via_hole_pad_reach &= 0.2mm`). A note, which fails no check.
    .via_hole_pad_reach: Length
    /// How near a via's ring may come to a pad's copper before `board drc` notes it
    /// (`via_ring_near_pad`, issue #1579). Not a number the fabricator publishes: unstated, it
    /// is 0 mm, a ring that reaches into a pad's copper. A note, which fails no check.
    .via_ring_pad_reach: Length
    /// The least side of a single board that the assembly house places parts on one face
    /// of, and on both (`.min_single_sided_assembly_size`, issue 1285), for the
    /// `assembly_size` rule. The fictional house publishes no figure and leaves both
    /// unstated, so the size of a board is not judged; a board that wants it judged states
    /// one (`.process.min_double_sided_assembly_size &= 70mm..`).
    .min_single_sided_assembly_size: Length
    .min_double_sided_assembly_size: Length
    /// Where those figures come from, which the `assembly_size` finding quotes (issue 1393).
    /// Unstated with them; a board that states a figure states its source too
    /// (`.process.assembly_size_source &= "..."`).
    .assembly_size_source: String
    /// The least space between copper and a V-cut edge (`.min_v_cut_edge_clearance`, issue
    /// 1592), for the `v_cut_edge` rule of a board under the assembly size. The fictional house
    /// publishes no figure, so a board that states an assembly size has the space from its
    /// outline to its copper said in the notes and not judged; a board states one (`.process.min_v_cut_edge_clearance &= 0.4mm..`)
    /// with its source (`.process.v_cut_edge_clearance_source &= "..."`).
    .min_v_cut_edge_clearance: Length
    .v_cut_edge_clearance_source: String
    /// How much narrower than drawn a finished track may be, as a fraction.
    .track_width_tolerance: Number
    .track_width_tolerance &= 0.2
    /// The copper plated on the wall of a hole.
    .hole_plating: Length
    .hole_plating &= 0.018mm

    /// The surface finish the board is made with: chosen, not sourced, like the rest of ACME: the offer and the default of
    /// JLCPCB's `SixLayer`. A board chooses another of
    /// `.finishes` with `.process.finish &= "ENIG"`; `fab` writes it to the board file and
    /// the order summary, and the board house's order form has to match it (issue #842).
    .finish: String
    .finish ?= "ENIG"
    /// The finishes the process offers, separated by commas. The board's `.finish` is one of
    /// them.
    .finishes: String
    .finishes &= "ENIG, OSP"

    .stackup: Stackup
    .stackup.layers &= 10
    .stackup.thickness &= 1.6mm
    .stackup.copper_weight &= 1
    .stackup.build &= "ACME-10L-1.6"
    .stackup.inner_copper &= 0.0152mm
    .stackup.dielectric1.kind &= "prepreg"
    .stackup.dielectric1.glass &= "3313"
    .stackup.dielectric1.thickness &= 0.0994mm
    .stackup.dielectric1.epsilon &= 4.1
    .stackup.dielectric2.kind &= "core"
    .stackup.dielectric2.thickness &= 0.2mm
    .stackup.dielectric2.epsilon &= 4.6
    .stackup.dielectric3.kind &= "prepreg"
    .stackup.dielectric3.glass &= "2116"
    .stackup.dielectric3.thickness &= 0.1088mm
    .stackup.dielectric3.epsilon &= 4.16
    .stackup.dielectric4.kind &= "core"
    .stackup.dielectric4.thickness &= 0.25mm
    .stackup.dielectric4.epsilon &= 4.6
    .stackup.dielectric5.kind &= "prepreg"
    .stackup.dielectric5.glass &= "2116"
    .stackup.dielectric5.thickness &= 0.1088mm
    .stackup.dielectric5.epsilon &= 4.16
    .stackup.dielectric6.kind &= "core"
    .stackup.dielectric6.thickness &= 0.25mm
    .stackup.dielectric6.epsilon &= 4.6
    .stackup.dielectric7.kind &= "prepreg"
    .stackup.dielectric7.glass &= "2116"
    .stackup.dielectric7.thickness &= 0.1088mm
    .stackup.dielectric7.epsilon &= 4.16
    .stackup.dielectric8.kind &= "core"
    .stackup.dielectric8.thickness &= 0.2mm
    .stackup.dielectric8.epsilon &= 4.6
    .stackup.dielectric9.kind &= "prepreg"
    .stackup.dielectric9.glass &= "3313"
    .stackup.dielectric9.thickness &= 0.0994mm
    .stackup.dielectric9.epsilon &= 4.1

    /// The 8 inner layers, counted from the top: planes, or signal layers. The board says
    /// what each is and names the net of a plane.
    .inner1: InnerLayer
    .inner2: InnerLayer
    .inner3: InnerLayer
    .inner4: InnerLayer
    .inner5: InnerLayer
    .inner6: InnerLayer
    .inner7: InnerLayer
    .inner8: InnerLayer

    /// The pours on the outer layers, which the board names the nets of.
    .top: Pour
    .bottom: Pour
}
