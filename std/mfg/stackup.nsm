//! The layers a board is built from.

/// What a board is built from: how many copper layers, how thick the finished board is, and
/// how heavy the copper is. A manufacturer's process fixes some of these and leaves the
/// rest for the board to choose.
interface Stackup {
    /// Copper layers.
    .layers: Number
    /// The finished board, copper and mask included.
    .thickness: Length
    /// Finished outer copper, in ounces per square foot.
    .copper_weight: Number

    // How a board of more than two layers is built up. A two-layer process leaves these
    // unstated: its one core is what the thickness leaves after the copper. A process with
    // inner layers states every one (ADR 0111).

    /// The name the fabricator gives the build-up, such as `JLC04161H-7628`.
    .build: String
    /// The copper of an inner layer.
    .inner_copper: Length
    /// The dielectric layers between the copper layers, from the top: `.dielectric1` is
    /// between the top copper and the first inner layer, and a board of n layers has n - 1.
    /// Nine are declared, for up to ten layers; a process states those it has.
    .dielectric1: DielectricLayer
    .dielectric2: DielectricLayer
    .dielectric3: DielectricLayer
    .dielectric4: DielectricLayer
    .dielectric5: DielectricLayer
    .dielectric6: DielectricLayer
    .dielectric7: DielectricLayer
    .dielectric8: DielectricLayer
    .dielectric9: DielectricLayer
}

/// One dielectric layer of a build-up: a prepreg or a core, as the fabricator's build-up
/// table gives it.
interface DielectricLayer {
    /// `"prepreg"` or `"core"`.
    .kind: String
    /// The glass style of a prepreg as the table names it (`"7628"`, `"3313"`, `"2116"`); a
    /// core states none.
    .glass: String
    .thickness: Length
    /// The relative permittivity.
    .epsilon: Number
}

/// An inner copper layer: a plane or a signal layer (ADR 0111). A process with inner layers
/// has one for each (`.inner1`, `.inner2`..., counted from the top), and the board says what
/// each is, because only a board names nets (ADR 0005).
///
/// A plane is one sheet of copper on a net, a power or ground plane: the board names the net
/// (`.process.inner1.net &= "GND"`). A signal layer has no net; the board says it is one
/// (`.process.inner2.use &= "signal"`), and it is written as a signal layer and plotted and
/// checked like the outer layers. The router draws on the outer layers only, so a signal
/// layer has no copper yet.
interface InnerLayer {
    /// `"plane"`, the default, or `"signal"`.
    .use: String
    .use ?= "plane"
    /// The net of a plane.
    .net: String
}

/// A copper pour on an outer layer: copper filled round the tracks and joined to its net,
/// the member `.top` or `.bottom` of a process. Unlike a plane (an `InnerLayer`) it leaves
/// room for the tracks and for copper of other nets, and it is optional: an outer layer whose
/// pour has no net has no pour. The board names the net (`.process.top.net &= "GND"`), because only
/// a board names nets (ADR 0005). Where two layers carry the same net, vias stitch them.
///
/// Why a member of the process beside the planes (the owner's decision, 2026-11-02): the net
/// of each inner layer is already stated there (ADR 0012), so the outer layers are said in the
/// same place, as `.top` and `.bottom`. Rejected: a board member that names its layer
/// (`.layer &= "top"`: two places would say what is on a layer, the layer would be a string
/// checked only by hand, and two pours on one layer would have to be refused by hand) and a
/// plane that may be poured (one type with two meanings, a whole layer with nothing routed
/// and a fill round the routing, so the router would have to ask which). An inner plane with
/// no net is an error, because a board has to do something with it (or say it is a signal
/// layer, ADR 0111); an outer pour with no net is no pour. Thermal relief is KiCad's default,
/// as for the planes; `.thermal_gap` and `.spoke_width` would follow the range convention if a
/// design needs them.
interface Pour {
    /// The net the layer is poured on.
    .net: String
    /// The most space between the stitching vias that join the pour to the other layers of
    /// its net, in mm. The tool uses the top of the range: `.stitch_pitch &= 0mm..8mm`
    /// puts a via at least every 8 mm. Unset means the pads' own vias only.
    .stitch_pitch: Length
}
