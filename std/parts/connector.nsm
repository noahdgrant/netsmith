/// A coaxial (RF) connector: a centre conductor and a shield. `.impedance` is the connector's
/// characteristic impedance and `.max_frequency` the highest frequency it is specified for;
/// a design states them where it needs them. The shield is a single pin, however many pads
/// the footprint gives it.
part Coax provides Connector {
    pins {
        .signal passive "SIGNAL" "1"
        .shield passive "SHIELD" "2"
    }

    .impedance: Resistance
    .max_frequency: Frequency

    .package: Package
}

/// A USB Type-C receptacle that carries power only: the bus power, the two configuration
/// channel pins and the shell. `.vbus` is the supply the receptacle gives, with `pos` on
/// VBUS and `neg` on GND; its `current` is negative and follows from the loads on the net
/// (ADR 0007). It is the six-contact power-only receptacle: VBUS on A9 and B9, GND on A12 and
/// B12, CC1 on A5, CC2 on B5, and the shell on S1. Such a receptacle joins A4 to B9 and B4 to
/// A9, and A1 to B12 and B1 to A12, inside, and brings out one of each pair; KiCad's
/// power-only symbol and its six-contact footprints have exactly these pads (ADR 0021). A device that takes 5 V from a source puts a resistor on each CC pin to ground, the
/// specification's pull-down (`Resistor` in a chain: `.cc1 ~> .rd ~> .vbus.neg`). The DC analysis
/// takes `.vbus` as a source: its net is held over the range the design states for `.voltage`.
part UsbCPower provides Connector {
    .vbus: Rail
    dc source .vbus

    pins {
        .vbus.pos power   "VBUS"  "A9" "B9"
        .vbus.neg power   "GND"   "A12" "B12"
        .cc1      passive "CC1"   "A5"
        .cc2      passive "CC2"   "B5"
        .shell    passive "SHELL" "S1"
    }

    .package: Package
}

/// A USB Type-C receptacle for USB 2.0, with the sixteen contacts of the full USB 2.0
/// receptacle: VBUS on A4, B4, A9 and B9, GND on A1, B1, A12 and B12, CC1 on A5, CC2 on B5, and
/// the shell on S1, as in the Type-C specification and KiCad's footprints. `.usb` is the
/// `Usb2` port, with D+ on A6 and B6, D- on A7 and B7. The two rows of the receptacle are one
/// pin each, because the plug connects only one of them. It is not an end of the bus: `.usb`
/// states `UsbRole::Passthrough`, so the host or the device that its pins reach is judged, and
/// the receptacle is never asked for a role. The high-speed pairs are not brought
/// out; the sideband pins `.sbu1` (A8) and `.sbu2` (B8) are, because the footprint has the
/// pads, and are left open. The shell is a pin (`.shell`).
part UsbC2 provides Connector {
    .usb: Usb2
    .usb.role &= UsbRole::Passthrough

    pins {
        .usb.vbus.pos power         "VBUS"  "A4" "B4" "A9" "B9"
        .usb.vbus.neg power         "GND"   "A1" "B1" "A12" "B12"
        .usb.dp       bidirectional "D+"    "A6" "B6"
        .usb.dm       bidirectional "D-"    "A7" "B7"
        .cc1          passive       "CC1"   "A5"
        .cc2          passive       "CC2"   "B5"
        .sbu1         passive       "SBU1"  "A8"
        .sbu2         passive       "SBU2"  "B8"
        .shell        passive       "SHELL" "S1"
    }

    .package: Package
}

/// The receptacle of a device that takes power from a USB Type-C host: what `UsbCSink` relies on,
/// and no more. It is a generic (ADR 0068), so the receptacle is a part that provides it:
/// `UsbCReceptacle16P` is the standard one, and a project adds the receptacle of its own maker
/// as a part that says `provides UsbCSinkReceptacle`, with its own pads, footprint and catalog.
/// It has sixteen contacts for USB 2.0, as `UsbC2` has them, with `.vbus` the supply the host
/// gives (`pos` on VBUS, `neg` on GND), taken by the DC analysis as a source over the range the
/// design states for `.voltage`, as `UsbCPower` does. `.cc1` and `.cc2` are the configuration
/// channel contacts, `.dp` and `.dm` the data pair, `.sbu1` and `.sbu2` the sideband contacts,
/// left open, and `.shell` the shield. It carries no resistors: `UsbCSink` adds the Rd that tells
/// the host the device wants power, and is what a board uses. `.mpn` is the maker's number, which
/// a project's receptacle lists as a column of its catalog. A port that gives power is a
/// `UsbCSourceReceptacle`, one that does both a `UsbCDualRoleReceptacle`, and a receptacle that
/// is neither is a `Connector` with a plain `Rail`.
generic UsbCSinkReceptacle {
    .designator &= "J"
    .vbus: Rail
    dc source .vbus

    pins {
        .vbus.pos power
        .vbus.neg power
        .dp       bidirectional
        .dm       bidirectional
        .cc1      passive
        .cc2      passive
        .sbu1     passive
        .sbu2     passive
        .shell    passive
    }

    .package: Package
    .mpn: String
}

/// The receptacle of a port that gives power to a USB Type-C device: a charger, or a host's
/// downstream port, whose VBUS the board drives (#463). It has the sixteen contacts of
/// `UsbCSinkReceptacle`, and `.vbus` goes the other way: it is not a source (no `dc`
/// statement), it is what the device on the cable draws from the board through `pos`, so
/// `.vbus.current >= 0A`. The board states the most the port allows (`.vbus.current &=
/// 0A..3A`), and its own converter or switch drives the rail. The CC contacts take the
/// source's Rp, or a port controller; the generic carries no resistors. Use `Connector` with a
/// plain `Rail` in place of it for a receptacle that is neither a sink nor a source port, such
/// as one that only carries data. No std part provides it: a project's receptacle does
/// (`part X provides UsbCSourceReceptacle, Connector`), since `UsbCReceptacle16P` provides the
/// sink generic, whose `dc source` a provider would take too. `.mpn` is the maker's number.
generic UsbCSourceReceptacle {
    .designator &= "J"
    .vbus: Rail
    .vbus.current >= 0A

    pins {
        .vbus.pos power
        .vbus.neg power
        .dp       bidirectional
        .dm       bidirectional
        .cc1      passive
        .cc2      passive
        .sbu1     passive
        .sbu2     passive
        .shell    passive
    }

    .package: Package
    .mpn: String
}

/// The receptacle of a dual-role USB Type-C port, which takes power from the cable or gives it,
/// as the two ends agree (#463). It has the sixteen contacts of `UsbCSinkReceptacle`, and no
/// `dc` statement: `.vbus.current` has no sign of its own, and the board states a signed
/// range for it, negative while the port supplies the board and positive while it powers the
/// device on the cable (`.vbus.current &= -3A..1.5A`). A port that only takes power is a
/// `UsbCSinkReceptacle`, and one that only gives it a `UsbCSourceReceptacle`. No std part
/// provides it: a project's receptacle does, as for `UsbCSourceReceptacle`. `.mpn` is the
/// maker's number.
generic UsbCDualRoleReceptacle {
    .designator &= "J"
    .vbus: Rail

    pins {
        .vbus.pos power
        .vbus.neg power
        .dp       bidirectional
        .dm       bidirectional
        .cc1      passive
        .cc2      passive
        .sbu1     passive
        .sbu2     passive
        .shell    passive
    }

    .package: Package
    .mpn: String
}

/// The standard receptacle of `UsbCSink`: sixteen contacts for USB 2.0 in the footprint of the
/// GCT USB4105 (`"GCT_USB4105_16P"`, the default) or of the HRO TYPE-C-31-M-12
/// (`"HRO_TYPE-C-31-M-12"`), the same pads in both as in `UsbC2`. A project's own receptacle is
/// a part of its own that provides `UsbCSinkReceptacle`.
part UsbCReceptacle16P provides UsbCSinkReceptacle, Connector {
    pins "GCT_USB4105_16P" {
        .vbus.pos power         "VBUS"  "A4" "B4" "A9" "B9"
        .vbus.neg power         "GND"   "A1" "B1" "A12" "B12"
        .dp       bidirectional "D+"    "A6" "B6"
        .dm       bidirectional "D-"    "A7" "B7"
        .cc1      passive       "CC1"   "A5"
        .cc2      passive       "CC2"   "B5"
        .sbu1     passive       "SBU1"  "A8"
        .sbu2     passive       "SBU2"  "B8"
        .shell    passive       "SHELL" "S1"
    }
    pins "HRO_TYPE-C-31-M-12" {
        .vbus.pos power         "VBUS"  "A4" "B4" "A9" "B9"
        .vbus.neg power         "GND"   "A1" "B1" "A12" "B12"
        .dp       bidirectional "D+"    "A6" "B6"
        .dm       bidirectional "D-"    "A7" "B7"
        .cc1      passive       "CC1"   "A5"
        .cc2      passive       "CC2"   "B5"
        .sbu1     passive       "SBU1"  "A8"
        .sbu2     passive       "SBU2"  "B8"
        .shell    passive       "SHELL" "S1"
    }
}

/// A USB Type-C receptacle for a device that takes its power from a host (a sink), with the
/// device's side of the Type-C specification built in: one 5.1 kohm pull-down (Rd) from each of
/// CC1 and CC2 to ground, which tells the host to supply VBUS. `.vbus` is the supply the host
/// gives (`pos` on VBUS, `neg` on GND, the receptacle's source for the DC analysis: the board
/// states `.voltage`), and `.dp` and `.dm` are the data pair. The shell is joined to ground.
/// The sideband contacts are not brought out. The two resistors are parts of the bill of
/// materials (`R`), 5.1 kohm with a tolerance of 1 %, inside the specification's 20 %. A board
/// that wants a footprint other than the default states `.package` (the receptacle's, as for
/// `UsbC2`), and the Rd's package with `.rd_package` (`"0402"`); left out, the solver picks it.
///
/// It is a module, and a module cannot provide `Connector` (the generic has a `pins` table, which
/// only a part provides); the connector of the board is its receptacle, which does, so the placer
/// and the schematic treat it as one.
module UsbCSink {
    .vbus: Rail
    .dp: Pin
    .dm: Pin
    /// The receptacle's package: the name of a footprint row, such as `"GCT_USB4105_16P"`, which
    /// is the default. A package the standard receptacle has no pin table for takes a provider
    /// of the project's.
    .package: Package
    .package ?= "GCT_USB4105_16P"
    /// The package of the two Rd resistors, a text such as `"0402"`.
    .rd_package: Package optional

    /// The maker's number of the receptacle, to take a provider other than the standard one.
    .receptacle_mpn: String optional

    .receptacle: UsbCSinkReceptacle
    .receptacle.package == .package
    .receptacle.mpn == .receptacle_mpn
    .cc1_rd: Resistor { .resistance &= 5.1kohm +/- 1% }
    .cc2_rd: Resistor { .resistance &= 5.1kohm +/- 1% }
    .cc1_rd.package == .rd_package
    .cc2_rd.package == .rd_package

    .receptacle.vbus ~ .vbus
    .receptacle.dp ~ .dp
    .receptacle.dm ~ .dm
    .receptacle.shell ~ .vbus.neg
    .receptacle.cc1 ~> .cc1_rd ~> .vbus.neg
    .receptacle.cc2 ~> .cc2_rd ~> .vbus.neg
}

/// An OBD-II (SAE J1962) 16-pin vehicle connector, male: the plug that goes into the vehicle's
/// diagnostic socket. `.vbatt` is the supply the vehicle gives, with `pos` on battery power
/// (pin 16) and `neg` on chassis ground (pin 4). Signal ground (pin 5) is optional. The pins
/// J1962 leaves to the manufacturer are named by their number. The DC analysis takes `.vbatt`
/// as a source: its net is held over the range the design states for `.voltage`.
part Obd2M provides Connector {
    .vbatt: Rail
    dc source .vbatt

    pins {
        //  pin         kind           name          pad
        .p1             bidirectional  "1"           "1"
        .j1850_bus_pos  bidirectional  "J1850BUS+"   "2"
        .p3             bidirectional  "3"           "3"
        .vbatt.neg      power          "CHASGND"     "4"
        .signal_gnd     power          "SIGGND"      "5"  optional
        .can_high       bidirectional  "CANHIGH"     "6"
        .iso_k          bidirectional  "ISOK-LINE"   "7"
        .p8             bidirectional  "8"           "8"
        .p9             bidirectional  "9"           "9"
        .j1850_bus      bidirectional  "J1850BUS"    "10"
        .p11            bidirectional  "11"          "11"
        .p12            bidirectional  "12"          "12"
        .p13            bidirectional  "13"          "13"
        .can_low        bidirectional  "CANLOW"      "14"
        .iso_l          bidirectional  "ISOL-LINE"   "15"
        .vbatt.pos      power          "BATTPOWER"   "16"
    }

    .package: Package
    catalog obd2_m { .package }
}

/// Six pads in a footprint that a spring-pin cable presses on, to program a board with no
/// connector fitted. It is the generic form of a Tag-Connect cable's footprint: the pads are
/// `p1` to `p6`, and the board decides what each carries. See `Swd` for a debug port.
part ProgrammingPads6 provides Connector {
    pins {
        .p1 passive "P1" "1"
        .p2 passive "P2" "2"
        .p3 passive "P3" "3"
        .p4 passive "P4" "4"
        .p5 passive "P5" "5"
        .p6 passive "P6" "6"
    }

    .assembly &= AssemblyMode::None
    .package: Package
}
