/// A coaxial (RF) connector: a centre conductor and a shield. `.impedance` is the connector's
/// characteristic impedance and `.max_frequency` the highest frequency it is specified for;
/// a design states them where it needs them. The shield is a single pin, however many pads
/// the footprint gives it.
part Coax {
    .designator &= "J"

    pins {
        .signal passive "SIGNAL" "1"
        .shield passive "SHIELD" "2"
    }

    .impedance: Resistance
    .max_frequency: Frequency

    .package: Package
}

/// A USB Type-C receptacle that carries power only: the bus power, the two configuration
/// channel pins and the shell. `.vbus` is the supply the receptacle gives, with `pos` on
/// VBUS and `neg` on GND; its `current` is negative and follows from the loads on the net
/// (ADR 0007). It is the six-contact power-only receptacle: VBUS on A9 and B9, GND on A12 and
/// B12, CC1 on A5, CC2 on B5, and the shell on S1. Such a receptacle joins A4 to B9 and B4 to
/// A9, and A1 to B12 and B1 to A12, inside, and brings out one of each pair; KiCad's
/// power-only symbol and its six-contact footprints have exactly these pads (ADR 0021). A device that takes 5 V from a source puts a resistor on each CC pin to ground, the
/// specification's pull-down (`Resistor` in a chain: `.cc1 ~> .rd ~> .vbus.neg`).
part UsbCPower {
    .designator &= "J"

    .vbus: Rail

    pins {
        .vbus.pos power   "VBUS"  "A9" "B9"
        .vbus.neg power   "GND"   "A12" "B12"
        .cc1      passive "CC1"   "A5"
        .cc2      passive "CC2"   "B5"
        .shell    passive "SHELL" "S1"
    }

    .package: Package
}

/// A USB Type-C receptacle for USB 2.0, with the sixteen contacts of the full USB 2.0
/// receptacle: VBUS on A4, B4, A9 and B9, GND on A1, B1, A12 and B12, CC1 on A5, CC2 on B5, and
/// the shell on S1, as in the Type-C specification and KiCad's footprints. `.usb` is the
/// `Usb2` port, with D+ on A6 and B6, D- on A7 and B7. The two rows of the receptacle are one
/// pin each, because the plug connects only one of them. The high-speed pairs are not brought
/// out; the sideband pins `.sbu1` (A8) and `.sbu2` (B8) are, because the footprint has the
/// pads, and are left open. The shell is a pin (`.shell`).
part UsbC2 {
    .designator &= "J"

    .usb: Usb2

    pins {
        .usb.vbus.pos power         "VBUS"  "A4" "B4" "A9" "B9"
        .usb.vbus.neg power         "GND"   "A1" "B1" "A12" "B12"
        .usb.dp       bidirectional "D+"    "A6" "B6"
        .usb.dm       bidirectional "D-"    "A7" "B7"
        .cc1          passive       "CC1"   "A5"
        .cc2          passive       "CC2"   "B5"
        .sbu1         passive       "SBU1"  "A8"
        .sbu2         passive       "SBU2"  "B8"
        .shell        passive       "SHELL" "S1"
    }

    .package: Package
}

/// Six pads in a footprint that a spring-pin cable presses on, to program a board with no
/// connector fitted. It is the generic form of a Tag-Connect cable's footprint: the pads are
/// `p1` to `p6`, and the board decides what each carries. See `Swd` for a debug port.
part ProgrammingPads6 {
    .designator &= "J"

    pins {
        .p1 passive "P1" "1"
        .p2 passive "P2" "2"
        .p3 passive "P3" "3"
        .p4 passive "P4" "4"
        .p5 passive "P5" "5"
        .p6 passive "P6" "6"
    }

    .assembly &= "none"
    .package: Package
}
