/// A two-row header with 6 pins, `p1` to `p6`, pin N on pad N. Which pins are in which
/// row is the footprint's: the part states only the pads.
part Header2x3 provides Connector {
    pins {
        .p1 passive "P1" "1"
        .p2 passive "P2" "2"
        .p3 passive "P3" "3"
        .p4 passive "P4" "4"
        .p5 passive "P5" "5"
        .p6 passive "P6" "6"
    }

    .assembly &= AssemblyMode::None
    .mating: Mating {
        .kind &= "pin_header"
        .gender &= "header"
        .pitch &= 2.54mm
        .rows &= 2
        .positions &= 6
    }

    .package: Package
}

