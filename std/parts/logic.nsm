//! Logic ICs, with the logic levels and absolute maximums of their datasheets (ADR 0046).
//!
//! A part here states the numbers of one datasheet and says which table and row each came
//! from. Where a level depends on the supply, the part is restricted to the supply range of
//! the row it states, and a board outside that range is refused.

import std::logic::Logic
import std::sources::Rail

/// A single inverter, TI's SN74LVC1G04 (datasheet SCES214AF, April 1999, revised October
/// 2025), in the 5-pin SOT-23 package (DBV). The part is modelled for a supply of 3 V to
/// 3.6 V, the row of the datasheet's table 5.3 (Recommended Operating Conditions) that
/// gives its input thresholds; the datasheet gives others for other supplies, which are not
/// stated here, and a supply outside 3 V to 3.6 V is refused.
///
/// - Input `a`: `vih` is 2 V and `vil` is 0.8 V (table 5.3, VCC = 3 V to 3.6 V).
/// - Output `y`: `voh` is VCC - 0.1 V and `vol` is 0.1 V, at the 100 uA load of the first
///   rows of table 5.5 (IOH = -100 uA, IOL = 100 uA, VCC = 1.65 V to 5.5 V, the same over
///   -40 C to 85 C and -40 C to 125 C). They are the levels at a light load such as the
///   input of a CMOS part, and are not the levels at the larger currents of the other
///   rows (2.4 V at -16 mA, 2.3 V at -24 mA at VCC = 3 V): a load that draws more than
///   100 uA is not covered.
/// - Absolute maximums (table 5.1): the input `a` is -0.5 V to 6.5 V (VI); the output `y`
///   is -0.5 V to VCC + 0.5 V (VO, in the high or low state).
///
/// The supply current is not stated: the datasheet gives only the static 10 uA maximum
/// (table 5.5, ICC) and the dynamic current depends on the switching, so a board states
/// `.vcc.current` for its use.
///
/// The datasheet gives other thresholds for other supplies, so the part is restricted to 3 V to
/// 3.6 V and refuses a supply outside it (ADR 0046). It is named for the part number and not for
/// an inverter in general, because its numbers are that datasheet's. `std/kicad.toml` maps it to
/// SOT-23-5 and names no symbol, so the symbol is drawn from the pin table, with the no-connect
/// pad 1 (KiCad's `74xGxx:74LVC1G04` leaves that pad out, and the pin validation (ADR 0016,
/// decision 8) does not count a `no_connect` pad that the footprint has and the symbol lacks as a
/// disagreement). It has no catalog row, because an LCSC number needs its
/// own evidence (`data/jlcpcb/README.md`), so `fab` refuses a board with it until one is added. A
/// level check does not know the load (the part states the load of its numbers, above), and a
/// standard kind cannot be given other levels by a board, because it is one value (the limit of
/// `.assembly`, ADR 0024).
part Sn74lvc1g04 {
    .designator &= "U"

    .vcc: Rail
    .a: Logic
    .y: Logic
    .a.reference ~ .vcc
    .y.reference ~ .vcc

    // Table 5.3, the rows of VIH and VIL for VCC = 3 V to 3.6 V.
    .vcc.voltage >= 3V
    .vcc.voltage <= 3.6V
    .a.vih &= 2V
    .a.vil &= 0.8V

    // Table 5.5, IOH = -100 uA and IOL = 100 uA.
    .y.voh &= .vcc.voltage - 0.1V at 100uA
    .y.vol &= 0.1V at 100uA

    // Table 5.1.
    .a.line.abs_min &= -0.5V
    .a.line.abs_max &= 6.5V
    .y.line.abs_min &= -0.5V
    .y.line.abs_max &= .vcc.voltage + 0.5V

    // Section 4, Pin Functions: pad 1 NC, 2 A, 3 GND, 4 Y, 5 VCC (DBV, DCK and DRL).
    pins "SOT-23-5" {
        .nc       no_connect "NC"  "1"
        .vcc.neg  power      "GND" "3"
        .vcc.pos  power      "VCC" "5"
        .a.line   input      "A"   "2"
        .y.line   output     "Y"   "4"
    }

    .package: Package
}

/// A single-supply level translator: a buffer whose input accepts a lower logic level than its
/// own supply and whose output swings between ground and its supply, so a signal from a 1.8 V
/// part reaches a 3.3 V one. A part states what its datasheet gives; a design states the
/// stresses it puts on the part (ADR 0063, ADR 0066).
///
/// - `.vcc_min` and `.vcc_max` are the supply range of the datasheet's Recommended Operating
///   Conditions: the supply rail's voltage must be inside it.
/// - `.vcc_abs_max` and `.a_abs_max` are the Absolute Maximum Ratings on the supply and on the
///   input. `.vcc_peak` and `.a_peak` are the highest voltages the design can put on them,
///   transients included, and only the design knows them; each must be at most its maximum.
/// - `.vt_plus_max` is the highest the input's positive-going threshold can be, so an input
///   driven above it is a high for sure; `.vt_minus_min` is the lowest its negative-going
///   threshold can be, so an input driven below it is a low for sure. They are the input's
///   levels: `.a.vih` is `.vt_plus_max` and `.a.vil` is `.vt_minus_min`, so the solver judges
///   the driver of `.a.line` against them with no statement of the design (ADR 0046), and
///   `.a.line.abs_max` is `.a_abs_max`, which the solver checks against the worst voltage of
///   the input's net.
/// - `.y` is a `Logic` line on the supply that states no level: the catalog has no column for
///   the output's `voh` and `vol`, which a datasheet gives only at a stated load. A receiver on
///   `.y.line` that states its own levels is therefore listed as not evaluated against it, and
///   a design that has the datasheet's pair states it (`.u.y.voh &= .u.vcc.voltage - 0.1V`).
/// - `.max_output_current` is the current the output may source or sink, and `.output_current`
///   the magnitude that the design draws from it.
/// - `.max_supply_current` is the largest current the supply pin draws in the use the row is
///   for, and the part states it as its own draw: `.vcc.current` is `0A .. .max_supply_current`
///   (ADR 0066), so the rail the translator is on carries it. A row whose datasheet gives only
///   a static current for a part that switches states the figure for its use. A design that
///   states `.vcc.current` narrows it, and cannot widen it.
///
/// The pad of each pin is the same in the 5-pin packages of the single-gate logic families
/// (pad 1 NC, 2 A, 3 GND, 4 Y, 5 VCC), and there is a table for each package that its catalog
/// has. That is the order of KiCad's stock symbol `74xGxx:74LVC1G17`; `std/kicad.toml` names no
/// symbol for the kind on the two packages, which are drawn from the pin table. A package with another order (a 6-pin one with two grounds)
/// is another table in a provider, and a translator of another family is a provider of its own.
///
/// The reference rails (ADR 0066). A `Logic` line's `.reference` is joined to `.vcc` by `~`, which
/// equates everything but the current, so the reference is a rail of its own on the same net with
/// a current nobody states, and the balance of the supply net had two unknown terms for the two
/// lines, so no budget on that net was ever checked. The generic states
/// `.a.reference.current &= 0A` and `.y.reference.current &= 0A`: the lines name the supply for
/// their levels and carry nothing, and all the draw is `.vcc.current`. This is true of any part
/// that joins a `Logic` reference to its own rail (`Sn74lvc1g04` too); `Logic` was not changed,
/// which would change every part and example that has one (ADR 0066, accepted as built).
///
/// The draw is the row's own (ADR 0066). `.vcc.current &= 0A .. .max_supply_current` replaced
/// `.vcc.current <= .max_supply_current`: a bound checks a value that the design states, and the
/// design had to state it for the rail to count it. A design that states `.u.vcc.current` meets
/// three cases: a range partly above the maximum is narrowed to the row (`&= 0A..2uA` gives
/// `0A..750nA`; it was refused before, but a design never states what a datasheet already bounds,
/// `docs/DESIGN-RULES.md`), a range wholly above is a contradiction, and a narrower range stays
/// (the design claims less, and ADR 0038 treats a stated current as the design's). Rejected:
/// `?=` (a draw is a fact about the part and not an offer, as ADR 0070 says for `PullUp`, and a
/// design could state a draw above the datasheet's maximum; its attraction is that no existing
/// statement changes meaning, and it is one operator if the owner wants it), `==` (it holds only
/// if the design's range lies inside the row's, so a design stating any range but the maximum
/// fails) and keeping `<=` beside `&=` (it can never fail after the narrowing, so it is dead
/// text). The cost: a design cannot widen the draw beyond the row's, so a switching design needs
/// a row whose figure covers it (a project's own row). `LevelTranslator` is the only std
/// definition that states a draw from a catalog column; the other relations of std that tie a
/// number to a range (ratings of a value the circuit decides, stresses the design states) stay
/// checks, because a `&=` there would cut a partly overlapping range to the overlap and pass the
/// overload the relation exists to refuse. `Sn74lvc1g04` states no supply current: its datasheet
/// gives only the static maximum, and a board states `.vcc.current` for its use.
///
/// Why the output states no level (ADR 0066). The datasheet gives `VOH` and `VOL` only at a stated
/// load, so a pair exists. Columns were not added, for two reasons that are not about the data:
/// the loader of a catalog file requires every column its generic lists, so a new column breaks
/// every project row, provider catalog and guide example written to the header of ADR 0063; and
/// the right columns (a drop from the supply, the load current it holds at, one pair or one per
/// load) are a choice about the generic's interface that the owner has not made. The alternative,
/// `.y.voh &= .vcc.voltage` and `.y.vol &= 0V`, is a claim about an unloaded output that no
/// datasheet gives and a loaded one does not keep. Not decided (review finding 2 of ADR 0066):
/// whether a part's supply current includes the load its outputs source.
///
/// Why it is a generic with no standard rows (ADR 0063). `PMosfet` and this are generics like
/// `NMosfet` (ADR 0068, section 12: the standard definitions with a catalog are generics that are
/// their own first provider). A catalog row needs a recorded source (`data/jlcpcb/README.md`): the
/// LCSC number, the library type and the ratings, read from JLCPCB's and LCSC's records and the
/// datasheet. No translator has been read that way, so the standard file `level_translator.csv`
/// is the header and nothing else. The language allows an empty catalog: the solver says what it
/// says for any catalog with nothing for a requirement (``the `level_translator` catalog has
/// nothing for `u`, which needs nothing in particular``). A header-only file was chosen over no
/// file at all, for one reason: the guide says that a project file named like a standard catalog
/// adds its rows after the standard ones. With the header the sentence is true of this catalog, a
/// project writes `level_translator.csv` and lists it in `netsmith.toml`, and nothing in the
/// generic changes the day a first real row is added. A design that uses it with no project row
/// and no provider is refused at the first use, in the same words as for a resistor no row
/// serves. `crates/netsmith/tests/std_additions.rs` asserts that the file is header-only; when a
/// row is added, the file goes into the `CATALOGS` list of
/// `every_standard_file_reads_and_every_part_in_it_has_its_source`
/// (`crates/netsmith-solve/tests/data.rs`, which leaves the two out on purpose) and that
/// assertion goes.
///
/// Why the name `LevelTranslator`. The glossary has no word for the part. The standard kinds are
/// named for what the part does for the board (`LinearRegulator`, `Tvs`, `Schottky`, `Led`), not
/// for the topology or the family. `Buffer` says what the datasheet calls the part and not what it
/// is for: a buffer that does not translate would not satisfy a board that needs a 1.8 V input on
/// a 3.3 V line. `SchmittBuffer` and a maker's part number name the input type or the maker's
/// part. `LevelShifter` is the common word, and the glossary lists it under _Avoid_ for the
/// reason that the part's supply, and not a shift, sets the output: a shifter can be an up-only or
/// a bidirectional one with a direction pin, which this is not. The generic is for the
/// single-supply, one-direction buffer only; a bidirectional translator with two supplies would be
/// another generic.
///
/// Where it differs from the translator part that a project wrote for its own board (nothing of
/// that project is copied; the rows of the guide and the tests are invented). The datasheet
/// numbers are catalog columns and not narrowings, so one generic serves every translator. The
/// output current is a rating, `.max_output_current`, and the design's load is a separate stress,
/// `.output_current`: in the part the datasheet's number was a value that nothing was compared
/// with. The supply current was first a relation and not a range written `&= 0A..750nA`, because
/// a range of the language has fixed numbers at both ends and a column is not one; ADR 0066
/// answered this with the range `0A .. .max_supply_current`, stated by the part.
/// No relation in the generic uses `.vt_plus_max` and `.vt_minus_min` beyond the input's levels:
/// they are what a design compares its driver's levels with.
///
/// The ADR first made `.a` and `.y` plain pins and asked whether they should be `Logic` lines;
/// ADR 0066 answered that, and they are `Logic` lines. Its other two open questions were: whether
/// the generic should have a `.vcc.current` range through a catalog column, which needs a range
/// whose ends are values, a change to the language (answered in the same way by ADR 0066, for
/// this generic); and a first real row of the catalog with its source, from whoever can read the
/// JLCPCB and LCSC records.
///
/// Left open, for the owner (the changes were approved by the owner; the rest was an agent's): the
/// name `LevelTranslator`, its members and relations, the choice of a header-only catalog file,
/// and the wording of the stage 0 message of ADR 0071 (see `function_of` in
/// `crates/netsmith-check/src/pinout.rs`). Open: a package with another pad order, and a first
/// real row of the catalog.
generic LevelTranslator {
    .designator &= "U"

    /// The supply, VCC and GND.
    .vcc: Rail
    /// The input, with the levels the part's thresholds give. Join its `.line`.
    .a: Logic
    /// The output. It states no level (see above). Join its `.line`.
    .y: Logic
    .a.reference ~ .vcc
    .y.reference ~ .vcc
    // A line's reference rail names the supply for its levels and carries nothing itself: all
    // the part draws is `.vcc.current`, so the balance of the net has no unknown term.
    .a.reference.current &= 0A
    .y.reference.current &= 0A

    .vcc_min: Voltage
    .vcc_max: Voltage
    .vcc_abs_max: Voltage
    .a_abs_max: Voltage
    .vt_plus_max: Voltage
    .vt_minus_min: Voltage
    .max_output_current: Current
    .max_supply_current: Current
    /// The highest voltage on VCC, transients included. A design states it.
    .vcc_peak: Voltage
    /// The highest voltage on A, transients included. A design states it.
    .a_peak: Voltage
    /// The current drawn from or sunk into Y, a magnitude. A design states it.
    .output_current: Current

    .vcc.voltage >= .vcc_min
    .vcc.voltage <= .vcc_max
    .vcc_peak <= .vcc_abs_max
    .a_peak <= .a_abs_max
    .output_current <= .max_output_current

    // The input's levels are the thresholds' worst cases, and its absolute maximum the rating.
    .a.vih &= .vt_plus_max
    .a.vil &= .vt_minus_min
    .a.line.abs_max &= .a_abs_max

    // The part's own draw, which its rail carries.
    .vcc.current &= 0A .. .max_supply_current

    pins "SOT-23-5" {
        .nc       no_connect "NC"  "1"
        .a.line   input      "A"   "2"
        .vcc.neg  power      "GND" "3"
        .y.line   output     "Y"   "4"
        .vcc.pos  power      "VCC" "5"
    }
    pins "SOT-353_SC-70-5" {
        .nc       no_connect "NC"  "1"
        .a.line   input      "A"   "2"
        .vcc.neg  power      "GND" "3"
        .y.line   output     "Y"   "4"
        .vcc.pos  power      "VCC" "5"
    }

    .package: Package
    catalog level_translator { .vcc_min, .vcc_max, .vcc_abs_max, .a_abs_max, .vt_plus_max, .vt_minus_min, .max_output_current, .max_supply_current, .package }
}
