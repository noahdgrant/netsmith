//! Logic ICs, with the logic levels and absolute maximums of their datasheets (ADR 0046).
//!
//! A part here states the numbers of one datasheet and says which table and row each came
//! from. Where a level depends on the supply, the part is restricted to the supply range of
//! the row it states, and a board outside that range is refused.

import std::logic::Logic
import std::sources::Rail

/// A single inverter, TI's SN74LVC1G04 (datasheet SCES214AF, April 1999, revised October
/// 2025), in the 5-pin SOT-23 package (DBV). The part is modelled for a supply of 3 V to
/// 3.6 V, the row of the datasheet's table 5.3 (Recommended Operating Conditions) that
/// gives its input thresholds; the datasheet gives others for other supplies, which are not
/// stated here, and a supply outside 3 V to 3.6 V is refused.
///
/// - Input `a`: `vih` is 2 V and `vil` is 0.8 V (table 5.3, VCC = 3 V to 3.6 V).
/// - Output `y`: `voh` is VCC - 0.1 V and `vol` is 0.1 V, at the 100 uA load of the first
///   rows of table 5.5 (IOH = -100 uA, IOL = 100 uA, VCC = 1.65 V to 5.5 V, the same over
///   -40 C to 85 C and -40 C to 125 C). They are the levels at a light load such as the
///   input of a CMOS part, and are not the levels at the larger currents of the other
///   rows (2.4 V at -16 mA, 2.3 V at -24 mA at VCC = 3 V): a load that draws more than
///   100 uA is not covered.
/// - Absolute maximums (table 5.1): the input `a` is -0.5 V to 6.5 V (VI); the output `y`
///   is -0.5 V to VCC + 0.5 V (VO, in the high or low state).
///
/// The supply current is not stated: the datasheet gives only the static 10 uA maximum
/// (table 5.5, ICC) and the dynamic current depends on the switching, so a board states
/// `.vcc.current` for its use.
part Sn74lvc1g04 {
    .designator &= "U"

    .vcc: Rail
    .a: Logic
    .y: Logic
    .a.reference ~ .vcc
    .y.reference ~ .vcc

    // Table 5.3, the rows of VIH and VIL for VCC = 3 V to 3.6 V.
    .vcc.voltage >= 3V
    .vcc.voltage <= 3.6V
    .a.vih &= 2V
    .a.vil &= 0.8V

    // Table 5.5, IOH = -100 uA and IOL = 100 uA.
    .y.voh &= .vcc.voltage - 0.1V
    .y.vol &= 0.1V

    // Table 5.1.
    .a.line.abs_min &= -0.5V
    .a.line.abs_max &= 6.5V
    .y.line.abs_min &= -0.5V
    .y.line.abs_max &= .vcc.voltage + 0.5V

    // Section 4, Pin Functions: pad 1 NC, 2 A, 3 GND, 4 Y, 5 VCC (DBV, DCK and DRL).
    pins "SOT-23-5" {
        .nc       no_connect "NC"  "1"
        .vcc.neg  power      "GND" "3"
        .vcc.pos  power      "VCC" "5"
        .a.line   input      "A"   "2"
        .y.line   output     "Y"   "4"
    }

    .package: Package
}

/// A single-supply level translator: a buffer whose input accepts a lower logic level than its
/// own supply and whose output swings between ground and its supply, so a signal from a 1.8 V
/// part reaches a 3.3 V one. A part states what its datasheet gives; a design states the
/// stresses it puts on the part (ADR 0063, ADR 0066).
///
/// - `.vcc_min` and `.vcc_max` are the supply range of the datasheet's Recommended Operating
///   Conditions: the supply rail's voltage must be inside it.
/// - `.vcc_abs_max` and `.a_abs_max` are the Absolute Maximum Ratings on the supply and on the
///   input. `.vcc_peak` and `.a_peak` are the highest voltages the design can put on them,
///   transients included, and only the design knows them; each must be at most its maximum.
/// - `.vt_plus_max` is the highest the input's positive-going threshold can be, so an input
///   driven above it is a high for sure; `.vt_minus_min` is the lowest its negative-going
///   threshold can be, so an input driven below it is a low for sure. They are the input's
///   levels: `.a.vih` is `.vt_plus_max` and `.a.vil` is `.vt_minus_min`, so the solver judges
///   the driver of `.a.line` against them with no statement of the design (ADR 0046), and
///   `.a.line.abs_max` is `.a_abs_max`, which the solver checks against the worst voltage of
///   the input's net.
/// - `.y` is a `Logic` line on the supply that states no level: the catalog has no column for
///   the output's `voh` and `vol`, which a datasheet gives only at a stated load. A receiver on
///   `.y.line` that states its own levels is therefore listed as not evaluated against it, and
///   a design that has the datasheet's pair states it (`.u.y.voh &= .u.vcc.voltage - 0.1V`).
/// - `.max_output_current` is the current the output may source or sink, and `.output_current`
///   the magnitude that the design draws from it.
/// - `.max_supply_current` is the largest current the supply pin draws in the use the row is
///   for, and the part states it as its own draw: `.vcc.current` is `0A .. .max_supply_current`
///   (ADR 0066), so the rail the translator is on carries it. A row whose datasheet gives only
///   a static current for a part that switches states the figure for its use. A design that
///   states `.vcc.current` narrows it, and cannot widen it.
///
/// The pad of each pin is the same in the 5-pin packages of the single-gate logic families
/// (pad 1 NC, 2 A, 3 GND, 4 Y, 5 VCC), and there is a table for each package that its catalog
/// has.
generic LevelTranslator {
    .designator &= "U"

    /// The supply, VCC and GND.
    .vcc: Rail
    /// The input, with the levels the part's thresholds give. Join its `.line`.
    .a: Logic
    /// The output. It states no level (see above). Join its `.line`.
    .y: Logic
    .a.reference ~ .vcc
    .y.reference ~ .vcc
    // A line's reference rail names the supply for its levels and carries nothing itself: all
    // the part draws is `.vcc.current`, so the balance of the net has no unknown term.
    .a.reference.current &= 0A
    .y.reference.current &= 0A

    .vcc_min: Voltage
    .vcc_max: Voltage
    .vcc_abs_max: Voltage
    .a_abs_max: Voltage
    .vt_plus_max: Voltage
    .vt_minus_min: Voltage
    .max_output_current: Current
    .max_supply_current: Current
    /// The highest voltage on VCC, transients included. A design states it.
    .vcc_peak: Voltage
    /// The highest voltage on A, transients included. A design states it.
    .a_peak: Voltage
    /// The current drawn from or sunk into Y, a magnitude. A design states it.
    .output_current: Current

    .vcc.voltage >= .vcc_min
    .vcc.voltage <= .vcc_max
    .vcc_peak <= .vcc_abs_max
    .a_peak <= .a_abs_max
    .output_current <= .max_output_current

    // The input's levels are the thresholds' worst cases, and its absolute maximum the rating.
    .a.vih &= .vt_plus_max
    .a.vil &= .vt_minus_min
    .a.line.abs_max &= .a_abs_max

    // The part's own draw, which its rail carries.
    .vcc.current &= 0A .. .max_supply_current

    pins "SOT-23-5" {
        .nc       no_connect "NC"  "1"
        .a.line   input      "A"   "2"
        .vcc.neg  power      "GND" "3"
        .y.line   output     "Y"   "4"
        .vcc.pos  power      "VCC" "5"
    }
    pins "SOT-353_SC-70-5" {
        .nc       no_connect "NC"  "1"
        .a.line   input      "A"   "2"
        .vcc.neg  power      "GND" "3"
        .y.line   output     "Y"   "4"
        .vcc.pos  power      "VCC" "5"
    }

    .package: Package
    catalog level_translator { .vcc_min, .vcc_max, .vcc_abs_max, .a_abs_max, .vt_plus_max, .vt_minus_min, .max_output_current, .max_supply_current, .package }
}
