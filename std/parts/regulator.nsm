//! Voltage regulators.

import std::logic::Logic
import std::parts::diode::Schottky
import std::parts::passive::{Capacitor, CapacitorBank, Inductor, Resistor}
import std::sources::Rail

/// A linear regulator with a fixed output. Its input and output share a ground. Which
/// pad is which depends on the package, so there is a pin table for each package its
/// catalog has. The output's ground (`.vout.neg`) is joined to the input's inside the part,
/// so it needs no row.
#[kind(ic)]
generic LinearRegulator {
    .designator &= "U"

    .vin:  Rail
    .vout: Rail
    .vin.neg ~ .vout.neg

    .dropout:     Voltage
    .max_current: Current
    .max_power:   Power
    .vin.voltage >= .vout.voltage + .dropout

    /// The current the regulator itself draws from its input, with the output unloaded: the
    /// datasheet's quiescent (ground pin) current, as a range, at its largest over the
    /// conditions the design runs in. A part states it with `&=` from its datasheet; one that
    /// states nothing has the default, none (the regulator's own current is then left out, as
    /// it was before the member existed), and a board that knows better states it.
    .quiescent_current: Current
    .quiescent_current ?= 0A

    // What the input draws is what the output supplies and the quiescent current.
    .vin.current == -.vout.current + .quiescent_current

    // At DC the regulator holds its output rail's voltage and draws from its input what it
    // supplies and the quiescent current (ADR 0076, amendments 3 and 9).
    dc linear_regulator .vin .vout .quiescent_current

    // It must be able to supply what is drawn from it, and survive the heat of doing so: the
    // drop across it times the load, and the input voltage times the quiescent current.
    -.vout.current <= .max_current
    (.vin.voltage - .vout.voltage) * (-.vout.current) + .vin.voltage * .quiescent_current <= .max_power

    // Pad 1 is ground, 2 the output and 3 the input, in both packages.
    pins "SOT-23" "SOT-223" {
        .vin.pos  power "IN"  "3"
        .vin.neg  power "GND" "1"
        .vout.pos power "OUT" "2"
    }

    .package: Package
    catalog ldo { .vout.voltage, .dropout, .max_current, .max_power, .package }
}

/// The resistor divider that sets the output of an adjustable regulator: `rtop` from the
/// output to the feedback pin and `rbottom` from the feedback pin to ground, so the regulator
/// holds the feedback pin at its reference `vref` and the output at
/// `vref * (1 + rtop / rbottom)` (ADR 0025). The board states the output it wants
/// (`.divider.vout &= 3.8V +/- 3%`) and the regulator's reference with its tolerance
/// (`.divider.vref &= 1.0V +/- 1%`, from the datasheet), and the solver picks two resistors
/// whose tolerances keep the output inside the wanted range in the worst case. The output is
/// a plain voltage and the pins are plain pins, so the divider adds nothing to the currents
/// of a rail; the board joins `top` to the positive pin of the output rail, `bottom` to its
/// negative pin and `fb` to the regulator's feedback pin.
///
/// The feedback pin draws nothing (its bias current is ignored), so the same current runs
/// through both resistors, `(vout - vref) / rtop` and `vref / rbottom`, and each resistor's
/// power rating is checked against it. An output below the reference cannot be made, because the
/// divider can only raise it: it is refused with the numbers.
///
/// Why pins and voltages, not a `Rail` (ADR 0025). A first version had an `output: Rail`. Inside a
/// stage that makes the output, the divider's rail and the stage's port are two terms on one net
/// with no supplier among them, and the balance of currents (ADR 0007, ADR 0014) attributes the
/// whole load to the divider and then refuses the divider's own current. A divider that is pins
/// and voltages adds no term to any net, so it can sit under any rail. The board says
/// `.out.voltage == .divider.vout`, or a stage does it for the board. The cost is a limit: the
/// divider's few microamps to a milliamp are not added to the load.
module FeedbackDivider {
    /// Joined to the positive pin of the output the divider measures.
    .top: Pin
    /// The tap, joined to the regulator's feedback pin.
    .fb: Pin
    /// Joined to the output's ground.
    .bottom: Pin
    /// The regulator's reference voltage at the feedback pin, with its tolerance.
    .vref: Voltage
    /// The output voltage the divider sets.
    .vout: Voltage
    /// The current that runs through both resistors, from the output to ground. It is a value
    /// read out of the module, not one passed in: a bound (`<=`) or a read reaches inside no
    /// module (ADR 0116), so `Buck` and a board take the current from here.
    .current: Current
    .rtop: Resistor
    .rbottom: Resistor
    /// The package of both resistors, a text such as `"0402"`; a board that does not state it
    /// leaves the pick to the solver. One package for the pair, as `I2cPullups` has: it ties the two
    /// resistors to one package, which a narrowing of each cannot say (ADR 0116).
    .package: Package optional
    .rtop.package == .package
    .rbottom.package == .package

    .current == .rtop.current
    .vout == .vref * (1 + .rtop.resistance / .rbottom.resistance)
    .rtop.current == (.vout - .vref) / .rtop.resistance
    .rbottom.current == .vref / .rbottom.resistance

    .top ~ .rtop.a
    .rtop.b ~ .fb
    .fb ~ .rbottom.a
    .rbottom.b ~ .bottom
}

/// What a switching (buck) regulator IC says about itself, for `Buck` (ADR 0025, ADR 0115). A
/// concrete IC is a `part X provides BuckIc`, and it writes four things:
///
/// - its pin table, against the pins of this generic (`.vin.pos`, `.vin.neg`, `.sw.pos`, `.fb`);
/// - its datasheet numbers as narrowings (`.fsw &= 1.2MHz +/- 15%`);
/// - the one relation that ties its input to its output, what it draws from what it
///   supplies over the whole efficiency range:
///   `.vin.current == -.sw.current * .sw.voltage / (.vin.voltage * .efficiency)`,
///   plus what the IC draws for itself with nothing loaded when its datasheet gives it, as a
///   member of the IC (`.quiescent_current`, a range of currents, as `LinearRegulator`'s is) that
///   `dc switching_regulator` takes as its fourth operand (ADR 0096);
/// - in a `support` section, the parts its datasheet's application circuit puts around it that
///   not every buck IC has: a bootstrap capacitor, the resistor on `RT`, the capacitor on an
///   internal supply, an enable divider (ADR 0115). `Buck` wires only what this generic has.
///
/// A switching frequency that a resistor sets is one more relation the IC writes, for example
/// `.fsw == 24GHz * 1ohm / .rt` with `.rt: Resistance` a field of the IC that its support
/// section ties to its `RT` resistor. A number the IC leaves open makes the relations that use
/// it not evaluated, which is no error.
///
/// Why the work is split between this and `Buck` (ADR 0025, ADR 0115). What every buck IC is,
/// its pins and the numbers its datasheet gives, is this generic; everything around it that is
/// the same for every IC (the inductor, the capacitor banks, the feedback divider and the checks
/// that join them) is `Buck<Ic: BuckIc>`, written once; and what one IC alone needs is in that
/// IC's own `support` section. The recommended inductance of the IC is its `min_inductance`,
/// one number. The worked example is an invented IC, `Zbk2`, in the guide ("Switching
/// regulators") and in `crates/netsmith-solve/tests/std_models.rs`; nothing about a real part
/// is in the guide.
///
/// Why the switching node is a rail. The checker's balance of currents needs a supplier inside the
/// module's scope for a net that has a port, and a rail inside a part must have a pad (a part
/// cannot be placed with a padless pin). The buck's output node is after the inductor and a buck
/// IC usually has no pin on it, so the supplier is the IC's `sw` pin as a rail (`.sw: Rail`, the DC
/// voltage the output's, the current the negative of the load), and the inductor is a `~>` chain
/// from it to the output. In a chain the inductor's `.current` is the draw, the average (ADR
/// 0014), so `Buck` states the peak itself. The input current,
/// `iout * vout / (vin * efficiency)` over the whole efficiency range, is the IC's relation and
/// reaches the supply through the IC's `vin` rail, which is `Buck`'s own `vin`.
///
/// Not modelled when ADR 0025 was written: loop stability, dropout and minimum on-time (the output
/// must be at most the input; the minimum on-time and off-time are modelled since ADR 0093),
/// light-load modes, the divider's and the IC's quiescent current in the load (see `Buck`),
/// and the second capacitor an IC may ask for. Each was open in issue #63.
///
/// Why there is no `BuckBoost` beside it (the owner, 2026-11-12, #473). `dc switching_regulator`
/// is a power balance and assumes no topology, so a buck-boost IC states it on its own rails as a
/// part (`.vout: Rail`, its efficiency and quiescent current from its datasheet), with no std
/// generic: the TPS55288 of `examples/power_manifold_charger` does. A std generic and module
/// wait for a second buck-boost IC. The only one so far is a poor template: its buck leg is two
/// external MOSFETs that most buck-boost ICs have inside, its inductor sits between two switch
/// nodes and not in a `~>` chain to the output, and every check of a module would have to hold
/// in both the buck and the boost mode over ranges of input and output that overlap.
generic BuckIc {
    .designator &= "U"

    /// The IC's supply.
    .vin: Rail
    /// The switching node as a supply: its `pos` is the IC's switch pin and its `voltage` the
    /// output voltage it averages to, and the load current comes out of it (the `current` is
    /// negative: the IC supplies). The inductor is between this and the output. Its `neg` is
    /// the IC's ground.
    .sw: Rail
    .sw.neg ~ .vin.neg

    pins {
        .vin.pos  power
        .vin.neg  power
        .sw.pos   power
        // The feedback pin, joined to the tap of the divider.
        .fb       input
    }
    /// The reference at the feedback pin, with its tolerance.
    .vref: Voltage
    /// The switching frequency, with its tolerance.
    .fsw: Frequency
    .min_input_voltage: Voltage
    .max_input_voltage: Voltage
    /// The largest continuous output current.
    .max_output_current: Current
    // The switch node supplies what the datasheet allows and no more. This is also the enclosure
    // of the load behind the regulator before any part is picked (ADR 0076, amendment 6).
    -.sw.current <= .max_output_current
    /// The efficiency over the load range, as a range of fractions (`0.85..0.95`).
    .efficiency: Number
    /// The smallest inductance the datasheet allows (a table of recommended values is not
    /// one number; the IC states the smallest).
    .min_inductance: Inductance
    /// The least saturation current an inductor may have, when the datasheet gives one (for
    /// example, a figure above the IC's high-side current limit). Optional (ADR 0074): an IC
    /// that states nothing here has no such check, and `Buck` does not check the
    /// inductor's saturation against it, beyond the load and half the ripple.
    .min_inductor_saturation: Current optional
    /// The largest DC resistance an inductor may have, when the datasheet gives one.
    /// Optional (ADR 0074): an IC that states nothing here sets no limit, and `Buck`
    /// checks nothing against it.
    .max_inductor_dcr: Resistance optional
    /// The shortest time the high-side switch can stay on, the datasheet's minimum on-time,
    /// at its largest (the worst case for the design). It bounds the lowest duty cycle, so the
    /// highest input for an output and a frequency: `vout / (vin * fsw)` is never less than it.
    /// Optional (ADR 0074): an IC that states nothing here has no such check from `Buck`
    /// (an IC that gives its own equation, as the `Lt8641` does, writes that instead). ADR 0093.
    .min_on_time: Time optional
    /// The shortest time the high-side switch stays off (the low-side switch's minimum on-time
    /// in some datasheets), at its largest. It bounds the highest duty cycle, so the least
    /// headroom of the input over the output the IC keeps its frequency at, its dropout:
    /// `(vin - vout) / (vin * fsw)` is never less than it. Optional, as `min_on_time`.
    .min_off_time: Time optional
    /// How long the output takes to rise to its regulation point after the converter starts, at
    /// the soft-start of the IC as it is (an internal ramp), as the datasheet gives it: a time,
    /// or the span between its minimum and maximum, with the page in the part's doc comment.
    /// Optional (ADR 0074): an IC whose datasheet gives no such time states nothing, and an IC
    /// whose ramp a board capacitor sets (a soft-start pin) states a time only if the datasheet
    /// gives one for a stated capacitor. `Buck` forwards it as `.soft_start_time`, which a
    /// board bounds (`.reg.soft_start_time <= 5ms`); while nothing bounds it the check is
    /// not made, and a bound on an IC that states no time is listed as not evaluated.
    .soft_start_time: Time optional
    /// The capacitance the datasheet asks for on the input and the output, as effective
    /// capacitance in use (ADR 0013).
    .min_input_capacitance: Capacitance
    .min_output_capacitance: Capacitance
}

/// Any buck converter: a supply that steps its input rail down to its output rail, whatever IC
/// and circuit make it (ADR 0068, ADR 0115). A board places one by what it needs and lets the
/// solver pick the IC:
///
/// ```text
/// .reg: BuckConverter { .vout.voltage &= 3.3V +/- 5% }
/// .v12 ~ .reg.vin
/// .reg.vout ~ .v3v3
/// ```
///
/// The standard library's provider is `Buck<Ic>`, which stands for one candidate for each part
/// in scope that provides `BuckIc` (ADR 0115): the standard ones are `Lmr16006y`, `Lt8641`,
/// `Rt8059` and `Tps54202`, tried in that order (the order of names in this file), then a
/// project's own. The pick is the first for which every check of the board holds (ADR 0068):
/// the input's range against the IC's, the load against its largest output current, the output
/// voltage against what its reference and the 1 % resistors of the divider can hold in the
/// worst case, and a catalog row for every part of it. A board that wants one IC names it,
/// `.reg: Buck<Tps54202>`, and may then join the IC's own pins (ADR 0120).
///
/// A candidate whose trial cannot be judged is passed over for one that can (ADR 0068). The
/// `Lmr16006y`'s catch diode joins ground and the switch node, two nets the DC analysis holds,
/// between which the current of an ideal diode is not a number the analysis can work out; its
/// `support` section states that current, so the trial is judged with it and the `Lmr16006y`,
/// first in the order, is picked wherever it serves.
///
/// The output's tolerance must leave room for the reference: each standard IC's is good to 2 %
/// or 2.5 % in the worst case, and the divider's 1 % resistors add about 1.5 % at 3.3 V, so a
/// 3.3 V output of 3 % holds for none of them and one of 5 % holds for each.
///
/// What a board narrows here is what it needs of a buck and nothing of how one is built: the
/// output voltage (`.vout.voltage`), the load (the `.current` of the rail joined to `.vout`),
/// the input (the rail joined to `.vin`, its `.voltage` and its `.peak`) and, when it states the
/// ESR of the output capacitors, the ripple of the output voltage. The two grounds are one and
/// the output is never above the input, for every provider.
///
/// Decided by the agent while the owner was away (2026-11-13, issue #620): the members are the
/// two rails and the ripple with the ESR it needs, the members `Buck` had that say what the
/// board gets rather than how it is made. Not taken: the soft-start time and the capacitors'
/// `.voltage_margin` (they stay on `Buck`, for a board that names the IC: a bound on a
/// soft-start time that an IC does not state would be not evaluated, and a trial that cannot be
/// judged does not hold, so the bound would refuse every such IC); a `.max_output_current`
/// requirement (the load on `.vout` already says it, and the IC's own limit is checked against
/// it); one generic per input range (the input rail says it).
generic BuckConverter {
    .vin: Rail
    .vout: Rail
    .vin.neg ~ .vout.neg
    .vin.voltage >= .vout.voltage
    /// The peak-to-peak ripple of the output voltage, a closed-form estimate (not a
    /// simulation). Each provider states how it is made; in `Buck` it is the charge the
    /// capacitor bank takes from the triangular ripple current plus the drop of that current
    /// across the bank's ESR,
    /// `.ripple / (8 * fsw * total_effective_capacitance) + .ripple * .output_esr / count`.
    /// The first term is the charge balance of a capacitor that takes the ripple current of
    /// the inductor and nothing of the load (Erickson and Maksimovic, *Fundamentals of Power
    /// Electronics*, chapter 2; the equation number was not looked up; TI SLVA477B gives the
    /// same two terms, read as a summary only). The two terms are 90 degrees apart in a
    /// ceramic capacitor, so adding them is the conservative sum. A board bounds it
    /// (`.reg.output_ripple <= 20mV`) and the bound holds in the worst case the ranges
    /// give: the highest input, the lowest inductance (its tolerance), the lowest switching
    /// frequency (its tolerance), the lowest effective capacitance (its tolerance and its DC
    /// bias) and the highest ESR. Each is monotone in it, so the range is exact.
    ///
    /// What it assumes: the converter switches at its programmed frequency every period at
    /// the ripple current of `.ripple` (the on-time and off-time checks hold the frequency,
    /// ADR 0093); the load draws a steady current, so the capacitor takes only the ripple;
    /// the capacitors of the bank share the ripple current equally; `.output_esr` is the
    /// ESR at the switching frequency, at the DC bias and over the temperature range.
    ///
    /// Wrong, and optimistic, when: the converter skips pulses or runs in burst mode at
    /// light load, where the ripple is larger and the frequency lower (a part with such a
    /// mode, as the LT8641 has, is judged at its programmed frequency); the output has
    /// spikes at the switch edges that the capacitors' ESL makes (there is no inductance of
    /// the capacitor in the formula); a constant-on-time or hysteretic converter, whose
    /// ripple the ESR sets by design; the bank's capacitors differ (the ESR of one divided by
    /// the count, as the ripple current is shared equally); a load that steps, or the
    /// regulator's loop (neither is in a closed form, issue #306). It is the ripple of the
    /// capacitor bank, not of the board: the traces' resistance and the load's own ripple are
    /// not in it.
    ///
    /// Not evaluated until the board states `.output_esr`, since the capacitor term alone
    /// would be too small. A bound on this member with no ESR stated is listed as not
    /// evaluated, never a pass.
    .output_ripple: Voltage
    /// The ESR of one capacitor of the output bank at the switching frequency, at the
    /// highest the board accepts (a range gives the worst case: use the datasheet's maximum
    /// and not its typical figure, at the DC bias and the temperature of the board).
    /// Optional (ADR 0074): a board that states nothing here has no ripple of the output
    /// voltage and nothing is checked against it. The standard capacitor catalog has no ESR
    /// column yet (a column needs a number from the maker's datasheet or tool, with its
    /// conditions as the recorded source), so this is the board's own figure, the last
    /// resort of the design rules: a board states it from the datasheet of the capacitor
    /// it means to fit, and the solver picks `.output_cap` without checking it against this
    /// number. Whether the board states it here or the capacitor carries it is the owner's
    /// to confirm.
    .output_esr: Resistance optional
}

/// A buck converter: the IC, a part that provides `BuckIc` and stands for the parameter `Ic`,
/// and everything around it that every buck IC needs (ADR 0025, ADR 0115): the inductor, the
/// input and output capacitors, and the feedback divider that sets the output. What one IC
/// alone needs (a bootstrap capacitor, the resistor on `RT`) is in that IC's own `support`
/// section, which comes with it. The board names the IC and states the output it wants
/// (`.reg: Buck<Lt8641> { .vout.voltage &= 1.8V +/- 3% }`), its input rail and its load
/// (`.output.current &= 0mA..1A`), and joins two pairs of interfaces: `.input ~ .reg.vin` and
/// `.reg.vout ~ .output`. The module's input is the IC's (`.ic.vin ~ .vin`), so what the
/// converter draws is what the IC's relation says.
///
/// From the IC's numbers the module states what is always true of a buck converter and the
/// solver checks it in the worst case:
///
/// - the input stays inside the IC's range and above the output, and the load is at most its
///   largest output current;
/// - the module's `.on_time`, `vout / (vin * fsw)`, is at least the IC's `.min_on_time`, and its
///   `.off_time`, `(vin - vout) / (vin * fsw)`, at least the IC's `.min_off_time`: the highest
///   input and the lowest headroom at which the IC holds its switching frequency, so at which
///   the ripple below is the ripple of the board (ADR 0093; the minimum on-time bounds the
///   lowest duty cycle, so the highest input for an output; both are `optional`, so an IC
///   that states neither has no such check);
/// - the ripple current of the inductor is `(vin - vout) * vout / (vin * L * fsw)`, largest at
///   the highest input, and the inductor must carry the load plus half the ripple without
///   saturating: `isat >= iout + ripple / 2`. In a chain the inductor's `.current` is the
///   load, the average (ADR 0014), so the half ripple is added here and the part's own
///   `current <= saturation_current` is the weaker check of the average;
/// - the ripple of the output voltage, `.output_ripple`, is the sum of the two terms of
///   `dI / (8 * fsw * n * C) + dI * ESR / n`, where `dI` is the ripple current above, `n` the
///   output bank's count, `C` one capacitor's effective capacitance and `ESR` the board's
///   `.output_esr`: a limit the board states on it is checked in the worst case (see
///   `.output_ripple` below, and what that check assumes);
/// - the inductor is at least the IC's minimum, has at least the saturation current and at
///   most the DC resistance that the IC states (`.min_inductor_saturation`,
///   `.max_inductor_dcr`; both are `optional` members of `Buck` (ADR 0074), so each is
///   checked when the IC states it and skipped, with no note, when it does not), and each
///   capacitor has at least the effective capacitance the IC asks for at the voltage across
///   it and is rated for the peak of its rail (`.peak`, unset when nothing states it, and
///   then that check is not evaluated) and for the rail's steady voltage, so a peak stated
///   too low cannot let a capacitor through that the steady voltage would not.
///
/// The on-time and off-time are the duty cycle of an ideal buck converter over the switching
/// frequency, at the worst case the ranges give: the shortest on-time is the lowest output at
/// the highest input and the highest frequency (its tolerance included), the shortest
/// off-time the lowest headroom at the highest frequency. A violation names the numbers
/// (`reg.on_time must always be at least reg.ic.min_on_time, but 122ns..490.8ns is not
/// always above 150ns`). A part states a figure with `&=` in its own definition
/// (`.min_on_time &= 70ns`), at the largest the datasheet gives, with the revision, page
/// and table in its doc comment. Past either limit the part still regulates, at a lower
/// frequency (LM61430-Q1 8.4.3 and 8.1, "frequency is reduced automatically"; LT8641, p.16),
/// so the ripple above, computed at the programmed frequency, would not be the board's: that
/// is why the check is an error and not a note. No std part states the two figures: the
/// `Lt8641` keeps its own Equations 4 and 5, which include the switch drops (about 0.15 V and
/// 0.3 V) the module does not know, and a second, stricter relation beside them would refuse
/// boards the datasheet's own equation accepts. Not taken: a `.max_duty_cycle` or `.dropout`
/// member (both datasheets give a time, and a maximum duty `1 - fsw * tOFF_MIN` is right at
/// one frequency only); the equation with the switch drops (`Buck` has no such members and
/// the LM61430-Q1's datasheet gives none; the ideal duty cycle gives an on-time never longer
/// than the real one, so the check can refuse a board that holds its frequency by a few
/// percent and never accepts one that does not); evaluating at the rail's `.peak`, which is a
/// transient where the datasheets say the part lowers its frequency and recovers (the peak
/// stays a rating, `.vin.peak <= .vin_abs_max`); a required member (existing parts and boards
/// would stop building, the reason ADR 0069's `required` was dropped); folding the check into
/// each IC's own relations (each would write the same two lines, and the module is where the
/// output, the input and the frequency meet). A linear regulator's dropout was already
/// checked: `LinearRegulator` states `.vin.voltage >= .vout.voltage + .dropout`. The names
/// `.min_on_time` and `.min_off_time` (the `Lt8641` spells its own `.t_on_min`), and the `Lt8641`
/// not stating its 50 ns and 110 ns on `Buck`, are accepted as built (the owner, 2026-11-11).
///
/// The divider's current and the quiescent current of the IC are not added to the load, so
/// the inductor carries the load: `.inductor.current == -.vout.current` (the IC's own current
/// is in its input's, as its part writes it, ADR 0096). A design that adds
/// up a quiescent budget reads the divider's share from `.divider_current`. The divider's pins
/// are on the output net and are not modelled, so the balance there is not complete and
/// cannot say that itself (ADR 0027).
///
/// Each side is a `CapacitorBank` of identical capacitors in parallel (ADR 0052): `.input_cap` and
/// `.output_cap` stand for one capacitor of the bank, and their `.count` says how many. The
/// solver chooses the row and the count together, the fewest from 1 up to
/// 8 (the bank's own default) for which every check holds with `total_effective_capacitance`
/// against what the IC asks for and the rating, the voltage and the rest per capacitor. A datasheet that asks for
/// more than any one capacitor keeps at its voltage is met by several. The board may state the
/// count (`.reg.output_cap.count &= 2`, which the checks then hold to) or a range
/// (`.reg.output_cap.count &= 1..3`, which is what the solver may choose from, ADR 0116). A
/// bank of one is the single capacitor this module had before. The ripple current a capacitor
/// takes is not modelled, so it is not divided between the capacitors of a bank.
///
/// The IC's recommended inductance is its `min_inductance`; the converter's stability and
/// its loop are not modelled.
///
/// One capacitor on each side is picked for the effective capacitance the IC asks for at the
/// voltage across it (ADR 0013). The catalog's Basic capacitors lose most of their capacitance at
/// a few volts, so an IC that asks for 10 uF or more at 12 V finds no capacitor; the guide's
/// invented IC is 4.5 V to 6 V. A frequency that a resistor sets is one more relation the IC
/// writes (`.fsw == 24GHz * 1ohm / .rt_value`, tested). The naming of
/// `FeedbackDivider` and of the catalogs is accepted as built by the owner, 2026-11-11; the
/// IC as a type parameter and the names `Buck` and `BuckIc` are ADR 0115's.
module Buck<Ic: BuckIc> provides BuckConverter {
    /// The IC, a part that provides `BuckIc`.
    .ic: Ic
    .divider: FeedbackDivider
    .inductor: Inductor
    .input_cap: CapacitorBank
    .output_cap: CapacitorBank
    /// The peak-to-peak ripple current of the inductor.
    .ripple: Current
    /// How long the high-side switch is on in a period, `vout / (vin * fsw)` (the ideal duty
    /// cycle over the frequency), and how long it is off, `(vin - vout) / (vin * fsw)`: the
    /// module's check of the IC's `min_on_time` and `min_off_time` (ADR 0093).
    .on_time: Time
    .off_time: Time
    /// How long the output takes to rise at start-up: the IC's `.ic.soft_start_time`, as the
    /// datasheet gives it. A closed-form check against a requirement (not a simulation): a
    /// board bounds it (`.reg.soft_start_time <= 5ms`, or `>=` to keep an inrush down), and the
    /// bound holds over the whole span the IC states. Not evaluated, and listed as such, when
    /// the IC states no time; while no board bounds it nothing is checked and nothing is said.
    /// It is the IC's own ramp: the output capacitance and the load do not change it here, and
    /// a rise that a current limit stretches (a large output capacitor, a load that draws at
    /// start-up) is longer than this and is not in the figure.
    .soft_start_time: Time
    /// The current the feedback divider draws from the output, the divider's `.current` read
    /// out of the module (a bound or a read reaches inside no module, ADR 0116).
    .divider_current: Current
    /// The factor each capacitor's rating has over the highest voltage of its rail (ADR 0085):
    /// `.input_cap.max_voltage >= .vin.peak * .voltage_margin`, and the same for
    /// the steady `.voltage` and for the output. A default of 1, which asks for no more than
    /// the rail's peak; a board that derates its capacitors states it
    /// (`.reg.voltage_margin &= 1.25`), and a module that wraps this one forwards its own
    /// (`.reg.voltage_margin &= .margin`). The board's `&=` replaces the default (`?=`,
    /// ADR 0051).
    ///
    /// Why it is one member of the module. A board may narrow the capacitors inside the module
    /// (ADR 0116), but only to a constant, and a rule that follows the rail (every ceramic
    /// capacitor on a power rail rated at least 1.25 times its peak) is a relation, which reaches
    /// inside no module; before the member, a board kept a copy of the module for it. The
    /// margin applies to the steady voltage as well as to the peak: a rail that states no peak
    /// leaves the peak lines not evaluated, and a margin only on them would silently do
    /// nothing there. A peak is never below the steady voltage, so a board that states its
    /// peak gets the same result as with the peak lines alone. With the default 1 each line is
    /// the one it replaced (`x * 1` is exact), so no existing board, pick or golden changes;
    /// only the text of a failing message differs, which now quotes the product. The module has
    /// no bootstrap or bypass capacitor (they are inside the IC's own circuit, which a part or
    /// module writes), so the member covers the two banks the module has; a module that adds
    /// such capacitors states its own bound.
    ///
    /// Not taken: a margin for each side (two members to state one rule); a margin on the peak
    /// only, as a project's copy had it; exposing `.input_cap` and `.output_cap` so a board
    /// states `.reg.input_cap.max_voltage >= ...` itself (a larger change to what the module
    /// exposes, and each board repeats the rule); a margin on `Rail` (every part on the rail
    /// would read it, and a rail has no reason to know how parts are derated); a default of
    /// 1.25 (it changes every existing board and golden). The name, the steady voltage taking
    /// the margin too, and whether other std modules that hold capacitors across a rail take
    /// the same member when they are added (none exists besides `Buck`) are accepted as
    /// built (the owner, 2026-11-11).
    .voltage_margin: Number
    .voltage_margin ?= 1

    .ic.vin ~ .vin
    .inductor.current == -.vout.current

    // A bank is from one to eight capacitors unless the board says otherwise (its own default).

    .ic.sw.voltage == .vout.voltage
    .divider.top ~ .vout.pos
    .divider.bottom ~ .vout.neg
    .divider.fb ~ .ic.fb
    .divider.vref == .ic.vref
    .divider.vout == .vout.voltage
    .divider_current == .divider.current

    .ic.sw.pos ~> .inductor ~> .vout.pos
    .vin.pos ~> .input_cap ~> .vin.neg
    .vout.pos ~> .output_cap ~> .vout.neg

    .vin.voltage >= .ic.min_input_voltage
    .vin.voltage <= .ic.max_input_voltage
    -.vout.current <= .ic.max_output_current
    .input_cap.max_voltage >= .vin.voltage * .voltage_margin
    .output_cap.max_voltage >= .vout.voltage * .voltage_margin
    .input_cap.max_voltage >= .vin.peak * .voltage_margin
    .output_cap.max_voltage >= .vout.peak * .voltage_margin

    .ripple == (.vin.voltage - .vout.voltage) * .vout.voltage / (.vin.voltage * .inductor.inductance * .ic.fsw)
    .on_time == .vout.voltage / (.vin.voltage * .ic.fsw)
    .off_time == (.vin.voltage - .vout.voltage) / (.vin.voltage * .ic.fsw)
    .soft_start_time == .ic.soft_start_time
    .output_ripple == .ripple / (8 * .ic.fsw * .output_cap.total_effective_capacitance) + .ripple * .output_esr / .output_cap.count
    .on_time >= .ic.min_on_time
    .off_time >= .ic.min_off_time
    .inductor.current + .ripple / 2 <= .inductor.saturation_current
    .inductor.inductance >= .ic.min_inductance
    .inductor.saturation_current >= .ic.min_inductor_saturation
    .inductor.dc_resistance <= .ic.max_inductor_dcr
    .input_cap.total_effective_capacitance >= .ic.min_input_capacitance
    .output_cap.total_effective_capacitance >= .ic.min_output_capacitance
}

/// The LT8641, Analog Devices' 3 V to 65 V, 3.5 A synchronous step-down Silent Switcher, in
/// its 18-lead (20 positions) 3 x 4 mm QFN (UDC20(18)). The automotive ordering code `#W`
/// (`LT8641IUDC#WPBF`, and `#WTRPBF` on tape and reel, LCSC C3975089) is the same die and the
/// same tables: the datasheet gives one set of numbers for every grade, so one part serves
/// the `E`, `I`, `J`, `H` and `#W` codes. A project adds the ordering code it buys as a row of
/// the `lt8641` catalog, and the solver takes the first row that fits: the catalog is not keyed
/// by `.mpn`, and a board that wants one ordering code narrows `.reg.ic.mpn` (ADR 0115, ADR
/// 0116). The standard `lt8641` catalog has no row, because no row of it has a recorded stock
/// above zero (`data/jlcpcb/README.md`).
///
/// Datasheet: Analog Devices LT8641, Rev. C (PDF dated 2020-12-10, 26 pages), the file that
/// LCSC links for C3975089. Page numbers are the printed pages, which are the PDF's; "table"
/// is the table of the heading named. Every number below was read from the PDF text, except
/// the efficiency, which is read off the curves of the Typical Performance Characteristics
/// (p.4) and says so.
///
/// - Input: 3 V to 65 V (front page p.1; Electrical Characteristics, p.2, "Minimum Input
///   Voltage" 3.0 V maximum). The absolute maximum VIN is 65 V (Absolute Maximum Ratings,
///   p.2), which the datasheet also allows for transients: "VIN may go as high as the
///   absolute maximum rating of 65V regardless of the RT value" (p.16). So `.vin.peak` is
///   bounded by 65 V and the steady `.vin.voltage` too. The datasheet has no separate
///   transient table for `#W`: the Order Information (p.2) says only that `#W` models have
///   controlled manufacturing for automotive use.
/// - Reference: `.vref` is 0.79 V to 0.822 V, the full temperature range at
///   VIN = 6 V, ILOAD = 0.5 A (Electrical Characteristics, p.3; 0.804 V to 0.816 V at 25 C).
///   The line regulation, 0.03 %/V at most over 4 V to 42 V (p.3), is not added to it.
/// - Output current: `.max_output_current` is 3.5 A, the "3.5A Maximum Continuous
///   Output" of the front page (p.1), which also gives `.peak_output_current`, 5 A "Peak
///   Transient Output". The top switch current limit is 6.2 A at least (`.top_current_limit_min`;
///   8.2 A typical, 9.9 A maximum; p.3). The datasheet's `IOUT(MAX) = ILIM - dIL / 2`
///   (Equation 8, p.17) needs the ripple of the inductor, which `Buck` has and the part
///   does not, so it is not checked.
/// - Switching frequency: a resistor from RT to ground sets it, RT = 46.5 / fSW - 5.2 (kohm,
///   MHz; Equation 3, p.15, and Table 1, p.15), so the nominal frequency is
///   `46.5MHz * 1kohm / (.rt_resistance + 5.2kohm)`. The datasheet states the accuracy at
///   three values of RT only (Oscillator Frequency, p.3): 665 kHz to 735 kHz at 60.4 kohm
///   and 1.85 MHz to 2.15 MHz at 18.2 kohm (and 180 kHz to 240 kHz at 221 kohm). Between
///   the first two the part states `.fsw_tolerance` as the widest of them against Equation 3
///   (0.938 to 1.037 at 60.4 kohm, 0.931 to 1.082 at 18.2 kohm: 0.93 to 1.09), and refuses a
///   resistor outside 18.2 kohm to 60.4 kohm (700 kHz to 2 MHz), where the datasheet gives no
///   figure for the accuracy. Two bounds and not a range: a range would be the interval that
///   `fsw` is computed from, and a window on `fsw` would be checked against all of it.
/// - Inductor: `.min_inductance` is Equation 10 (p.17), `VIN * (2 * DC - 1) / (2.5 * fSW)`
///   with `DC = VOUT / VIN`, which is the minimum for duty cycles over 50 % (a negative
///   figure below that asks for nothing). The saturation current needs no figure above the
///   load and half the ripple, which `Buck` checks: the datasheet says the part
///   "safely tolerates operation with a saturated inductor" in overload (p.16), so
///   `.min_inductor_saturation` is left unstated. `.max_inductor_dcr` is 0.04 ohm,
///   "to keep the efficiency high, the series resistance (DCR) should be less than 0.04 ohm"
///   (p.16).
/// - Capacitors: a third input capacitor of 2.2 uF or more beside the two 1 uF at VIN1 and
///   VIN2 (Pin Functions, VIN1 and VIN2, p.10; Input Capacitors, p.17):
///   `.min_input_capacitance` is 2.2 uF, `Buck`'s input capacitor. The two 1 uF
///   (0402 or 0603), 1 uF or more on INTVCC (p.10) and 0.1 uF from BST to SW (p.10) are in
///   the part's `support` section. The datasheet states no minimum output capacitance ("A lower value of output
///   capacitor can be used to save space and cost but transient performance will suffer and
///   may cause loop instability. See the Typical Applications", p.18). Every one of its
///   Typical Applications (p.1, p.22, p.23: 5 V, 3.3 V and 12 V, 1 MHz and 2 MHz) uses 47 uF
///   (1210, X5R or X7R) at the output, so `.min_output_capacitance` is 47 uF by default
///   (`?=`): an application value, not a datasheet minimum.
/// - Efficiency: `.efficiency` is 0.70 to 0.95. The upper figure is the front page's "Up
///   to 95% Efficiency at 1MHz, 12V to 5V" (p.1). The lower is read off the curves of the
///   Typical Performance Characteristics (p.4): the lowest point of G01 to G04 for a load of
///   0.5 A to 3.5 A (12 V to 48 V in, 5 V and 3.3 V out, 1 MHz to 3 MHz) is about 72 %, for
///   48 V to 3.3 V at 0.5 A, rounded down; and G05 and G06 (1 MHz, 4.7 uH) stay above 70 %
///   from about 0.2 mA up for every input from 12 V to 48 V, and fall to 25 % to 60 % at
///   10 uA. The datasheet states no minimum efficiency, so these are typical curves for
///   its own inductors, not a guarantee, and below 0.2 mA the figure is too high, where
///   the input current is a few microamps anyway. A board of one input voltage may state a
///   narrower range for its own conditions.
/// - Soft-start: the datasheet gives no time, only the parts of one. The TR/SS pin "allows user
///   control of output voltage ramp rate during start-up" and "an internal 1.9uA pull-up
///   current from INTVCC on this pin allows a capacitor to program output voltage slew rate"
///   (Pin Functions, p.10; Output Voltage Tracking and Soft-Start, p.19); the TR/SS Source
///   Current is 1.2 uA minimum, 1.9 uA typical and 2.6 uA maximum (Electrical
///   Characteristics, p.3, over the full temperature range); "from 0V to 0.8V, the TR/SS
///   voltage will override the internal 0.8V reference input to the error amplifier, thus
///   regulating the FB pin voltage to that of TR/SS pin. When TR/SS is above 0.8V, tracking
///   is disabled" and the feedback regulates to the internal reference (p.19; "a TR/SS
///   voltage below 0.8V forces the LT8641 to regulate the FB pin to equal the TR/SS pin
///   voltage", p.10); and "the TR/SS pin may be left floating if the function is not needed"
///   (p.19), with no ramp time for that case. Its Typical Applications (p.1, p.22 and p.23)
///   draw 10 nF on the pin and state no time for it. The datasheet writes no equation for
///   the time either. The part therefore has `.css`, the capacitor on TR/SS, which its `support`
///   section states from the 10 nF of 10 % it puts on the pin, and computes the time
///   the output takes to reach the 0.8 V at which tracking ends: a capacitor charged by a
///   constant current rises at `I / C`, so `t = C * 0.8V / I` (the owner's relation, item
///   CF2b of epic #308: the only figures in it are the datasheet's, and the equation is
///   the charge on a capacitor, not one the datasheet writes). The current is the member
///   `.tr_ss_current`, 1.2 uA to 2.6 uA (p.3), so the time is a range and the longest time
///   is at the smallest current: with 10 nF, 8 nC / 2.6 uA = 3.077 ms to 8 nC / 1.2 uA =
///   6.667 ms (4.211 ms at the typical 1.9 uA), and a board's bound
///   `.reg.soft_start_time <= 5ms` is held against the 6.667 ms (7.33 ms with the 10 % of
///   the capacitor, which is in the range `.css` states). Not in the time: the capacitor's
///   aging,
///   the leakage of the pin, the 0.79 V to 0.822 V of the reference (p.2, the figure that
///   the output settles at, not the one the datasheet gives for the end of the ramp), a
///   rise stretched by a current limit (large output capacitance or a load that draws while
///   the output rises), and the time from the enable going high to the start of the ramp
///   (the datasheet gives none).
/// - Switching frequency is held only inside two limits the datasheet gives, which keep the
///   stage's ripple (computed at the programmed frequency) right. The highest frequency
///   for an input is `(VOUT + VSW(BOT)) / (tON(MIN) * (VIN - VSW(TOP) + VSW(BOT)))`
///   (Equation 4, p.16, with the minimum on-time at its 50 ns maximum, Electrical
///   Characteristics, p.3), and the lowest input that holds the frequency is
///   `(VOUT + VSW(BOT)) / (1 - fSW * tOFF(MIN)) - VSW(BOT) + VSW(TOP)` (Equation 5, p.16, with
///   the minimum off-time at its 110 ns maximum, p.3). The switch drops are the datasheet's
///   "~0.15 V" (bottom) and "~0.3 V" (top) at maximum load (p.16). Beyond either limit the
///   part still regulates and lowers the frequency (p.16), so the part refuses the board
///   rather than letting the stage compute its ripple at a frequency the part does not hold.
/// - Quiescent current (Electrical Characteristics, p.2, "VIN Quiescent Current", ADR 0096):
///   `.iq_max` is 10 uA over temperature, not switching, VEN/UV = 2 V, VSYNC = 0 V (1.7 uA
///   typical, 4 uA at 25 C), which is Burst Mode, the mode "SYNC/MODE tied to ground" selects
///   (Pin Functions, p.11). With SYNC/MODE floating (pulse-skipping), held high or clocked, "the
///   quiescent current will be several hundred uA" (Operation, p.12), and the table gives 0.5 mA
///   at most with VSYNC = 2 V, at 25 C only (0.3 mA typical): `.iq_skipping_max`, which has no
///   figure over temperature. The input draws what the output asks and `.quiescent_current`,
///   a range from zero to the largest of the mode, as `LinearRegulator`'s is added to its load.
///   The default (`?=`) is the larger, `0A .. .iq_skipping_max`, since the part cannot see how
///   the board ties SYNC/MODE; a board that grounds it states the ultralow figure,
///   `.u.quiescent_current &= 0A .. .u.iq_max`. The 10 uA is a maximum and no minimum, so the
///   least the input draws is still zero: a board cannot ask for `.u.vin.current >= 10uA`.
///   Not taken: `.vin.current >= .iq_max` (a maximum read as a minimum: it would claim the part
///   always draws 10 uA); 10 uA as the default (true only with SYNC/MODE grounded, so a board
///   that floats the pin, which the datasheet allows, would be judged at a twentieth of the
///   figure for the mode it runs in); the 0.5 mA read as a limit over the junction
///   temperature range (it is a 25 C maximum, the only figure the datasheet gives for the
///   other modes); reading the member by name in the analysis (a part that calls it `.iq_max`
///   would be silently not modelled, so the `dc` statement names it); one figure for each
///   mode, picked by a member or by the voltage of the SYNC/MODE net (the language has no way
///   for a relation to choose); adding the stage's feedback divider here (it is a load on the
///   output, about 350 uA at 3.3 V in a test board, and `Buck` keeps it apart as
///   `.divider_current`). The DC analysis solves the output side, so its input current for an
///   unloaded stage is larger than this relation's, and a current that the balance and the
///   analysis cannot share is an error naming both ranges (ADR 0076, amendment 15): a std
///   stage with a 0 A output is refused for its inductor's current and for `u.vin.current`,
///   and a sleep budget cannot be shown to pass on one (not built; issue #63: whether the
///   stage's divider belongs in the IC's input current, as it does at the physical
///   converter). The default, the floor of zero and the 0.5 mA as the upper end for modes
///   with no figure over temperature are accepted as built (the owner, 2026-11-11).
/// - `BIAS` takes at most 25 V (Absolute Maximum Ratings, p.2); the datasheet ties it to the
///   output for outputs of 3.3 V to 25 V, and to ground when no supply is available (Pin
///   Functions, p.10). The part cannot reach the output, which `Buck` makes, so its `support`
///   section ties BIAS to ground and `.bias_voltage` is 0 V.
/// - The other pins that the Absolute Maximum Ratings (p.2) give a limit for state it at the
///   end of their pin row, `abs_max 65V` (ADR 0124). The solver compares it with the
///   worst-case voltage of the pin's net above the part's ground, `GND` (`.vin.neg`, the one
///   rail ground of the table), so a board that ties the pin to the input rail is refused:
///   `EN/UV` 65 V, `TR/SS` 4 V and `SYNC/MODE` 6 V. The datasheet does not say what the
///   ratings are measured from; they are taken from `GND`, as such a table's convention is. A
///   pin joined to nothing (`TR/SS` and `SYNC/MODE` may float) is not judged, and one with only
///   a capacitor on it (a soft-start capacitor) is a `not evaluated` note, as the voltage of a
///   net that nothing sets is not known. `INTVCC`, `BST`, `RT` and the SW pads have no limit
///   in the table and state none. Two pins have one and state none, on purpose (ADR 0095):
///   `PG` (42 V) is an open-drain output, and the solver cannot say how far an output swings
///   unless it is the line of a `Logic`, so a net with `PG` on it is never judged, and a limit
///   would be a note on every board that wires the pin; and `FB` (4 V) is the tap of the
///   stage's divider, which the solver reads as the hull of the two resistors (from ground to
///   the output) when the DC analysis does not solve the output side, so a limit would refuse
///   every output above 4 V, a 5 V stage included. The divider holds the pin at `.vref`,
///   under 0.83 V, by its own relation. Not taken: a voltage the board states, like
///   `.bias_voltage` (a board that forgets it is not judged, the false pass of issue #290);
///   changing the pins into `Logic` lines (`.u.sync_mode.line ~ ...`), which breaks every
///   board that wires the part; a note for a pin left to float (a note on each build of a
///   legal board); `FB` at 4 V anyway (it refuses the 5 V stage, the commonest). The solver
///   skips a pin that nothing outside its own part is joined to, for every part and not this
///   one only (`absolute_maximums` in `crates/netsmith-solve/src/levels.rs`): an optional
///   input left floating has no voltage to judge, and a required one is already an error.
///   `PG` and `FB` left unstated until the solver can judge them, the reading of the table as
///   voltages from `GND`, and the skip for every part are accepted as built (the owner,
///   2026-11-11).
///
/// Pins (Pin Functions, p.10 and p.11, and the Pin Configuration, p.2): 1 BIAS, 2 INTVCC,
/// 3 BST, 4 VIN1, 5 and 12 not present, 6 and 7 GND1, 8 and 9 SW, 10 and 11 GND2, 13 VIN2,
/// 14 EN/UV, 15 RT, 16 TR/SS, 17 SYNC/MODE, 18 GND, 19 PG, 20 FB, 21 and 22 the exposed pads,
/// which are SW. VIN1 and VIN2 are one input and the three grounds one ground, which the
/// part joins; the datasheet says the GND1 pins, and the GND2 pins, "must be tied together".
/// `BIAS`, `EN/UV`, `INTVCC`, `BST` and `RT` must be connected; the `support` section does it
/// (below). `SYNC/MODE` may float (pulse-skipping mode, p.11), as may `TR/SS` (p.10), and `PG`
/// is open drain.
///
/// The `support` section is the datasheet's application circuit around the IC (Pin Functions,
/// p.10; Typical Applications, p.1): 0.1 uF from BST to SW; 1 uF or more from INTVCC to
/// ground; 1 uF at VIN1 and at VIN2; 10 nF of 10 % on TR/SS by default (the capacitor of every
/// Typical Application, so `.css` is stated, see the soft-start item above); the resistor on RT,
/// 47 kohm of 1 % by default (`?=`; 0.89 MHz by Equation 3, a value the standard resistor
/// rows have); BIAS to ground; and EN/UV to the input,
/// so the IC runs whenever the input is above its own undervoltage lockout. Each capacitor on
/// the input is rated for the input's steady voltage. SYNC/MODE and PG are left open.
///
/// The package has no footprint in KiCad's libraries (the 4-pad `UDC-QFN-20` of KiCad is
/// the LT3033's, with another land pattern), so `std/kicad.toml` maps `Lt8641` in `UDC20(18)`
/// to netsmith's own footprint and symbol (`std/libs/`, ADR 0087). The footprint's pads are
/// the datasheet's recommended solder pad pitch and dimensions (p.24; pad 21 and 22 as the
/// pin configuration, p.2, and the bottom view, p.24, have them).
part Lt8641 provides BuckIc {
    // `.vin` is VIN1 (pad 4) and VIN2 (pad 13), which are one input, and the grounds GND1
    // (pads 6, 7), GND2 (pads 10, 11) and GND (pad 18).
    .vin.voltage >= 3V
    .vin.voltage <= 65V

    /// The absolute maximum VIN (Absolute Maximum Ratings, p.2): 65 V, the same as the
    /// operating limit; the datasheet allows it for transients too (p.16).
    .vin_abs_max: Voltage
    .vin_abs_max &= 65V
    .vin.peak <= .vin_abs_max

    /// The absolute maximum BIAS (p.2): 25 V.
    .bias_abs_max: Voltage
    .bias_abs_max &= 25V
    /// The voltage on BIAS: ground's, as the `support` section ties it.
    .bias_voltage: Voltage
    .bias_voltage <= .bias_abs_max

    .vref &= 0.79V..0.822V
    .min_input_voltage &= 3V
    .max_input_voltage &= 65V
    .max_output_current &= 3.5A
    .efficiency &= 0.70..0.95
    .max_inductor_dcr &= 0.04ohm
    .min_input_capacitance &= 2.2uF
    .min_output_capacitance ?= 47uF
    .soft_start_time == .css * 0.8V / .tr_ss_current
    .min_inductance == (2 * .sw.voltage - .vin.voltage) / (2.5 * .fsw * 1A)
    .vin.current == -.sw.current * .sw.voltage / (.vin.voltage * .efficiency) + .quiescent_current
    dc switching_regulator .vin .sw .efficiency .quiescent_current

    /// The capacitor on TR/SS, the `support` section's `.soft_start`: the output ramps as the
    /// pin does, so `.soft_start_time == .css * 0.8V / .tr_ss_current` (Output Voltage Tracking
    /// and Soft-Start, p.19; see the doc comment of the part for the figures).
    .css: Capacitance
    /// The current the TR/SS pin is pulled up with: 1.2 uA to 2.6 uA, 1.9 uA typical
    /// (Electrical Characteristics, p.3, TR/SS Source Current). A range, so the time of the
    /// ramp is one: the smallest current gives the longest time.
    .tr_ss_current: Current
    .tr_ss_current &= 1.2uA..2.6uA

    /// The largest peak output current, for a short time (front page, p.1).
    .peak_output_current: Current
    .peak_output_current &= 5A

    /// The least current limit of the top switch (Electrical Characteristics, p.3).
    .top_current_limit_min: Current
    .top_current_limit_min &= 6.2A

    /// The resistor from RT to ground and the frequency it sets. RT is bounded to the span
    /// that the datasheet gives the oscillator's accuracy for (18.2 kohm, 2 MHz, to 60.4 kohm,
    /// 700 kHz; p.3).
    .rt_resistance: Resistance
    .rt_resistance >= 18.2kohm
    .rt_resistance <= 60.4kohm
    /// RT = 46.5 / fSW - 5.2 (kohm, MHz; Equation 3, p.15).
    .fsw_nominal: Frequency
    .fsw_nominal == 46.5MHz * 1kohm / (.rt_resistance + 5.2kohm)
    /// The accuracy of the oscillator against Equation 3 over that span (Oscillator
    /// Frequency, p.3).
    .fsw_tolerance: Number
    .fsw_tolerance &= 0.93..1.09
    .fsw == .fsw_nominal * .fsw_tolerance

    /// The bottom and top switch drops at maximum load, "~0.15 V" and "~0.3 V" (p.16), and the
    /// largest minimum on-time and off-time, 50 ns and 110 ns (p.3), of Equations 4 and 5.
    .vsw_bottom: Voltage
    .vsw_bottom &= 0.15V
    .vsw_top: Voltage
    .vsw_top &= 0.3V
    .t_on_min: Time
    .t_on_min &= 50ns
    .t_off_min: Time
    .t_off_min &= 110ns
    // Equation 4 (p.16): the highest frequency that holds at the highest input; Equation 5
    // (p.16): the lowest input that holds the frequency.
    .fsw <= (.sw.voltage + .vsw_bottom) / (.t_on_min * (.vin.voltage - .vsw_top + .vsw_bottom))
    .vin.voltage >= (.sw.voltage + .vsw_bottom) / (1 - .fsw * .t_off_min) - .vsw_bottom + .vsw_top

    /// The quiescent current over temperature, in Burst Mode: EN/UV = 2 V, not switching,
    /// VSYNC = 0 V (Electrical Characteristics, p.2).
    .iq_max: Current
    .iq_max &= 10uA
    /// The largest quiescent current with VSYNC = 2 V, not switching: 0.5 mA, at 25 C only
    /// (p.2); SYNC/MODE floating, high or clocked is "several hundred uA" (p.12).
    .iq_skipping_max: Current
    .iq_skipping_max &= 0.5mA
    /// The current the IC draws from its input for itself with the output unloaded, as a range
    /// from zero to the largest of the mode the board runs it in: by default that of the
    /// pulse-skipping modes, and a board that grounds SYNC/MODE states
    /// `.u.quiescent_current &= 0A .. .u.iq_max`. The part cannot see how the pin is tied.
    .quiescent_current: Current
    .quiescent_current ?= 0A .. .iq_skipping_max

    // The pins the datasheet ties together are one pin each inside the part.
    .vin2 ~ .vin.pos
    .gnd1 ~ .vin.neg
    .gnd2 ~ .vin.neg

    pins {
        //  pin          kind     name         pads, and the absolute maximums of p.2 (see above)
        .bias          input    "BIAS"       "1"
        .intvcc        passive  "INTVCC"     "2"  required
        .bst           passive  "BST"        "3"  required
        .vin.pos       power    "VIN1"       "4"
        .gnd1          power    "GND1"       "6" "7"
        .sw.pos   power    "SW"         "8" "9" "21" "22"
        .gnd2          power    "GND2"       "10" "11"
        .vin2          power    "VIN2"       "13"
        .en_uv         input    "EN/UV"      "14" abs_max 65V
        .rt            passive  "RT"         "15" required
        .tr_ss         passive  "TR/SS"      "16" abs_max 4V
        .sync_mode     input    "SYNC/MODE"  "17" optional abs_max 6V
        .vin.neg       power    "GND"        "18"
        .pg            output   "PG"         "19"
        .fb       input    "FB"         "20"
    }

    .package: Package
    catalog lt8641 { .mpn, .package }

    // The datasheet's application circuit (see the doc comment above).
    support {
        .boost: Capacitor { .capacitance &= 100nF +/- 20% }
        .bst ~> .boost ~> .sw.pos
        .intvcc_cap: Capacitor { .capacitance &= 1uF +/- 20% }
        .intvcc ~> .intvcc_cap ~> .vin.neg
        .vin1_cap: Capacitor { .capacitance &= 1uF +/- 20% }
        .vin.pos ~> .vin1_cap ~> .gnd1
        .vin1_cap.max_voltage >= .vin.voltage
        .vin2_cap: Capacitor { .capacitance &= 1uF +/- 20% }
        .vin2 ~> .vin2_cap ~> .gnd2
        .vin2_cap.max_voltage >= .vin.voltage
        .soft_start: Capacitor { .capacitance ?= 10nF +/- 10% }
        .tr_ss ~> .soft_start ~> .vin.neg
        .css == .soft_start.capacitance
        .rt_resistor: Resistor
        .rt_resistor.resistance ?= 47kohm +/- 1%
        .rt ~> .rt_resistor ~> .vin.neg
        .rt_resistance == .rt_resistor.resistance
        .bias ~ .vin.neg
        .bias_voltage &= 0V
        .en_uv ~ .vin.pos
    }
}

/// The LMR16006Y, Texas Instruments' 4 V to 60 V, 0.6 A buck regulator (SIMPLE SWITCHER), the
/// 2.1 MHz version, in its 6-pin SOT (DDC). It is asynchronous: the low side is a Schottky
/// diode outside the IC, which its `support` section carries. The 0.7 MHz version, the
/// LMR16006X, is another part (another switching frequency and other recommended inductors),
/// and is not here. The catalog `lmr16006y` has the LCSC row of `LMR16006YDDCR` (C290195), which
/// JLCPCB lists as Extended (`data/jlcpcb/README.md`).
///
/// Datasheet: Texas Instruments, LMR16006 SIMPLE SWITCHER 60 V 0.6 A Buck Regulators With High
/// Efficiency ECO Mode, SNVSA24 (October 2014, 26 pages), the file that LCSC links for C290195.
/// Page numbers are the printed ones, which are the PDF's. Every number was read from the PDF
/// text with `pdftotext -layout`, except the efficiency, read off a curve, and the minimum
/// on-time, whose column was read off the page image; each says so.
///
/// - Input: 4 V to 60 V (Recommended Operating Conditions, p.4; Electrical Characteristics,
///   p.5). The absolute maximum of VIN and SHDN to GND is 65 V (Absolute Maximum Ratings, p.4),
///   stated in their pin rows (ADR 0124).
/// - Reference: `.vref` is 0.747 V to 0.782 V, over the junction temperature range of -40 C
///   to 125 C at VIN = 12 V (Electrical Characteristics, p.5, VFB).
/// - Switching frequency: 1785 kHz to 2415 kHz for the LMR16006Y (Switching Characteristics,
///   p.5, fSW).
/// - Output current: 0.6 A ("Output Current up to 600 mA", front page, p.1; Application
///   Information, p.11).
/// - Minimum on-time: 80 ns at 2.1 MHz is in the typical column only ("ensured by design",
///   p.5, read off the page image), so `.min_on_time` is not stated: the datasheet gives no
///   largest figure. The maximum duty cycle, 97 % typical (p.5), is not stated either.
/// - Inductor: `.min_inductance` is 6.8 uH, the smaller of the two the LMR16006Y's row of
///   Table 2 recommends (6.8 uH at 5 V, 10 uH at 12 V; p.14). The datasheet states no
///   saturation current the inductor must have beyond the load and its ripple (it suggests a
///   rating near 1.6 A so the IC limits its current before the inductor saturates, p.12, which
///   is advice for a short circuit and not stated), and no largest DC resistance.
/// - Capacitors: `.min_input_capacitance` is 1 uF, the low end of "Use a 1 uF-10 uF value with
///   X5R or X7R dielectric" (Input Capacitor Selection, p.13). The datasheet states no
///   minimum output capacitance: its design example uses 10 uF and Table 2 recommends 10 uF for
///   both outputs of the LMR16006Y (p.13 and p.14), so `.min_output_capacitance` is 10 uF by
///   default (`?=`): an application value, not a datasheet minimum, as the `Lt8641`'s is.
/// - Efficiency: `.efficiency` is 0.75 to 0.90, **read off the curves** of Figure 3 (p.6,
///   VIN = 12 V, fSW = 2.1 MHz, 3.3 V and 5 V out): from 10 mA to 600 mA the lowest point is
///   about 77 % (3.3 V out at 10 mA), rounded down, and the highest about 89 % (5 V out),
///   rounded up. Below 10 mA the curves fall to about 40 % at 0.1 mA. The datasheet has no
///   curve of the LMR16006Y at another input, and states no minimum.
/// - Quiescent current: 28 uA typical, not switching (p.5), with no maximum, so the part
///   states none and the input draws what the output asks.
/// - Soft-start: internal (p.1), with no time in the tables, so `.soft_start_time` is not
///   stated.
///
/// Pins (Pin Configuration and Functions, p.3): 1 CB, 2 GND, 3 FB, 4 SHDN, 5 VIN, 6 SW. CB must
/// have its bootstrap capacitor. SHDN has an internal pull-up and may float to enable (p.3).
/// `FB` (7 V, p.4) states no limit, for the `Lt8641`'s reason: the solver reads the tap of the
/// divider as the hull from ground to the output, so a limit would refuse outputs above it.
/// `SW` and `CB` state none: the solver sees the switch node at its average, the output.
///
/// The `support` section is the application circuit of Figure 9 (p.11) and the selection
/// rules of p.13 and p.14: the bootstrap capacitor, 100 nF from CB to SW, rated 10 V or more
/// ("a voltage rating of 10 V or higher is recommended", p.14); the catch diode D1, a
/// Schottky from ground (anode) to SW (cathode), rated for 1.25 times the input ("the
/// breakdown voltage rating of the diode is preferred to be 25 % higher than the maximum input
/// voltage", p.13) and for the output current ("the current rating for the diode should be
/// equal or greater to the maximum output current", p.13), carrying on average the output
/// current over the part of each period the switch is off, "approximately (1-D) x IOUT"
/// (p.13), which is its `.current` (the DC analysis cannot work it out between two sources,
/// and judges the trial with this one);
/// and the 100 kohm from VIN to SHDN of Figure 9. `Buck` makes the inductor, the capacitors and the divider (R1 and R2).
part Lmr16006y provides BuckIc {
    .vref &= 0.747V..0.782V
    .fsw &= 1785kHz..2415kHz
    .min_input_voltage &= 4V
    .max_input_voltage &= 60V
    .max_output_current &= 0.6A
    .efficiency &= 0.75..0.90
    .min_inductance &= 6.8uH
    .min_input_capacitance &= 1uF
    .min_output_capacitance ?= 10uF
    .vin.current == -.sw.current * .sw.voltage / (.vin.voltage * .efficiency)
    dc switching_regulator .vin .sw .efficiency

    pins {
        //  pin     kind     name    pads, and the absolute maximums of p.4
        .cb       passive  "CB"    "1" required
        .vin.neg  power    "GND"   "2"
        .fb       input    "FB"    "3"
        .shdn     input    "SHDN"  "4" optional abs_max 65V
        .vin.pos  power    "VIN"   "5" abs_max 65V
        .sw.pos   power    "SW"    "6"
    }

    .package: Package
    catalog lmr16006y { .mpn, .package }

    // Figure 9 (p.11) and the selection rules of p.13 and p.14 (see the doc comment above).
    support {
        .boost: Capacitor { .capacitance &= 100nF +/- 20% }
        .cb ~> .boost ~> .sw.pos
        .boost.max_voltage >= 10V
        .catch: Schottky
        .catch.anode ~ .vin.neg
        .catch.cathode ~ .sw.pos
        .catch.max_reverse_voltage >= .vin.voltage * 1.25
        .catch.max_forward_current >= -.sw.current
        .catch.current == -.sw.current * (1 - .sw.voltage / .vin.voltage)
        .shdn_pullup: Resistor { .resistance &= 100kohm +/- 1% }
        .vin.pos ~> .shdn_pullup ~> .shdn
    }
}

/// The RT8059, Richtek's 2.8 V to 5.5 V, 1 A synchronous buck converter at 1.5 MHz, in its
/// TSOT-23-5 (`J5`). The catalog `rt8059` has the LCSC row of `RT8059GJ5` (C20542), which JLCPCB
/// lists as Extended (`data/jlcpcb/README.md`).
///
/// Datasheet: Richtek, RT8059 1.5MHz, 1A, High Efficiency PWM Step-Down DC/DC Converter,
/// DS8059-06 (May 2016, 11 pages), from richtek.com (LCSC links an older copy, DS8059-04,
/// whose tables give the same numbers). Page numbers are the printed ones, which are the PDF's.
/// Every number was read from the PDF text, except the efficiency, read off a curve.
///
/// - Input: 2.8 V to 5.5 V (Recommended Operating Conditions, p.4). The absolute maximum of
///   VIN is 6.5 V (Absolute Maximum Ratings, p.4), stated in its pin row (ADR 0124).
/// - Reference: `.vref` is 0.588 V to 0.612 V (Electrical Characteristics, p.4). The table's
///   conditions are TA = 25 C, and it gives no figure over temperature (the front page says
///   "2% accuracy", p.1, and the curve of p.6 stays within 0.585 V to 0.62 V from -50 C to
///   125 C), so the range is the datasheet's only one and holds at 25 C.
/// - Switching frequency: 1.2 MHz to 1.8 MHz at IOUT = 100 mA (Electrical Characteristics,
///   p.4, fOSC), at 25 C as the table is.
/// - Output current: 1 A (front page, p.1).
/// - Inductor: `.min_inductance` is 1.5 uH, the smallest of Table 1 (p.2: 1.5 uH for 1 V and
///   1.2 V, 2.2 uH for 1.8 V to 3.3 V). The datasheet states no saturation current beyond
///   "do not allow the core to saturate" (p.8), which `Buck` checks with the load and half the
///   ripple, and no largest DC resistance.
/// - Capacitors: 4.7 uF at the input and 10 uF at the output, "the suggested values, referring
///   to the effective capacitances, subject to any de-rating effect, like a DC Bias" (Table 1
///   and its note, p.2): `.min_input_capacitance` and `.min_output_capacitance`.
/// - Efficiency: `.efficiency` is 0.75 to 0.97, **read off the curves** of Efficiency vs.
///   Load Current (p.6, 3.3 V and 5.5 V in, 1.2 V and 2.5 V out, 10 mA to 1 A): the lowest
///   point is about 76 % (3.3 V to 1.2 V at 1 A), rounded down, and the highest about 97 %
///   (3.3 V to 2.5 V near 0.1 A). The datasheet states no minimum and no curve below 10 mA.
/// - Quiescent current: 78 uA typical (p.4), with no maximum, so the part states none.
/// - The minimum on-time, the soft-start time and the current limit (1.5 A) are typical
///   figures or absent (p.4), so none is stated.
///
/// Pins (Pin Configurations, p.1, and Functional Pin Description, p.2): 1 EN, 2 GND, 3 LX, 4 VIN,
/// 5 FB. "Do not leave the EN pin floating" (p.2): the `support` section ties it to VIN, the
/// Typical Application Circuit's choice (p.2), so the converter runs whenever its input is up.
/// EN and FB are rated "VIN + 0.6V" (p.4), a limit that moves with the input, which a pin
/// row's `abs_max` would judge against the input's lowest value plus 0.6 V and refuse a wide
/// input for a pin that sits at the input; they state none. The feed-forward capacitor CFF of
/// Table 1 (0 pF to 8.2 pF at 1.8 V and above) is across the divider's top resistor, which
/// `Buck` makes and a part's `support` section cannot reach, and is not carried; the loop's
/// stability is not modelled.
part Rt8059 provides BuckIc {
    .vref &= 0.588V..0.612V
    .fsw &= 1.2MHz..1.8MHz
    .min_input_voltage &= 2.8V
    .max_input_voltage &= 5.5V
    .max_output_current &= 1A
    .efficiency &= 0.75..0.97
    .min_inductance &= 1.5uH
    .min_input_capacitance &= 4.7uF
    .min_output_capacitance &= 10uF
    .vin.current == -.sw.current * .sw.voltage / (.vin.voltage * .efficiency)
    dc switching_regulator .vin .sw .efficiency

    pins {
        //  pin     kind     name   pads, and the absolute maximum of p.4
        .en       input    "EN"   "1"
        .vin.neg  power    "GND"  "2"
        .sw.pos   power    "LX"   "3"
        .vin.pos  power    "VIN"  "4" abs_max 6.5V
        .fb       input    "FB"   "5"
    }

    .package: Package
    catalog rt8059 { .mpn, .package }

    // The Typical Application Circuit (p.2): EN to VIN.
    support {
        .en ~ .vin.pos
    }
}

/// The TPS54202, Texas Instruments' 4.5 V to 28 V, 2 A synchronous buck converter at 500 kHz,
/// in its 6-pin SOT-23 (DDC). The catalog `tps54202` has the LCSC row of `TPS54202DDCR`
/// (C191884), which JLCPCB lists as Extended (`data/jlcpcb/README.md`).
///
/// Datasheet: Texas Instruments, TPS54202 4.5-V to 28-V Input, 2-A Output, EMI Friendly
/// Synchronous Step Down Converter, SLVSD26A (April 2016, revised January 2017, 28 pages), the
/// file that LCSC links for C191884. Page numbers are the printed ones, which are the PDF's.
/// Every number was read from the PDF text, except the efficiency, read off a curve, and the
/// minimum on-time, whose column was read off the page image.
///
/// - Input: 4.5 V to 28 V (Recommended Operating Conditions, p.4; Electrical
///   Characteristics, p.5, over TJ = -40 C to 125 C). The absolute maximum of VIN is 30 V and
///   of EN 7 V (Absolute Maximum Ratings, p.4), stated in their pin rows (ADR 0124).
/// - Reference: `.vref` is 0.581 V to 0.611 V at VIN = 12 V, over the junction temperature
///   range (Electrical Characteristics, p.5, VFB).
/// - Switching frequency: 390 kHz to 590 kHz (p.5, Fsw, the centre frequency; the part
///   spreads it by 1/512 for EMI, p.12, which the range does not include).
/// - Output current: 2 A (front page, p.1).
/// - Minimum on-time: 110 ns, typical only and "not production tested" (Timing
///   Requirements, p.5, read off the page image), so `.min_on_time` is not stated.
/// - Inductor: `.min_inductance` is 5.6 uH, the smallest of Table 2 (p.17: 5.6 uH at 1.8 V,
///   up to 22 uH at 12 V, for VIN = 28 V). The datasheet asks for no saturation current beyond
///   the peak of Equation 10 (p.15), the load and half the ripple, which `Buck` checks, and for
///   no largest DC resistance.
/// - Capacitors: `.min_input_capacitance` is 10 uF ("A ceramic capacitor over 10 uF is
///   recommended for the decoupling capacitor", Input Capacitor Selection, p.14). The
///   datasheet states no minimum output capacitance: Table 2 gives 44 uF for 2.5 V to 12 V
///   and 66 uF for 1.8 V (p.17), so `.min_output_capacitance` is 44 uF by default (`?=`), an
///   application value as the `Lt8641`'s is; a 1.8 V board states 66 uF.
/// - Efficiency: `.efficiency` is 0.75 to 0.95, **read off the curves** of Figure 17 (p.18,
///   12 V and 24 V in, 5 V out): from 10 mA to 2 A the lowest point is about 78 % (24 V at
///   10 mA), rounded down, and the highest about 94 % (12 V near 1 A), rounded up. Below 10 mA
///   the curves fall to about 35 % at 1 mA. The datasheet states no minimum.
/// - Quiescent current: 45 uA typical, not switching (p.5), with no maximum, so none is
///   stated.
/// - Soft-start: 5 ms, typical only (Timing Requirements, p.5), so `.soft_start_time` is not
///   stated.
///
/// Pins (Pin Configuration and Functions, p.3): 1 GND, 2 SW, 3 VIN, 4 FB, 5 EN, 6 BOOT. "Float
/// the EN pin to enable" (p.3), so EN may float; the undervoltage divider of Figure 16 (R4 and
/// R5, p.13) is an option for a higher start voltage (p.14), not carried. `FB` (7 V) states no
/// limit, for the `Lt8641`'s reason.
///
/// The `support` section is what the application circuit needs beyond `Buck`: the 0.1 uF
/// bootstrap capacitor from BOOT to SW ("must be connected", p.14), rated for the 7 V that
/// BOOT-SW may reach at most (p.4). Not carried: the optional 0.1 uF beside the input capacitor
/// (C2, "optional", p.14), the 49.9 ohm resistor R1 ("a convenient location to break the
/// control loop for stability testing", p.14) and the feed-forward capacitor C6 across the
/// divider's top resistor (p.17), which `Buck` makes and a `support` section cannot reach; the
/// loop's stability is not modelled.
part Tps54202 provides BuckIc {
    .vref &= 0.581V..0.611V
    .fsw &= 390kHz..590kHz
    .min_input_voltage &= 4.5V
    .max_input_voltage &= 28V
    .max_output_current &= 2A
    .efficiency &= 0.75..0.95
    .min_inductance &= 5.6uH
    .min_input_capacitance &= 10uF
    .min_output_capacitance ?= 44uF
    .vin.current == -.sw.current * .sw.voltage / (.vin.voltage * .efficiency)
    dc switching_regulator .vin .sw .efficiency

    pins {
        //  pin     kind     name    pads, and the absolute maximums of p.4
        .vin.neg  power    "GND"   "1"
        .sw.pos   power    "SW"    "2"
        .vin.pos  power    "VIN"   "3" abs_max 30V
        .fb       input    "FB"    "4"
        .en       input    "EN"    "5" optional abs_max 7V
        .boot     passive  "BOOT"  "6" required
    }

    .package: Package
    catalog tps54202 { .mpn, .package }

    // The bootstrap capacitor of Figure 16 (p.13; see the doc comment above).
    support {
        .boost: Capacitor { .capacitance &= 100nF +/- 20% }
        .boot ~> .boost ~> .sw.pos
        .boost.max_voltage >= 7V
    }
}
